Object ( Bit OFL, Variant S) Sum( Variant D) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced"
{
 // Sums up the elements of a list.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant D: A list of elements to sum.  Implements an adder tree
 //
 // Outputs:
 //
 // Bit OFL: Overflow value.  Indicates an overflow error.
 //
 // Variant S: The result of the sumation.
 //
 // Dataset Coverage:
 //
 // A List of MSBxxx, LSBxxx and BINxxx (Unsigned), Signed, Fixed, Floating or Complex (OFL is the OR of the OFL of both portions).  All list elements must be the same dataset (with the exception of MSBxxx, LSBxxx, and BINxxx).  If different sizes then the inputs are symmetrized and a warning is produced.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant D) Input;  //_GUI 10,21
 Object Output( Bit OFL) ;  //_GUI 32,13
 Object Output:A( Variant S) ;  //_GUI 32,21
 Object ( Bit In) Input:A;  //_GUI 26,13
 //_ Attributes PromoteToParentObject="False",Constant="0"

 //_ Behavior Topology
 Output.0 = Input:A.0;  
 Output:A.0 = Input.0;  
}

Object ( Bit OFL, Variant S) Sum( List D) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced\\$Internal",Documentation="list"
{
 // Sums up the elements of a list.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant D:	A list of elements to sum.  Implements an adder tree
 //
 // Outputs:
 //
 // Bit CO:	Carry Out value.  Indicates high bit rolled over in any adder of the adder tree.  Used to indicate an error condition when using unsigned numbers.
 //
 // Bit OFL:	Overflow value.  Indicates half rollover point crossed.  Used to indicate an error condition when using twos complement numbers.
 //
 // Variant S:	The result of the sumation.
 //
 // Dataset Coverage:
 //
 // Unsigned (MSBxxx, LSBxxx and BINxxx use CO), Twos Complement (MSBxxx, LSBxxx and BINxxx use OFL), Signed (use OFL), Fixed (use OFL), Floating (use OFL), Complex (CO and OFL are the OR of CO and OFL of both portions).  All list elements must be the same dataset (with the exception of MSBxxx, LSBxxx, and BINxxx).  If different sizes then the inputs are symmetrized and a warning is produced.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List D) Input;  //_GUI 10,15
 Object Output( Bit OFL) ;  //_GUI 115,15
 Object Output:A( Variant S) ;  //_GUI 115,24
 Object Text;  //_GUI 43,35,We are building a binary tree of adders to sum the individual elements in the list.
 Object ( Variant Hi, Variant Lo) Bisect( Variant In1) ;  //_GUI 18,13
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 93,13
 Object ( Bit Out) OR:A( Bit In1, Bit In2) ;  //_GUI 69,12
 Object ( Bit OFL, Variant S) Sum( Variant D) ;  //_GUI 36,12
 //_ Attributes Documentation="list"
 Object ( Bit OFL, Variant S) Sum:A( Variant D) ;  //_GUI 36,20
 //_ Attributes Documentation="list"
 Object ( Bit OFL, Variant S) Add( Variant A
    , Variant B) ;  //_GUI 69,20

 //_ Behavior Topology
 Output.0 = OR.0;  
 Output:A.0 = Add.1;  
 Bisect.0 = Input.0;  
 OR.0 = OR:A.0;  
 OR.1 = Add.0;  //_GUI 93,22
 OR:A.0 = Sum.0;  
 OR:A.1 = Sum:A.0;  //_GUI 62,17, 62,22
 Sum.0 = Bisect.0;  
 Sum:A.0 = Bisect.1;  //_GUI 31,23, 31,18
 Add.0 = Sum.1;  //_GUI 65,22, 65,19, 59,19, 59,17
 Add.1 = Sum:A.1;  
}

Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) AddSub( Variant A
    , Variant B, Variant Add, Bit ClkG, Bit AClr
    , Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Advanced",Documentation="Var Add"
{
 // A synchronous add or subtract object.  This object has the same behavior as the AddSub object in the non-advanced branch except that lists are supported for the Add input.
 //
 // Inputs:
 //
 // Variant A: A value or a list of values with which B is added to or subtracted from.
 //
 // Variant B: A value or a list of values to be added to or subtracted from A.
 //
 // Variant Add: 1 to Add, 0 to Subtract.  Add is latched in with B's Go.  If B is a list and B's Go is a list, Add must be an equivalently shaped list or it must be a single bit constant.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go of GDBW.  Can be a Bit if A and B don't need to be synchronized.  Can be a pair of bits in a list if A needs to be synchronized with B.  Can be a pair of lists in a list if the elements of a list for A need to be individually synchronized against the elements of a list for B.
 //
 // Bit Wait: Wait of GDBW.  If disconnected, has value of 0.
 //
 // Outputs:
 //
 // Variant OFL: Indicates there was an overflow on the adder.  A list if A and/or B are lists, or a Bit otherwise
 //
 // Variant S: The result of the add or subtract.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done of GDBW
 //
 // Bit/List Busy: Busy of GDBW.  Same dataset as Go.  One busy for each respective Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned), Signed, Fixed, Floating, Complex (real and imaginary OFLs ORed) and lists of these.  If one of A or B is a list and the other is not, the other is duplicated into a list matching the one then the two lists are added.  A and B pairs must have the same dataset (with the exception of MSBxxx, LSBxxx and BINxxx) or undefined behavior will occur.  If A and B pairs don't have the same bit length, they are symmetrized and a warning is generated.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 9,25
 Object ( Variant B) Input:A;  //_GUI 9,28
 Object ( Variant Add) Input:B;  //_GUI 9,31
 Object ( Bit ClkG) Input:C;  //_GUI 9,40
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:D;  //_GUI 9,43
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:E;  //_GUI 9,46
 Object ( Bit Wait) Input:F;  //_GUI 140,52
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 141,31
 Object Output:A( Variant S) ;  //_GUI 141,34
 Object Output:B( Bit ClkG) ;  //_GUI 141,40
 Object Output:C( Bit AClr) ;  //_GUI 141,43
 Object Output:D( Bit Done) ;  //_GUI 141,46
 Object Output:E( Variant Busy) ;  //_GUI 10,52
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 44,24
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 77,27
