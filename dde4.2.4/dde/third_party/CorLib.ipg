Object ( Bit OFL, Variant Q, Bit ClkG
    , Bit AClr, Bit Done, Bit Busy) Convert( Variant Type
    , Variant Data, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Converters"
{
 // This is the synchronous version of the Convert object and has a GDBW interface.  This object is used to change the size and simple context from one dataset to another.  Many overloads of this object exist for converting from one dataset to another.  Any user-defined datasets that need to be converted should create their own overloads of this object.  These objects may or may not produce circuitry; dependent upon which Convert overload is instantiated.  This object doesn't always apply more complicated contexts, such as lists, dynamic datasets or un-overloaded user-defined datasets.  Follow Convert by Context in these cases.
 //
 // For conversions not involving the Floating dataset:  When a dataset is being expanded, OFL will be a constant zero and this object turns into wires and has no registers or pipeline latency.  When a dataset is being contracted, OFL will be computed using asynchronous logic unless the number of bits exceeds a frequency dependant threshold, in which case pipeline stages are added.  Some conversions perform a rounding operation with forces a pipeline stage.
 //
 // Inputs:
 //
 // Var/List Type: The resulting dataset
 //
 // Var/List Data: The input data and dataset
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Clears all of the counters.  If disconnected defaults to 0.
 //
 // Bit Go: Go
 //
 // Bit Wait: Wait. Has a value of 0 if disconnected
 //
 // Outputs:
 //
 // Bit OFL: Indicates an overflow occurred while converting the object's new type.
 //
 // Variant output: Data with dataset Type.
 //
 // Bit ClkG: clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done
 //
 // Bit Busy: Busy
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Type) Input;  //_GUI 32,16
 Object ( Variant Data) Input:A;  //_GUI 32,19
 Object ( Bit ClkG) Input:B;  //_GUI 32,22
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 32,25
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:D;  //_GUI 32,31
 Object ( Bit Wait) Input:E;  //_GUI 68,38
 //_ Attributes Constant="0"
 Object Output( Bit OFL) ;  //_GUI 69,16
 Object Output:A( Variant Q) ;  //_GUI 69,19
 Object Output:B( Bit ClkG) ;  //_GUI 69,25
 Object Output:C( Bit AClr) ;  //_GUI 69,28
 Object Output:D( Bit Done) ;  //_GUI 69,31
 Object Output:E( Bit Busy) ;  //_GUI 33,38
 Object ( Variant OFL, Variant Q, Variant PipeLen
    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) Convert_Pipe
    ( Variant Type, Variant Data, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 40,15
 //_ Attributes Documentation="Floating->Signed"
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 56,14

 //_ Behavior Topology
 Output.0 = VouchBit.0;  
 Output:A.0 = Convert_Pipe.1;  
 Output:B.0 = Convert_Pipe.3;  
 Output:C.0 = Convert_Pipe.4;  
 Output:D.0 = Convert_Pipe.5;  
 Output:E.0 = Convert_Pipe.6;  //_GUI 33,35
 Convert_Pipe.0 = Input.0;  
 Convert_Pipe.1 = Input:A.0;  
 Convert_Pipe.2 = Input:B.0;  
 Convert_Pipe.3 = Input:C.0;  
 Convert_Pipe.4 = Input:D.0;  
 Convert_Pipe.5 = Input:E.0;  //_GUI 72,35
 VouchBit.0 = Convert_Pipe.0;  
}

