 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 39,30

 //_ Behavior Topology
 Output.0 = ListOut.0;  
 Output:A.0 = ListOut:A.0;  
