 Object Text;  //_GUI 65,109,Send the Done out now if not Waiting, Going and ADoneIn
 Object ( Bit Out) INVERT:B( Bit In1) ;  //_GUI 64,124
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:J
    ( Bit In1) ;  //_GUI 45,91
