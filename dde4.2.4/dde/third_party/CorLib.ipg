Object ( Variant Mask) NumToMask( Variant Num) 
//_ Attributes TreeGroup="CoreLib\\Encoders/Decoders\\$Internal"
{
 // Takes a  input and translates it into a BIN-Shaped List of Bits.  The List will contain
 // 2^N bits, where N is the bitlength of the data input.  One and only one of the bits in the List will ever be asserted. If the data value is 0, the most_significant bit in the List will be asserted.  The asserted bit's position decodes the binary value of the data input.
 //
 // See the example sheet for an intuitive description of this object.
 //
 // Date Last Modifed:
 // 26 Jan 2003
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Num) Input;  //_GUI 37,34
 Object Output( Variant Mask) ;  //_GUI 153,35
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 86,33
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 81,36
 Object Text;  //_GUI 41,7,We recurse on the input data one bit at a time, starting with the most-significant.  If the most-significant bit is asserted, one of the bits, in the bottom $ object will be asserted, and none from the top $ object will be asserted.
 Object ( Variant MSB, Variant Out2) PopMsb( Variant In1) ;  //_GUI 46,32
 Object ( Variant Out1) PushMsb( Variant MSB, Variant In2) ;  //_GUI 134,33
 Object ( Variant Out1) INVERT( Variant In1) ;  //_GUI 93,47
 Object ( Variant Out1) $NumToMask( Variant Valid, Variant In2) ;  //_GUI 105,32
 //_ Attributes Documentation="Variant"
 Object ( Variant Out1) $NumToMask:A( Variant Valid, Variant In2) ;  //_GUI 108,48
 //_ Attributes Documentation="Variant"

 //_ Behavior Topology
 Output.0 = PushMsb.0;  
 Junction.0 = PopMsb.0;  
 Junction:A.0 = PopMsb.1;  
 PopMsb.0 = Input.0;  
 PushMsb.0 = $NumToMask.0;  
 PushMsb.1 = $NumToMask:A.0;  //_GUI 126,38, 126,51
 INVERT.0 = Junction.2;  //_GUI 87,50
 $NumToMask.0 = Junction.1;  
 $NumToMask.1 = Junction:A.1;  
 $NumToMask:A.0 = INVERT.0;  
 $NumToMask:A.1 = Junction:A.2;  //_GUI 82,53
}

Object ( Variant Out1) $NumToMask( Variant Valid, Variant In2) 
//_ Attributes TreeGroup="CoreLib\\Encoders/Decoders\\$Internal"
{
 // Updated Dec 2004
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Valid) Input;  //_GUI 45,26
 Object ( Variant In2) Input:A;  //_GUI 23,36
 Object Output( Variant Out1) ;  //_GUI 159,37
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 75,38
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In1) ;  //_GUI 60,32
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:B
    ( Variant In0) ;  //_GUI 46,35
 Object Text;  //_GUI 28,69,Here we repeat the MSB-recursion started in the Decode object.  Here however, we combine the validity state defined by the most-significant bit with the validity states that have come from more significant bits.
 Object ( Variant Out1) AND( Variant In1, Variant In2) ;  //_GUI 66,31
 Object ( Variant Out1) INVERT( Variant In1) ;  //_GUI 48,51
 Object ( Variant Out1) AND:A( Variant In1, Variant In2) ;  //_GUI 97,49
 Object ( Variant Out1) PushMsb( Variant MSB, Variant In2) ;  //_GUI 131,35
 Object ( Variant MSB, Variant Out2) PopMsb( Variant In1) ;  //_GUI 32,34
 Object ( Variant Out1) $NumToMask( Variant Valid, Variant In2) ;  //_GUI 107,56
 //_ Attributes Documentation="Variant"
 Object ( Variant Out1) $NumToMask:A( Variant Valid, Variant In2) ;  //_GUI 98,34
 //_ Attributes Documentation="Variant"

 //_ Behavior Topology
 Output.0 = PushMsb.0;  
 Junction.0 = PopMsb.1;  
 Junction:A.0 = Input.0;  //_GUI 61,27
 Junction:B.0 = PopMsb.0;  
 AND.0 = Junction:A.1;  
 AND.1 = Junction:B.1;  
 INVERT.0 = Junction:B.2;  //_GUI 47,54
 AND:A.0 = Junction:A.2;  //_GUI 61,51
 AND:A.1 = INVERT.0;  
 PushMsb.0 = $NumToMask:A.0;  
 PushMsb.1 = $NumToMask.0;  //_GUI 122,40
 PopMsb.0 = Input:A.0;  
 $NumToMask.0 = AND:A.0;  
 $NumToMask.1 = Junction.2;  //_GUI 76,61
 $NumToMask:A.0 = AND.0;  //_GUI 79,36, 79,34
 $NumToMask:A.1 = Junction.1;  
}

