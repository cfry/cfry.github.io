Object ( Variant Data) List_Mux( Variant Data, Bit Mask) 
//_ Attributes TreeGroup="CoreLib\\Multiplexers\\Async",Documentation="Leaf"
{
 // A list based multiplexer.  Selects one element from a list using a mask selecting mechanism.
 //
 // Inputs:
 //
 // Var/List Data: A list of homogeneous data elements to be multiplexed.
 //
 // Var/List Mask: A set of bits to select which corresponding list element in Data to output.  Usually a single bit is on which causes the corresponding Data list element to show up on the Data output.  If more than one bit is turned on, the Data output is the OR of all selected input list elements. Data and Mask must have the same number of elements/bits and must be in the same shape.  For instance, if Data was a 4 element Bin ordered list, Mask could be either a BIN004 dataset or a four element Bin ordered list of Bit datasets.
 //
 // Outputs:
 //
 // Variant Data: The multiplexed output.
 //
 // Date:
 // March 5, 2003
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 66,42
 Object ( Bit Mask) Input:A;  //_GUI 74,76
 Object Output( Variant Data) ;  //_GUI 131,68
 Object ( Variant Out1) AND( Variant In1, Variant In2) ;  //_GUI 104,66

 //_ Behavior Topology
 Output.0 = AND.0;  
 AND.0 = Input.0;  //_GUI 83,68, 83,43
 AND.1 = Input:A.0;  //_GUI 96,71, 96,77
}

