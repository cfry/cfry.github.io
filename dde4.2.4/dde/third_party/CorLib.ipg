 // Variant Data: An MSB ordered List or a variant.  A variant could be thought of as a list of one element.
 //
 // Variant Hi_e: The bit length of this parameter specifies e - the list element to be output.  Can be NULL to output zero elements (a NULL).  Will produce a compile warning and output a NULL if e exceeds the number of elements in the list.
 //
 // Outputs:
 //
 // Variant El:  A variant representing the e-th element from the beginning (head) of MSB ordered input Data list.
 //
 // Special cases:
 //
 // 1. e=0 - No element is specified.  El is a NULL data set.  This case is currently not working.
 // 2. e=1 - El is a variant that is the most significant element in the MSB ordered list.
 // 3. e=Data elements - El is the LSB element of the list.
 // 5. e>Data elements - produces a compile time error.
 //
 // Examples:
 //
 // Data = list (6, list (7, list (8, 9))) (A 4 element MSB ordered list)
 // Hi_e = Bit		El = 6
 // Hi_e = MSB002	El = 7
 // Hi_e = LSB004	El = 9
 // Hi_e = BIN005	El = (dataset of NULL)
 //
 // Date:
 // 30 Jun 2003
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 8,15
 Object ( Variant Hi_e) Input:A;  //_GUI 8,28
 Object Output( NULL El) ;  //_GUI 42,15
 Object ( Bit In) Input:B;  //_GUI 19,44
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object Output:A( Bit Trap) ;  //_GUI 35,44
 //_ Attributes Trap="Hi_e greater than list size of Data",returning a NULL for the element.
 Object ( NULL Out1) NULL;  //_GUI 27,13

 //_ Behavior Topology
 Output.0 = NULL.0;  
 Output:A.0 = Input:B.0;  
}

