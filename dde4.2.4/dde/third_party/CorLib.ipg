    ( Variant A, Variant B, Bit ADD, Bit CI) ;  //_GUI 116,22
 Object ( Variant Out1) CollectBIN( Variant In1, Variant In2) ;  //_GUI 130,28
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 100,15
 Object Text;  //_GUI 24,45,func mult(a,b){    RUpper = mult( upper( a ), b );    RLower = mult( lower( a ), b );    return ( RUpper << bitlen( lower( a ))) + UnsignedExtend( RLower );}Courier New,8,0,0
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In1) ;  //_GUI 43,20
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:B
    ( Variant In3) ;  //_GUI 47,28
 Object Text;  //_GUI 49,2,The lower bits of RLower will be added to zeros, so don't add these at all, just tack them on at the end.  The upper bits of RLower will be zero extended then added to RUpper.
 Object Text;  //_GUI 92,31,Symitrize for the add.
 Object ( Variant OFL, Variant Out2) UExtnd( Variant Type
    , Variant Data) ;  //_GUI 101,22
 //_ Attributes Documentation="ztlist"
 Object ( Variant Hi, Variant Lo) Lo_N( Variant Data
    , Variant Lo_N) ;  //_GUI 76,25
 Object Text;  //_GUI 63,12,RUpper
 Object Text;  //_GUI 63,28,RLower
 Object ( Variant R) $Mul( Variant A, Variant B) ;  //_GUI 52,13
 Object ( Variant R) $Mul:A( Variant A, Variant B) ;  //_GUI 52,24
 Object ( Variant Ah, Variant Al) $SplitAForMul( Variant A) ;  //_GUI 24,13

 //_ Behavior Topology
 Output.0 = CollectBIN.0;  
 $ADSU.0 = Junction.1;  //_GUI 116,16
 $ADSU.1 = UExtnd.1;  
 CollectBIN.0 = $ADSU.2;  
 CollectBIN.1 = Lo_N.1;  //_GUI 130,38, 88,38, 88,30
 Junction.0 = $Mul.0;  
 Junction:A.0 = $SplitAForMul.1;  //_GUI 44,18
 Junction:B.0 = Input:A.0;  //_GUI 48,39
 UExtnd.0 = Junction.2;  
 UExtnd.1 = Lo_N.0;  
 Lo_N.0 = $Mul:A.0;  
 Lo_N.1 = Junction:A.1;  //_GUI 73,30, 73,21
 $Mul.0 = $SplitAForMul.0;  
 $Mul.1 = Junction:B.1;  //_GUI 48,18
 $Mul:A.0 = Junction:A.2;  //_GUI 44,26
 $Mul:A.1 = Junction:B.2;  
 $SplitAForMul.0 = Input.0;  
}

