Object ( Variant Lout, Variant Rout, Variant Pout) $ShiftReg
    ( Variant Lin, Variant Rin, Variant Pin, Bit "L/R"
    , Bit Load, Bit ClkG, Bit EN, Bit CLR) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\$Internal",Documentation="Var"
{
 // This is a loadable Shift Register with parallel and serial input/output interfaces.  A shift is performed on every EN (when not load).  The serial input may be of type Bit, or of any other data set if the parallel interface is a List of that data set.
 //
 // Inputs:
 // LIn - Serial input of most significant bit/data set
 // RIn - Serial input of least significant bit/data set
 // Pin/Type - Paralllel input interface as well as type specification
 // L/R - shift left vs. right. 0 = left, 1 = right
 // Load - loads the parallel data.  Load has precidence over En. Default=0
 // CLR - asynchronous clear
 //
 // Outputs:
 // LOut - Serial output  of most significant bit/data set
 // ROut - Serial output of least significant bit/data set
 // POut - Parallel output interface
 //
 // Date Last Modiified:
 // Oct 2004
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Lin) Input;  //_GUI 37,21
 Object ( Variant Rin) Input:A;  //_GUI 37,24
 Object ( Variant Pin) Input:B;  //_GUI 20,43
 Object ( Bit "L/R") Input:C;  //_GUI 38,47
 //_ Attributes Constant="0"
 Object ( Bit Load) Input:D;  //_GUI 38,52
 //_ Attributes Constant="0"
 Object ( Bit ClkG) Input:E;  //_GUI 38,58
 //_ Attributes Resource="Global"
 Object ( Bit EN) Input:F;  //_GUI 38,62
 //_ Attributes Constant="1"
 Object ( Bit CLR) Input:G;  //_GUI 38,66
 //_ Attributes Constant="0"
 Object Output( Variant Lout) ;  //_GUI 175,18
 Object Output:A( Variant Rout) ;  //_GUI 175,28
 Object Output:B( Variant Pout) ;  //_GUI 210,41
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 138,28
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 67,51
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 44,43
 Object ( Variant Out) $Cast( Variant In, Variant Type) ;  //_GUI 73,27
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:B
    ( Variant In3) ;  //_GUI 44,36
 Object ( Variant Out) $Cast:A( Variant In, Variant Type) ;  //_GUI 73,35
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 61,52
 Object ( Variant Q) RegClr( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 127,26
 Object ( Variant O) $Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 89,33
 //_ Attributes Documentation="Variant"
 Object ( Variant O) $Mux:A( Variant A, Variant B
    , Bit S) ;  //_GUI 104,39
