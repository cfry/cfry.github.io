Object ( Variant R) Mul( Variant A, Variant B) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async",Icon="MUL"
{
 // Asynchronously multiplies A and B.
 //
 // Inputs:
 //
 // Variant A: Number
 //
 // Variant B: Number
 //
 // Outputs:
 //
 // Variant R: result of A*B.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned, output dataset is BINxxx whose size is the size of A plus the size of B.  For 2's complement multiplies use the Mul_Twos object or use the Signed dataset on this object), Signed (the output dataset is Signed whose size is the size of A plus the size of B), Floating (the resulting exponent size is the larger of the two exponent sizes, if different a warning is generated.  The significand is rounded.  Infinity and NaN are supported), Fixed (The result's whole size is the sum of the two inputs' whole sizes.  The result's fractional size is the sum of the two inputs' fractional sizes), and one or two Lists.  Complex is not supported by this asynchronous version of the multiply.  A and B can not have mixed datasets except with respect to size or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 // Since in non-floating point cases the result is twice as large as the inputs, if you want to get the result back down to the original size, follow the Mul by a Convert object which will also check for overflow.
 // The larger the datasets, the slower the maximum frequency of the circuit will be.  Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 17,14
 Object ( Variant B) Input:A;  //_GUI 17,17
 Object Output( Variant R) ;  //_GUI 68,15
 Object ( Variant Out1) BIN( Variant In1) ;  //_GUI 24,15
 Object Text;  //_GUI 18,30,We always want the smaller dataset going in on A.This object always outputs a BIN. We can't really control that because we don't have a way to test for MSB/LSB/BIN: we don't know what pattern the incoming dataset was, and because the output is a different size we can't set it.
 Object ( Variant Out1) BIN:A( Variant In1) ;  //_GUI 24,12
 Object ( Variant Min, Variant Max) OrderDatasets( Variant In1
    , Variant In2) ;  //_GUI 37,13
 Object ( Variant R) $Mul( Variant A, Variant B) ;  //_GUI 55,13

 //_ Behavior Topology
 Output.0 = $Mul.0;  
 BIN.0 = Input:A.0;  
 BIN:A.0 = Input.0;  
 OrderDatasets.0 = BIN:A.0;  
 OrderDatasets.1 = BIN.0;  
 $Mul.0 = OrderDatasets.0;  
 $Mul.1 = OrderDatasets.1;  
}

