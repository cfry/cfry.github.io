    ( Bit In0) ;  //_GUI 91,83
 Object ( Variant State) State( Variant Enter, Variant Leave
    , Bit ClkG, Bit CLR) ;  //_GUI 65,81
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:D
    ( Bit In0) ;  //_GUI 148,84
