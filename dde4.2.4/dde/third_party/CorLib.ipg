Object ( Variant DataA, Variant DataB, Bit ClkG
    , Bit AClr, Bit BusyA, Bit BusyB, Bit Done) SyncQueuePair
    ( Variant DataA, Variant DataB, Bit ClkG, Bit AClr
    , Bit GoA, Bit GoB, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Synchronizers\\Advanced"
{
 // A data synchronizer for joining two data flow paths.  The object creates queues for each synchronized data path input. Same as SyncQueue for two data flow paths with the list inputs and outputs split and wrapped to simplify drawing and readability.
 //
 // Inputs:
 //
 // Variant DataA: Data path A to synchronize.
 //
 // Variant DataB: Data path B to synchronize.
 //
 // Bit ClkG: The global user clock if disconnected or a specific clock if connected.
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected.
 //
 // Bit GoA: Go of GDBW for DataA.  DataA is queued on GoA if BusyA is low.
 //
 // Bit GoB: Go of GDBW for DataB.  DataB is queued on GoB if BusyB is low.
 //
 // Bit Wait: Wait of GDBW.  Defaults to 0 if disconnected.  Tells Done to hold off.
 //
 // Outputs:
 //
 // Variant DataA: Synchronized queued DataA.
 //
 // Variant DataB: Synchronized queued DataB.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit BusyA: Busy of GDBW for GoA.  Tells GoA to hold off.
 //
 // Bit BusyB: Busy of GDBW for GoB.  Tells GoB to hold off.
 //
 // Bit Done: Done of GDBW.  DataA and DataB valid while high.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant DataA) Input;  //_GUI 35,40
 Object ( Variant DataB) Input:A;  //_GUI 35,43
 Object ( Bit ClkG) Input:B;  //_GUI 35,47
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 35,50
 //_ Attributes Constant="0"
 Object ( Bit GoA) Input:D;  //_GUI 35,54
 Object ( Bit GoB) Input:E;  //_GUI 35,57
 Object ( Bit Wait) Input:F;  //_GUI 85,59
 //_ Attributes Constant="0"
 Object Output( Variant DataA) ;  //_GUI 84,40
 Object Output:A( Variant DataB) ;  //_GUI 84,43
 Object Output:B( Bit ClkG) ;  //_GUI 84,47
 Object Output:C( Bit AClr) ;  //_GUI 71,50
 Object Output:D( Bit BusyA) ;  //_GUI 93,68
 Object Output:E( Bit BusyB) ;  //_GUI 93,76
 Object Output:F( Bit Done) ;  //_GUI 93,84
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 41,53
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 71,39
 Object ( Variant Out1, Variant Out2) ListIn:A( List In) ;  //_GUI 57,67
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Variant Done, Variant Busy) SyncQueue( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 57,43
 //_ Attributes Documentation="Var/Bit"
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 81,66
 Object ( Bit Out1) VouchBit:A( Variant In1) ;  //_GUI 81,74
 Object ( Bit Out1) VouchBit:B( Variant In1) ;  //_GUI 81,82
 Object ( List Out) ListOut:A( Variant In1, Variant In2) ;  //_GUI 41,39

 //_ Behavior Topology
 Output.0 = ListIn.1;  
 Output:A.0 = ListIn.0;  
 Output:B.0 = SyncQueue.1;  
 Output:C.0 = SyncQueue.2;  
 Output:D.0 = VouchBit.0;  
 Output:E.0 = VouchBit:A.0;  
 Output:F.0 = VouchBit:B.0;  
 ListOut.0 = Input:E.0;  
 ListOut.1 = Input:D.0;  
 ListIn.0 = SyncQueue.0;  //_GUI 69,42
 ListIn:A.0 = SyncQueue.4;  
 SyncQueue.0 = ListOut:A.0;  //_GUI 54,45, 54,42
 SyncQueue.1 = Input:B.0;  
 SyncQueue.2 = Input:C.0;  
