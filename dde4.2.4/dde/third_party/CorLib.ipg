//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\$Internal\\Incomplete\\CORDIC_MinHW"
{
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 21,37
 Object Output( Bit Out1) ;  //_GUI 197,41
 Object Text;  //_GUI 30,6,This object determins if the bitlength of the incoming dataset is a 3k+1 iteration, i.e., 4, 13, 40, 121, 364, 1093,  etc.this object relies heavily on constant propagation for optimization
 Object ( BIN011 In) Input:A;  //_GUI 27,62
