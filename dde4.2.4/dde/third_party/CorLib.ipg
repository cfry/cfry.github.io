 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 58,29

 //_ Behavior Topology
 Output.0 = VouchBit.0;  
 VariantIn.0 = BIN.0;  
 $XOR-NInput.0 = VariantIn.1;  
 $XOR-NInput.1 = VariantIn.0;  
 BIN.0 = Input.0;  
 VouchBit.0 = $XOR-NInput.0;  
}

