Object ( List Val) NegateEn( List Val, List En) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced",Documentation="List/List"
{
 // Conditionally negates a number.  For twos complement, Signed and Fixed datasets, if the input value is the maximum negative value, Negate returns the maximum positive value instead of producing a overflow signal.  If this is insufficient, use TwosComp instead.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant input: Value
 //
 // Bit/List En: If 0, the input value is passed through unchanged.  If 1, the input value is negated.
 //
 // Outputs:
 //
 // Variant output: The negative of the input value if En is 1, unchanged otherwise.
 //
 // Dataset Coverage:
 //
 // Unsigned/Twos-Complement (MSBxxx, LSBxxx and BINxxx assumes twos complement and produces warning.  Use TwosComp if you don't want a warning.), Signed, Fixed, Floating, Complex, List with Bit En and List with List En.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List Val) Input;  //_GUI 25,28
 Object ( List En) Input:A;  //_GUI 25,37
 Object Output( List Val) ;  //_GUI 79,29
 Object ( Variant O) NegateEn( Variant In1, Variant En) ;  //_GUI 50,26
 //_ Attributes Documentation="var/bit"
