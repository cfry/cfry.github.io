}

Object ( Bit OFL, Variant TwosComp) ToTwos( Bit Sign
    , Variant Unsigned) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Async\\Advanced"
{
 // Converts a sign and magnitude into a twos complement value.  The TwosComplement output is the same dataset as the Unsigned input.  A List input will produce List outputs.  This object is asynchronous and may have difficulty meeting timing specifications with large datasets and/or faster frequencies.
 //
 // Inputs:
 //
 // Var/List Unsigned: An MSBxxx, Lsbxxx, or BINxxx dataset to be converted to a twos complement number along with the specified Sign input.  This input can also be considered the magnitude of the value.
 //
 // Bit/List Sign High if the input is to be converted to a negative twos complement output value.  Low if the input is to be converted to a positive twos complement output value.  This value is the same as the high bit of the twos complement input.
 //
 // Outputs:
 //
 // Bit/List OFL Goes high if the input had its high bit set.  This value is the same as the high bit of the Unsigned (magnitude) input.  If the high bit of the Unsigned input is always zero, this OFL output is unnecessary.
 //
 // Var/List TwosComp: The combination of the Unsigned input (the magnitude) with the Sign input resulting in a twos complement representation of the value.
 //
 // Examples:
 //
 // Sign	Unsigned	TwosComp	OFL
 // 0	000 (0)	000 (0)		0
 // 0	001 (1)	001 (1)		0
 // 0	010 (2)	010 (2)		0
 // 0	011 (3)	011 (3)		0
 // 0	1XX	???		1
 // 1	000 (0)	000 (0)		0
 // 1	001 (1)	111 (-1)		0
 // 1	010 (2)	110 (-2)		0
 // 1	011 (3)	101 (-3)		0
 // 1	1XX	???		1
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit Sign) Input;  //_GUI 16,23
 Object ( Variant Unsigned) Input:A;  //_GUI 16,30
 Object Output( Bit OFL) ;  //_GUI 118,14
 Object Output:A( Variant TwosComp) ;  //_GUI 118,18
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 55,17
 Object Text;  //_GUI 41,40,Convert to twos compliment, maintaining the same number of bits.
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 26,28
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 103,16
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 22,30
 Object ( Bit CO, Bit OFL, Variant S) ADSU
    ( Variant A, Variant B, Bit ADD, Bit CI) ;  //_GUI 74,13
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 58,23
 Object ( Variant Out1) Zero( Variant In1) ;  //_GUI 60,12
 Object ( Variant MSB, Variant Out2) PopMsb( Variant In1) ;  //_GUI 42,28
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:C
    ( Variant In0) ;  //_GUI 38,30
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 58,27
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 62,18

 //_ Behavior Topology
 Output.0 = VouchBit.0;  //_GUI 98,15, 98,30
 Output:A.0 = Context.0;  
 Junction.0 = Junction:C.0;  //_GUI 39,18
 MSB.0 = Junction:A.1;  
 Context.0 = Junction:A.0;  //_GUI 103,10, 23,10
 Context.1 = ADSU.2;  
 Junction:A.0 = Input:A.0;  
 ADSU.0 = Zero.0;  
 ADSU.1 = Junction.1;  
 ADSU.2 = INVERT.0;  
 ADSU.3 = Junction:B.1;  
 Junction:B.0 = Input.0;  
 Zero.0 = Junction.0;  //_GUI 56,15
 PopMsb.0 = Junction:C.1;  
 Junction:C.0 = MSB.0;  
 VouchBit.0 = PopMsb.0;  
 INVERT.0 = Junction:B.0;  //_GUI 59,21
}

