Object ( Variant OutA, Variant OutB) RAMDP( Variant InA
    , Variant AddrA, Variant AddrB, Bit ClkG, Bit ClkG
    , Bit WE) 
//_ Attributes TreeGroup="CoreLib\\Memory\\$Internal",Icon="RAMDP2",Documentation="two clocks"
{
 // RAMDP is a dual-port RAM object. It is capable of reading from memory and writing to memory during the same clock cycle.
 //
 // Inputs:
 // InA - The data to be written into memory.
 // AddrA - The memory address to read or write.
 // AddrB - The memory address to read from.
 // ClkG(top) - Port A clock  Defaulted to the system clock.
 // ClkG(bottom) - Port B clock.  Defaulted to the system clock.
 // WE - Write Enable tells the memory to write the data InA to the address specified by AddA. When WE is deasserted, the object will read from the address specified and output data to OutA.
 //
 // Outputs:
 // OutA: Outputs the data at address AddrA.
 // OutB: Outputs the data at address AddrB.
 //
 // Modified:
 // 12/07/04
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant InA) Input;  //_GUI 19,11
 Object ( Variant AddrA) Input:A;  //_GUI 19,14
 Object ( Variant AddrB) Input:B;  //_GUI 19,17
 Object ( Bit ClkG) Input:C;  //_GUI 19,20
 //_ Attributes Resource="Global"
 Object ( Bit ClkG) Input:D;  //_GUI 19,23
 //_ Attributes Resource="Global"
 Object ( Bit WE) Input:E;  //_GUI 19,26
 Object Output( Variant OutA) ;  //_GUI 42,11
 Object Output:A( Variant OutB) ;  //_GUI 42,14
 Object ( Bit In) Input:F;  //_GUI 22,29
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object ( Variant OutA, Variant OutB) RAMDP( Variant InA
    , Variant AddrA, Variant AddrB, Bit ClkG, Bit ClkG
    , Bit WE, Bit REB) ;  //_GUI 28,10
 //_ Attributes Documentation="two clocks"

 //_ Behavior Topology
 Output.0 = RAMDP.0;  
 Output:A.0 = RAMDP.1;  
 RAMDP.0 = Input.0;  
 RAMDP.1 = Input:A.0;  
 RAMDP.2 = Input:B.0;  
 RAMDP.3 = Input:C.0;  
 RAMDP.4 = Input:D.0;  
 RAMDP.5 = Input:E.0;  
 RAMDP.6 = Input:F.0;  
}

Object ( Variant Data) RAMSP( Variant Data, Variant Addr
    , Bit ClkG, Bit WE) 
//_ Attributes TreeGroup="CoreLib\\Memory\\Advanced"
{
 // RAMSP is a single port RAM object with synchronous reads and writes.
 //
 // Inputs:
 // Data - The data to be written into memory.
 // Addr - The memory address to read and/or write.
 // ClkG - Defaulted to the system clock.
 // WE - Write Enable tells the memory to write the data to the address on the next rising clock edge.
 //
 // Outputs:
 // Data: After the rising clock edge the data that was at address Addr just prior to the rising clock edge is output to Data. (If a write was performed, the output data is that of the data before the write took place.)
 //
 // Modified:
 // 12/07/04
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 14,19
 Object ( Variant Addr) Input:A;  //_GUI 14,27
 Object ( Bit ClkG) Input:B;  //_GUI 14,32
 //_ Attributes Resource="Global"
 Object ( Bit WE) Input:C;  //_GUI 14,35
 Object Output( Variant Data) ;  //_GUI 83,18
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 26,25
 Object ( Variant Out1) MSB:A( Variant In1) ;  //_GUI 26,17
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 21,19
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 70,16
 //_ Attributes Documentation="Variant"
 Object ( Variant Data) $RAMBSP( Variant Data, Variant Addr
    , Bit ClkG, Variant WE) ;  //_GUI 51,18
 //_ Attributes Documentation="var/var"

 //_ Behavior Topology
 Output.0 = Context.0;  
 MSB.0 = Input:A.0;  
 MSB:A.0 = Junction.1;  
 Junction.0 = Input.0;  
 Context.0 = Junction.0;  //_GUI 67,18, 67,15, 22,15
 Context.1 = $RAMBSP.0;  
 $RAMBSP.0 = MSB:A.0;  
 $RAMBSP.1 = MSB.0;  //_GUI 39,23, 39,28
 $RAMBSP.2 = Input:B.0;  //_GUI 43,26, 43,33
 $RAMBSP.3 = Input:C.0;  //_GUI 47,29, 47,36
}

Object ( Variant OutA, Variant OutB) RAMDP( Variant InA
    , Variant AddrA, Variant AddrB, Bit ClkG, Bit ClkG
    , Bit WE, Bit REB) 
//_ Attributes TreeGroup="CoreLib\\Memory\\$Internal",Icon="RAMDP2",Documentation="2 clk",REB
{
 // RAMDP is a dual-port RAM object. It is capable of reading from memory and writing to memory during the same clock cycle.
 //
 // Inputs:
 // InA - The data to be written into memory.
 // AddrA - The memory address to read or write.
 // AddrB - The memory address to read from.
 // ClkG(top) - Port A clock  Defaulted to the system clock.
 // ClkG(bottom) - Port B clock.  Defaulted to the system clock.
 // WE - Write Enable tells the memory to write the data InA to the address specified by AddA. When WE is deasserted, the object will read from the address specified and output data to OutA.
 // REB - Read Enable Port B.  This allows port B read data to be strobed.
 //
 // Outputs:
 // OutA: Outputs the data at address AddrA.
 // OutB: Outputs the data at address AddrB.
 //
 // Modified:
 // 12/07/04
 //
 // Revision 1
 //_ Object Prototypes
