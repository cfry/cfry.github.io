 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Variant Q) Reg( Variant D, Bit ClkG) ;  //_GUI 88,45
 Object ( Bit Out) $Cast( Variant Data, Bit Type) ;  //_GUI 106,43
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 35,38
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 121,45

 //_ Behavior Topology
 Output.0 = Junction:A.1;  
 Mux.0 = OR.0;  
 Mux.1 = Input:C.0;  
 Mux.2 = Input:B.0;  //_GUI 64,46, 64,52
 OR.0 = Junction.1;  
 OR.1 = Junction:A.0;  //_GUI 43,42, 43,32, 122,32
 Reg.0 = Mux.0;  //_GUI 83,47, 83,41
 Reg.1 = Input:A.0;  //_GUI 58,50, 58,49
 $Cast.0 = Reg.0;  
 $Cast.1 = Junction.0;  //_GUI 106,23, 36,23
 Junction.0 = Input.0;  
 Junction:A.0 = $Cast.0;  
}

