Object ( Bit Done, Bit Busy) SyncClr( Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Synchronizers\\$Internal",Documentation="Passthrough"
{
 // Description:
 // This object is used to synchronize several Gos into a single Done.  You will notice that both Wait and Done are single Bits, giving a single bit interface to downstream objects.  Go and Wait are Lists however.  Go may be a List of Bits in any size or shape and Busy will be produced as a List of Bits matching the construction of the incoming Go List.  When an individual Go is received, the corresponding Busy Bit will be asserted.  The Busy bits are not deasserted and Done is not fired until all Gos have been received.
 //
 // Inputs:
 // ClkG:  global clock
 // Go:  go pulse
 // Wait:  passed from downstream
 //
 // Done:  sent downstream
 // Busy:  sent upstream
 //
 // Date:
 // November 9, 2002
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit ClkG) Input;  //_GUI 23,16
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:A;  //_GUI 23,20
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:B;  //_GUI 24,27
 Object ( Bit Wait) Input:C;  //_GUI 24,36
 //_ Attributes Constant="0"
 Object Output( Bit Done) ;  //_GUI 114,27
 Object Output:A( Bit Busy) ;  //_GUI 114,36

 //_ Behavior Topology
 Output.0 = Input:B.0;  
 Output:A.0 = Input:C.0;  
}

Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, List Busy) SyncRegClr( List Data, Bit ClkG
    , Bit AClr, List Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Synchronizers",Documentation="List/List"
{
 // A data synchronizer for joining two or more data flow paths.  Ready data paths are stalled until all data paths are ready.  . If there is a single Go, a register will still be built.  To not build a register in that case, use SyncRegPassClr.
 //
 // Inputs:
 //
 // Variant Data: Single data path or list of data paths to synchronize.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected.
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected.
 //
 // Variant Go: Go of GDBW.  Bit if single unsynchronized data path or a list of Gos, one for each data path to synchronize.
 //
 // Bit Wait: Wait of GDBW.  Defaults to 0 if disconnected.  Tells Done to hold off.
 //
 // Outputs:
 //
 // Variant Data: The registered data or a list of the synchronized registered data.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr Clear input pass through
 //
 // Bit Done: Done of GDBW.  Data valid while high.
 //
 // Variant Busy: Busy of GDBW.  Tells Go (or each individual Go, if a List) to hold off.
 //
 // Date:
 // 09 Nov 2002
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List Data) Input;  //_GUI 55,10
 Object ( Bit ClkG) Input:A;  //_GUI 42,51
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 42,54
 //_ Attributes Constant="0"
 Object ( List Go) Input:C;  //_GUI 48,61
 Object ( Bit Wait) Input:D;  //_GUI 90,66
 //_ Attributes Constant="0"
 Object Output( Variant Data) ;  //_GUI 99,10
 Object Output:A( Bit ClkG) ;  //_GUI 99,13
 Object Output:B( Bit AClr) ;  //_GUI 99,16
 Object Output:C( Bit Done) ;  //_GUI 98,41
 Object Output:D( List Busy) ;  //_GUI 124,56
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In2) ;  //_GUI 57,44
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In3) ;  //_GUI 60,35
 Object Text;  //_GUI 121,5,If we have a list of data coming in, we will assume that the list matches our list of Go signals coming in. That way we can register the data as it comes in with its go.
 Object ( Bit Done, Variant Busy) SyncClr( Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 67,34
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In3) ;  //_GUI 63,38
 Object ( List Out1, List Out2, List Out3) Junction:C
    ( List In3) ;  //_GUI 51,41
 Object ( Variant Q, Bit ClkG, Bit AClr
    , Variant Done, Variant Busy) RegisterClr( Variant D, Bit ClkG
    , Bit AClr, Variant Go, Variant Wait) ;  //_GUI 68,9
 //_ Attributes Documentation="Var/Bit"
 Object ( List Out) $Cast( Variant Data, List Type) ;  //_GUI 109,54
 Object ( List Out1, List Out2, List Out3) Junction:D
    ( List In3) ;  //_GUI 51,57
 Object ( Variant Out1) Cast( Variant Type, Variant Data) ;  //_GUI 81,56
 Object ( List Out1, List Out2, List Out3) Junction:E
    ( List In0) ;  //_GUI 74,57

 //_ Behavior Topology
 Output.0 = RegisterClr.0;  
 Output:A.0 = RegisterClr.1;  
 Output:B.0 = RegisterClr.2;  
 Output:C.0 = SyncClr.0;  
 Output:D.0 = $Cast.0;  
 Junction.0 = SyncClr.1;  
 Junction:A.0 = Input:A.0;  //_GUI 61,52
 SyncClr.0 = Junction:A.2;  
 SyncClr.1 = Junction:B.2;  
 SyncClr.2 = Junction:C.2;  
 SyncClr.3 = Input:D.0;  //_GUI 94,45
 Junction:B.0 = Input:B.0;  //_GUI 64,55
 Junction:C.0 = Junction:D.1;  
 RegisterClr.0 = Input.0;  
 RegisterClr.1 = Junction:A.1;  //_GUI 61,14
 RegisterClr.2 = Junction:B.1;  //_GUI 64,17
 RegisterClr.3 = Junction:C.1;  //_GUI 52,20
 RegisterClr.4 = Junction.1;  //_GUI 85,23, 85,27, 58,27
 $Cast.0 = Cast.0;  
 $Cast.1 = Junction:E.0;  //_GUI 103,56, 103,50, 75,50
 Junction:D.0 = Input:C.0;  
 Cast.0 = Junction:E.1;  
 Cast.1 = Junction.2;  //_GUI 58,61
 Junction:E.0 = Junction:D.2;  
}

