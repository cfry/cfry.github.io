 //_ Behavior Topology
 Output.0 = OR.0;  
 OR.0 = List_Mux.0;  //_GUI 109,38, 109,35
 OR.1 = List_Mux:A.0;  //_GUI 113,41, 113,46
 ListIn.0 = Input.0;  //_GUI 40,35, 40,16
 List_Mux.0 = ListIn.1;  
 List_Mux.1 = VariantIn.1;  //_GUI 81,37, 81,45
 List_Mux:A.0 = ListIn.0;  //_GUI 84,45, 84,40, 77,40, 77,37
 List_Mux:A.1 = VariantIn.0;  
 VariantIn.0 = Input:A.0;  
}

