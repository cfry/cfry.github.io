 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:D
    ( Variant In3) ;  //_GUI 55,22

 //_ Behavior Topology
 Output.0 = Junction.1;  
 Output:A.0 = VouchBit.0;  
 Output:B.0 = Context.0;  
 ExposeMSB.0 = MSB.0;  
 CollectMSB.0 = Junction.2;  //_GUI 114,17
 CollectMSB.1 = ADSU.2;  
 Junction.0 = ADSU.0;  
