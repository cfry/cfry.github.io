Object ( Variant OFL, Variant -Val) TwosComp( Variant Val) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Async\\Advanced"
{
 // Takes the twos complement (invert and add one) of a value and indicates an overflow.  The same as asynchronous Negate except that Negate ceilings and won't output an overflow signal.  An overflow only occurs when MAXNEG is input.
 //
 // Inputs:
 //
 // Var/List Val: The input value that will be twos complemented.
 //
 // Outputs:
 //
 // Bit/List OFL: Goes high if the input was MAXNEG.
 //
 // Var/List -Val: The Twos Complement of the Val input.
 //
 // Dataset Coverage:
 //
 // The Val input can be one of the following datasets: MSBxxx, LSBxxx, BINxxx, Signed, Fixed, Complex or List.
 //
 // Examples:
 //
 // Val	-Val	OFL
 // 000 (0)	000 (0)	0
 // 001 (1)	111 (-1)	0
 // 010 (2)	110 (-2)	0
 // 011 (3)	101 (-3)	0
 // 100 (-4)	100 (-4)	1
 // 101 (-3)	011 (3)	0
 // 110 (-2)	010 (2)	0
 // 111 (-1)	001 (1)	0
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 9,17
 Object Output( Variant OFL) ;  //_GUI 39,17
 Object Output:A( Variant -Val) ;  //_GUI 39,20
 Object ( Variant OFL, Variant Val) TwosCompEn( Variant Val
    , Variant En) ;  //_GUI 22,16
 Object ( Bit En) Input:A;  //_GUI 16,20
 //_ Attributes PromoteToParentObject="False",Constant="1"

 //_ Behavior Topology
 Output.0 = TwosCompEn.0;  
 Output:A.0 = TwosCompEn.1;  
 TwosCompEn.0 = Input.0;  
 TwosCompEn.1 = Input:A.0;  
}

Object ( Bit OFL, Variant Val) TwosCompEn( Variant Val
    , Bit En) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Async\\Advanced"
{
 // Takes the twos complement (invert and add one) of a value and indicates an overflow.  The same as asynchronous Negate except that Negate ceilings and won't output an overflow signal.  An overflow only occurs when MAXNEG is input.
 //
 // Inputs:
 //
 // Var/List Val:	The input value that will be conditionally twos complemented.
 //
 // Bit/List En:	Enables the twos complementing of the input Val.
 //
 // Outputs:
 //
 // Bit/List OFL:	Goes high if enabled and the input was MAXNEG.
 //
 // Var/List -Val:	The Twos Complement of the Val input if enabled, Val otherwise.
 //
 // Dataset Coverage:
 //
 // The Val input can be one of the following datasets: MSBxxx, LSBxxx, BINxxx, Signed, Fixed, Complex or List.  If Val is a List, En can be an equally sized List of bits or a bit.  If Val is not a List, En must be a bit.
 //
 // Examples:
 //
 // En	Val	-Val	OFL
 // 0	YYY	YYY	0
 // 1	000 (0)	000 (0)	0
 // 1	001 (1)	111 (-1)	0
 // 1	010 (2)	110 (-2)	0
 // 1	011 (3)	101 (-3)	0
 // 1	100 (-4)	100 (-4)	1
 // 1	101 (-3)	011 (3)	0
 // 1	110 (-2)	010 (2)	0
 // 1	111 (-1)	001 (1)	0
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 13,17
 Object ( Bit En) Input:A;  //_GUI 13,23
 Object Output( Bit OFL) ;  //_GUI 97,12
 Object Output:A( Variant Val) ;  //_GUI 97,18
