Object ( Variant Out1) OR-List( List In1) 
//_ Attributes TreeGroup="CoreLib\\Gates\\$Internal\\$OR",Documentation="list"
{
 // Takes a list of values and ORs them together.  The list input must be homogeneous with the exception of elements of type Bit that sets all bits to 1.  The output dataset is that of a homogeneous element.  The homogeneous elements are ORed together then the entire output is set high by any high Bit inputs.
 //
 // Inputs:
 //
 // Variant input: A homogeneous list with the exception of Bit elements.  The homogeneous list elements do not necessarily need to have the same dataset, but must all have the same number of bits.
 //
 // Outputs:
 //
 // Variant output: The homogeneous elements are ORed together then the entire output is set high by any high Bit inputs.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List In1) Input;  //_GUI 9,26
 Object Output( Variant Out1) ;  //_GUI 168,37
 Object ( Variant Out1) $OR-List( Variant In1, Variant Around) ;  //_GUI 128,28
 //_ Attributes Documentation="list/list"
 Object ( List Out1) Bit_List( Variant In1) ;  //_GUI 93,27
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 88,29
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 142,28
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 155,35
 Object ( Variant Out1, Variant Around) Transpose( Variant In1
    , Variant Around) ;  //_GUI 109,28
 //_ Attributes Documentation="list/list"
 Object Text;  //_GUI 111,6,We use the "around" here to maintain our original list dimension. This allows us to support two-demensional lists without using terminators.
 Object ( Variant LsbList) LsbList( Variant AnyList) ;  //_GUI 15,24
 Object Text;  //_GUI 15,32,Transpose only works with linear lists.
 Object ( Variant Data, Variant PrevDS) $BitOrSameDS( Variant Data
    , Variant PrevDS) ;  //_GUI 41,25
 //_ Attributes Documentation="list/var"
 Object ( Bit In) Input:A;  //_GUI 35,29
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object Text;  //_GUI 41,34,Verify that all non bit elements are the same dataset.
 Object ( Bit OFL, Bit UFL, Variant Out3) SignExtnd
    ( Variant Type, Variant Data) ;  //_GUI 75,22
 //_ Attributes Documentation="OFL and UFL"
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 59,29
 Object Text;  //_GUI 68,40,Duplicate the single bits to the size of the rest of the list's dataset.  This allows the single bit inputs to behave as a gate for the rest of the data.
 Object Text;  //_GUI 91,40,Turn the list's elements into lists of bits, effectively making this a 2D array of bits.  If each input is a row, we want to OR all of the columns.
 Object Text;  //_GUI 111,40,Transpose, making the columns rows
 Object Text;  //_GUI 129,39,OR the rows together potentially using optomized hardware for wide OR gates.
 Object Text;  //_GUI 143,45,Put the list of bits into an MSBxxx dataset
 Object Text;  //_GUI 156,46,Apply the original dataset context.
 Object ( Variant Out1) MSB:A( Variant In1) ;  //_GUI 62,21
 Object Text;  //_GUI 58,8,MSB the type here so all elements have a compatible dataset with Bit_List.

 //_ Behavior Topology
 Output.0 = Context.0;  
 $OR-List.0 = Transpose.0;  
 $OR-List.1 = Transpose.1;  
 Bit_List.0 = Junction.1;  
 Junction.0 = SignExtnd.2;  
