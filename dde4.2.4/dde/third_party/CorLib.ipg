 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:F
    ( Bit In0) ;  //_GUI 171,32
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:G
    ( Bit In1) ;  //_GUI 23,51
 Object ( Bit Out) AND:B( Bit In1, Bit In2) ;  //_GUI 140,29
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:H
    ( Bit In0) ;  //_GUI 35,102
 Object ( Bit Out1) $Cast( Variant Data, Bit Type) ;  //_GUI 113,83
