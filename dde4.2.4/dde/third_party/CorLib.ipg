Object ( Bit OFL, Bit Round, Variant Falloff
    , Floating Shifted, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) Shift_MinHW( Floating Data, Variant ShiftBy, Bit "L/R"
    , Bit IsTwos, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced\\MinHW",Documentation="Floating"
{
 // A multi-clock-cycle barrel shifter.  Utilizes minimal hardware.
 //
 // Inputs:
 //
 // Variant Data: The input data that will be shifted.  Also works for a Floating dataset to multiply and divide by powers of two.
 //
 // Variant ShiftBy: The number representing the number of bits to shift.
 //
 // Bit L/R: 0 to shift left, 1 to shift right.  If disconnected, defaults to 0 (left shift).
 //
 // Bit IsTwos: 1 to perform a two's complement shift (sign extend a right shift).
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronously clears the register.  If disconnected, defaults to 0.
 //
 // Bit Go: The Go of GDBW.  Enables the latching of the input data, as long as not Busy.
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant ShiftedData: The output Data that was left justified.  Same dataset as Data.
 //
 // Variant ShiftMask: A value of 1 shifted left ShiftNum times. Same dataset as Data.
 //
 // Variant ShiftNum: The number of times Data was shifted to left-justify the data.
 //
 // Bit Done: The Done of GDBW.  Indicates valid outputs ShiftedData, ShiftMask, and ShiftNum.
 //
 // Bit Busy: The Busy of GDBW.  Holds off the Go.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Floating Data) Input;  //_GUI 24,32
 Object ( Variant ShiftBy) Input:A;  //_GUI 24,49
 Object ( Bit "L/R") Input:B;  //_GUI 24,53
 //_ Attributes Constant="0"
 Object ( Bit IsTwos) Input:C;  //_GUI 24,56
 //_ Attributes Constant="0"
 Object ( Bit ClkG) Input:D;  //_GUI 48,60
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:E;  //_GUI 49,63
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:F;  //_GUI 43,66
 Object ( Bit Wait) Input:G;  //_GUI 104,85
 //_ Attributes Constant="0"
 Object Output( Bit OFL) ;  //_GUI 151,4
 Object Output:A( Bit Round) ;  //_GUI 184,11
 Object Output:B( Variant Falloff) ;  //_GUI 205,27
 Object Output:C( Floating Shifted) ;  //_GUI 211,32
