 //_ Attributes Constant="0"
 Object Output( Variant Entered) ;  //_GUI 97,24
 Object Output:A( Variant Active) ;  //_GUI 97,31
 Object Output:B( Variant Leaving) ;  //_GUI 97,45
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 53,31
