Object ( Bit DQ) StickyPassClr( Bit D, Bit ClkG
    , Bit SCLR, Bit CLR) 
//_ Attributes TreeGroup="CoreLib\\Registers\\Advanced"
{
 // Passes a One through asynchronously and then also stickys it high until synchronously or asynchronously cleared.
 //
