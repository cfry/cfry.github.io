 Object ( List Out1) Bit_List( Variant In1) ;  //_GUI 35,34
 Object ( List Out1) Bit_List:A( Variant In1) ;  //_GUI 35,42

 //_ Behavior Topology
 Output.0 = UpDownCount.0;  
 Output:A.0 = UpDownCount.1;  
