    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) Gate-NInput_Pipe( Variant Val, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 43,22

 //_ Behavior Topology
 Output.0 = Gate-NInput_Pipe.0;  
 Output:A.0 = Gate-NInput_Pipe.1;  
