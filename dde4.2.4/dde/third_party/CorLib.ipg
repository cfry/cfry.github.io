    ( Bit In0) ;  //_GUI 64,46
 Object ( Variant Q) RegClr( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 71,45
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 84,45

 //_ Behavior Topology
 Output.0 = VouchBit.0;  
 Junction.0 = Input.0;  
 RegClr.0 = Junction.1;  
 RegClr.1 = Input:A.0;  
 RegClr.2 = Junction.2;  //_GUI 65,53
 RegClr.3 = Input:B.0;  
 VouchBit.0 = RegClr.0;  
}

