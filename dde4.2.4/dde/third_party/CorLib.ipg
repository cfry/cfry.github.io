Object ( Variant Q, Bit ClkG, Bit AClr
    , Bit Done, Bit Busy) RegGDBW( Variant D, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Registers\\Advanced"
{
 // A GDBW based register with single element queuing.  It won't pass a stall through until it is holding a value.
 //
 // Inputs:
 //
 // Variant D:	The data to be registered.
 //
 // Bit ClkG:	The input clock.  If disconnected, defaults to the ClkG, the global user clock signal.
 //
 // Bit AClr:	An asynchronous clear.  If disconnected, defaults to 0.
 //
 // Bit Go:	Go of the GDBW protocol.  D is registered when Go is high and Busy is low on a rising clock edge.
 //
 // Bit Wait:	Wait of the GDBW protocol.  Holds off Done.  If disconnected, defaults to 0.
 //
 // Outputs:
 //
 // Variant Q:	The data in the register.  Valid only while Done is high.
 //
 // Bit Done:	Done of the GDBW protocol.  Q is valid when Done is high.
 //
 // Bit Busy:	Busy of the GDBW protocol.  Tells the Go to hold off.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant D) Input;  //_GUI 44,40
 Object ( Bit ClkG) Input:A;  //_GUI 29,52
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 25,70
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:C;  //_GUI 21,82
 Object ( Bit Wait) Input:D;  //_GUI 20,90
 //_ Attributes Constant="0"
 Object Output( Variant Q) ;  //_GUI 186,41
 Object Output:A( Bit ClkG) ;  //_GUI 186,52
 Object Output:B( Bit AClr) ;  //_GUI 186,70
 Object Output:C( Bit Done) ;  //_GUI 200,93
 Object Output:D( Bit Busy) ;  //_GUI 191,102
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 117,79
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 84,52
 Object ( Variant Q) RegClr( Variant D, Bit ClkG
    , Variant EN, Bit CLR) ;  //_GUI 146,39
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 72,70
 Object ( Bit GoOne, Bit B, Bit Going
    , Bit D) GDBW_Clr( Bit ClkG, Bit G, Bit W
    , Bit DoneIn, Bit AClr) ;  //_GUI 85,78

 //_ Behavior Topology
 Output.0 = RegClr.0;  
 Output:A.0 = Junction:A.1;  
 Output:B.0 = Junction:B.1;  
 Output:C.0 = GDBW_Clr.3;  //_GUI 99,94
 Output:D.0 = GDBW_Clr.1;  //_GUI 126,103, 126,83
 Junction.0 = GDBW_Clr.0;  
