//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced"
{
 // Negates the imaginary portion of a complex number.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Complex/List input: Value
 //
 // Outputs:
 //
 // Complex/List output: The conjugate of the input value.
 //
 // Dataset Coverage:
 //
 // A Complex dataset composed of a pair of Signed, Fixed or Floating datasets.  Also supports a list of Complex datasets..
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 25,24
 Object Output( Variant Out1) ;  //_GUI 37,24
 Object Text;  //_GUI 16,30,The complex conjugate on a non-complex number does nothing.

 //_ Behavior Topology
 Output.0 = Input.0;  
}

