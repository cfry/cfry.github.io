Object ( Variant Out1) Subset( Variant Data, Variant Mask) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\Bits"
{
 // This object uses the Mask to determine which input bits will be propagated downstream.
 //
 // Inputs:
 //
 // Variant Data: The data of which a subset will be output.
 //
 // Variant Mask: A constant value representing the subset pass-through mask. One bits in Mask allow corresponding bits in Data to pass through.  Zero bits in Mask drop bits in Data and are not sent to the output.  If the number of One bits in Mask is less than the number of bits in Data, the most significant bits of Data will be dropped.  If the number of one bits in Mask is more than the number of bits in Data, then the output is the size of Data.
 //
 // Outputs:
 //
 // Variant output: The Mask subset of Data. The length of the resulting dataset is equal to the number of ones in Mask that are within the range of Data.  The output value is the Mask subset of the Data input.
 //
 // Examples:
 //
 // Data	=	1	0	1	0
 // Mask#1	=  	1	0	1	0
 // Mask#2	=	0	1	0	1
 // Mask#3	=		1	0	1
 // Mask#4	=	1	0	1	1
 // Mask#5	=  1	1	0	0	0
 //
 // result using Mask#1 = 11
 // result using Mask#2 = 00
 // result using Mask#3 = 00
 // result using Mask#4 = 110
 // result using Mask#5 = 1
 //
 // Revision 2 - 11/07/05 Behavior did not change.
 // Changed documentation. More ones in Mask than bits in Data did not unsign extend output. Simplified implementation.
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 33,24
 Object ( Variant Mask) Input:A;  //_GUI 33,31
 Object Output( Variant Out1) ;  //_GUI 92,29
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 42,24
 Object Text;  //_GUI 37,35,BitMask must be greater or equal to the data length.  If data bitlength is greater than "BitMask" then it won't work correctly.
 Object ( Variant Out1) $Subset( Variant Data, Variant Mask) ;  //_GUI 75,27
 //_ Attributes Documentation="var/var"
 Object ( Bit OFL, Variant Out1) Convert( Variant Type
    , Variant Data) ;  //_GUI 50,27

 //_ Behavior Topology
 Output.0 = $Subset.0;  
 Junction.0 = Input.0;  
 $Subset.0 = Junction.1;  //_GUI 66,29, 66,25
 $Subset.1 = Convert.1;  
 Convert.0 = Junction.2;  //_GUI 43,29
 Convert.1 = Input:A.0;  
}

