 // This object is the foundation for the Go-Done-Busy-Wait protocol. Please see the documentation inside this object for a full explanation.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit ClkG) Input;  //_GUI 16,10
 //_ Attributes Resource="Global"
