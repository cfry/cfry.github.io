 //_ Attributes Resource="Global"
 Object ( Bit En) Input:C;  //_GUI 32,51
 //_ Attributes Constant="1"
 Object ( Bit Init) Input:D;  //_GUI 32,54
 //_ Attributes Constant="0"
 Object Output( Variant Q) ;  //_GUI 98,37
