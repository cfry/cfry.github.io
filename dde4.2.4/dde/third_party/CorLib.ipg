Object ( Variant Out1) Interleave( List "LsbInIsLsbOut+1", List LsbInIsLsbOut) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced",Documentation="list/list"
{
 // This object combines the data of two groups where the input items are interleaved in an every-other fashion.  This object has the opposite behavior as EveryOther.  Input items can either be bits of a Variant or elements of a List.  The LSB item of the lower input becomes the LSB item of the output. The LSB item of the upper input becomes the LSB+1 item of the output. The LSB+1 item of the lower input becomes the LSB+2 item of the output. The LSB+1 item of the upper input becomes the LSB+3 item of the output. Etc. The output is either an LSBxxx dataset or an LSB ordered list.
 //
 // Note: This object doesn't support single element lists.  If single element lists need to be supported, use InterleaveList instead.
 //
 // Inputs:
 //
 // Variant LsbInIsLsbOut+1: The items of this input map to the LSB + (1, 3, 5, etc.) items of the output.
 //
 // Variant LsbInIsLsbOut: The items of this input map to the LSB + (0, 2, 4, etc.) items of the output.
 //
 // Outputs:
 //
 // Variant output: The resulting interleaved variant or list.
 //
 // Example:
 //
 // Interleave with two inputs of LsbInIsLsbOut+1 = PackLSB (D, B) and LsbInIsLsbOut = PackLSB (E, C, A) would have the equivelent output of a 5 element LSB ordered list of PackLSB (E, D, C, B, A).
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List "LsbInIsLsbOut+1") Input;  //_GUI 26,14
 Object ( List LsbInIsLsbOut) Input:A;  //_GUI 26,17
 Object Output( Variant Out1) ;  //_GUI 50,15
 Object ( Variant Out1) InterleaveList( Variant "LsbInIsLsbOut+1", Variant LsbInIsLsbOut) ;  //_GUI 32,13
 //_ Attributes Documentation="list/list"

 //_ Behavior Topology
 Output.0 = InterleaveList.0;  
 InterleaveList.0 = Input.0;  
 InterleaveList.1 = Input:A.0;  
}

