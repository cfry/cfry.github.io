 Object ( Variant I) Input:H;  //_GUI 9,32
 Object ( Variant J) Input:I;  //_GUI 9,35
 Object ( Variant K) Input:J;  //_GUI 9,38
 Object ( Variant L) Input:K;  //_GUI 9,41
 Object ( Variant M) Input:L;  //_GUI 9,44
 Object ( Variant N) Input:M;  //_GUI 9,47
 Object ( Variant O) Input:N;  //_GUI 9,50
 Object ( Variant P) Input:O;  //_GUI 9,53
 Object ( Variant Q) Input:P;  //_GUI 9,56
 Object ( Variant R) Input:Q;  //_GUI 9,59
 Object ( Variant S) Input:R;  //_GUI 9,62
 Object ( Variant T) Input:S;  //_GUI 9,65
 Object ( Variant U) Input:T;  //_GUI 9,68
 Object ( Variant V) Input:U;  //_GUI 9,71
 Object ( Variant W) Input:V;  //_GUI 9,74
 Object ( Variant X) Input:W;  //_GUI 9,77
 Object ( Variant Y) Input:X;  //_GUI 9,80
 Object ( Variant Z) Input:Y;  //_GUI 9,83
 Object ( Variant 0) Input:Z;  //_GUI 9,86
 Object ( Variant 1) Input:a;  //_GUI 9,89
 Object ( Variant 2) Input:b;  //_GUI 9,92
 Object ( Variant 3) Input:c;  //_GUI 9,95
 Object ( Variant 4) Input:d;  //_GUI 9,98
