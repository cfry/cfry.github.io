Object ( Variant R, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) Mul( Variant A, Variant B
    , Bit ClkG, Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps",Icon="MUL"
{
 // Synchronous multiply.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant A: Multiplicand
 //
 // Variant B: Multiplier
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Variant Go: Go of GDBW.  Can be a Bit or can be a pair of items in a list.  The items can either be a bit or else a list of bit structures that match the list structures of the corresponding A or B inputs.  Each Go bit latches in corresponding data.
 //
 // Bit Wait: Wait. Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant R: Product
 //
 // Bit ClkG: clock input pass through
 //
 // Bit AClr: clear input pass through
 //
 // Bit Done: Done or GDBW
 //
 // Variant Busy: Busy of GDBW.  Matches dataset of Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned, output dataset is BINxxx whose size is the size of A plus the size of B.  For 2's complement multiplies use the Mul_Twos object or use the Signed dataset on this object), Signed (the output dataset is Signed whose size is the size of A plus the size of B), Floating (the resulting exponent size is the larger of the two exponent sizes, if different a warning is generated.  The significand is rounded.  Infinity and NaN are supported), Fixed (The result's whole size is the sum of the two inputs' whole sizes.  The result's fractional size is the sum of the two inputs' fractional sizes), one or two Lists and Complex (Real becomes magnitude, imaginary becomes zero.  For Signed Complex the outputs are twice the input size plus one bit.  For Fixed Complex, the outputs are twice the input size plus one bit in the whole portion.  For Floating Complex, no dataset changes made to output).  A and B can not have mixed datasets except with respect to size or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Since in non-floating point cases the result is twice as large as the inputs, if you want to get the result back down to the original size, follow the Mul by a Convert object which will also check for overflow.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 11,11
 Object ( Variant B) Input:A;  //_GUI 11,14
 Object ( Bit ClkG) Input:B;  //_GUI 11,17
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 11,20
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 11,23
 Object ( Bit Wait) Input:E;  //_GUI 74,32
 //_ Attributes Constant="0"
 Object Output( Variant R) ;  //_GUI 80,11
 Object Output:A( Bit ClkG) ;  //_GUI 80,17
 Object Output:B( Bit AClr) ;  //_GUI 80,20
 Object Output:C( Bit Done) ;  //_GUI 80,23
 Object Output:D( Variant Busy) ;  //_GUI 12,29
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 18,10
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 51,10
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 33,13
 //_ Attributes Documentation="List/List"
 Object ( Variant R, Variant PipeLen, Bit ClkG
    , Bit AClr, Bit Done, Bit Busy) Mul_Pipe( Variant A
    , Variant B, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) ;  //_GUI 65,10

 //_ Behavior Topology
 Output.0 = Mul_Pipe.0;  
 Output:A.0 = Mul_Pipe.2;  
 Output:B.0 = Mul_Pipe.3;  
 Output:C.0 = Mul_Pipe.4;  
 Output:D.0 = SyncQueuePass.4;  //_GUI 12,27
 ListOut.0 = Input:A.0;  
 ListOut.1 = Input.0;  
 ListIn.0 = SyncQueuePass.0;  //_GUI 50,13, 50,15
 SyncQueuePass.0 = ListOut.0;  //_GUI 31,15, 31,13
 SyncQueuePass.1 = Input:B.0;  
 SyncQueuePass.2 = Input:C.0;  
 SyncQueuePass.3 = Input:D.0;  
 SyncQueuePass.4 = Mul_Pipe.5;  
 Mul_Pipe.0 = ListIn.1;  
 Mul_Pipe.1 = ListIn.0;  
 Mul_Pipe.2 = SyncQueuePass.1;  
 Mul_Pipe.3 = SyncQueuePass.2;  
 Mul_Pipe.4 = SyncQueuePass.3;  
 Mul_Pipe.5 = Input:E.0;  
}

Object ( Variant R, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) Mul_Twos( Variant A, Variant B
    , Bit ClkG, Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Advanced\\Twos",Icon="MUL"
{
 // Synchronously multiplies A and B as twos complement numbers.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant A: Multiplicand
 //
 // Variant B: Multiplier
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Variant Go: Go of GDBW.  Can be a Bit or can be a pair of items in a list.  The items can either be a bit or else a list of bit structures that match the list structures of the corresponding A or B inputs.  Each Go bit latches in corresponding data.
 //
 // Bit Wait: Wait. Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant R: Product
 //
 // Bit ClkG: clock input pass through
 //
 // Bit AClr: clear input pass through
 //
 // Bit Done: Done or GDBW
 //
 // Variant Busy: Busy of GDBW.  Matches dataset of Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (interpreted as twos complement numbers, output dataset is BINxxx whose size is the size of A plus the size of B), Signed (the output dataset is Signed whose size is the size of A plus the size of B), and one or two Lists.  A and B can not have mixed datasets except with respect to size or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Since in non-floating point cases the result is twice as large as the inputs, if you want to shrink the result back down to the original size, follow the Mul_Twos by a SignExtnd object which will also check for overflow.
 //
 // The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 11,11
 Object ( Variant B) Input:A;  //_GUI 11,14
 Object ( Bit ClkG) Input:B;  //_GUI 11,17
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 11,20
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 11,23
 Object ( Bit Wait) Input:E;  //_GUI 77,32
 //_ Attributes Constant="0"
 Object Output( Variant R) ;  //_GUI 83,11
 Object Output:A( Bit ClkG) ;  //_GUI 83,17
 Object Output:B( Bit AClr) ;  //_GUI 83,20
 Object Output:C( Bit Done) ;  //_GUI 83,23
 Object Output:D( Variant Busy) ;  //_GUI 12,29
