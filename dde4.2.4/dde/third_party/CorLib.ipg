Object ( Complex Out1) DynamicOut( Complex In1) 
//_ Attributes TreeGroup="CoreLib\\Converters\\$Internal\\DynamicOut",Documentation="Complex"
{
 // Used to convert a static dataset into a dynamic dataset of the same size.  A static dataset is a dataset that is natively supported by the host processor, such as Float, Fixed32 or DInt.  A dynamic dataset is one that does not have host implementation limitations.  For example a Floating dataset with 1 sign bit, 4 biased exponent bits and 8 bits of significand, or a Fixed dataset with 4 whole bits and 10 fractional bits.  Also supports complex and list datasets of static and dynamic datasets for inputs and outputs respectively.
 //
 // Inputs:
 //
 // Variant input: The static dataset
 //
 // Outputs:
 //
 // Variant output: The dynamic dataset
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Complex In1) Input;  //_GUI 34,21
 Object Output( Complex Out1) ;  //_GUI 99,21
 Object ( Variant Out1) DynamicOut( Variant In1) ;  //_GUI 61,12
 Object ( Variant Out1) DynamicOut:A( Variant In1) ;  //_GUI 61,21
 Object ( Complex Out1) CollectComplex( Variant Real, Variant Imag) ;  //_GUI 79,19
 Object ( Variant Real, Variant Imag) ExposeComplex( Complex In1) ;  //_GUI 42,19

 //_ Behavior Topology
 Output.0 = CollectComplex.0;  
 DynamicOut.0 = ExposeComplex.0;  //_GUI 58,15
 DynamicOut:A.0 = ExposeComplex.1;  
 CollectComplex.0 = DynamicOut.0;  //_GUI 77,21, 77,15
 CollectComplex.1 = DynamicOut:A.0;  
 ExposeComplex.0 = Input.0;  
}

Object ( Variant ShiftedData, Variant ShiftMask, Variant ShiftNum
    , Bit Zero, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) LeftJustify( Variant Data, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced"
{
 // Implements the LeftJustify shifting the data left (towards the most significant end) until the high (most significant bit) is set.  This object has a single cycle throughput (fully pipelined) with a latency dependent upon the dataset size of Data.
 //
 // Inputs:
 //
 // Variant Data: The input data that will be left justified.
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronously clears the register.  If disconnected, defaults to 0.
 //
 // Bit Go: The Go of GDBW.  Enables the latching of the input data, as long as not Busy.
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant ShiftedData: The output Data that was left justified.  Same dataset as Data.
 //
 // Variant ShiftMask: A value of 1 shifted left ShiftNum times. Same dataset as Data.
 //
 // Variant ShiftNum: The number of times Data was shifted to left-justify the data.  Zero if Data is Zero
 //
 // Bit Zero: High if Data is Zero, low otherwise.
 //
 // Bit Done: The Done of GDBW.  Indicates valid outputs ShiftedData, ShiftMask, and ShiftNum.
 //
 // Bit Busy: The Busy of GDBW.  Holds off the Go.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 33,33
 Object ( Bit ClkG) Input:A;  //_GUI 33,36
 Object ( Bit AClr) Input:B;  //_GUI 33,39
 Object ( Bit Go) Input:C;  //_GUI 33,54
 Object ( Bit Wait) Input:D;  //_GUI 51,65
 Object Output( Variant ShiftedData) ;  //_GUI 57,33
 Object Output:A( Variant ShiftMask) ;  //_GUI 57,36
 Object Output:B( Variant ShiftNum) ;  //_GUI 57,39
 Object Output:C( Bit Zero) ;  //_GUI 57,42
 Object Output:D( Bit ClkG) ;  //_GUI 57,48
 Object Output:E( Bit AClr) ;  //_GUI 57,51
 Object Output:F( Bit Done) ;  //_GUI 57,54
 Object Output:G( Bit Busy) ;  //_GUI 40,62
 Object ( Variant ShiftedData, Variant ShiftMask, Variant ShiftNum
    , Bit Zero, Variant PipeLen, Bit ClkG, Bit AClr
    , Bit Done, Bit Busy) LeftJustify_Pipe( Variant Data, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) ;  //_GUI 39,32

 //_ Behavior Topology
 Output.0 = LeftJustify_Pipe.0;  
 Output:A.0 = LeftJustify_Pipe.1;  
 Output:B.0 = LeftJustify_Pipe.2;  
 Output:C.0 = LeftJustify_Pipe.3;  
 Output:D.0 = LeftJustify_Pipe.5;  
 Output:E.0 = LeftJustify_Pipe.6;  
 Output:F.0 = LeftJustify_Pipe.7;  
 Output:G.0 = LeftJustify_Pipe.8;  //_GUI 39,63
 LeftJustify_Pipe.0 = Input.0;  
 LeftJustify_Pipe.1 = Input:A.0;  
 LeftJustify_Pipe.2 = Input:B.0;  
 LeftJustify_Pipe.3 = Input:C.0;  
 LeftJustify_Pipe.4 = Input:D.0;  
}

