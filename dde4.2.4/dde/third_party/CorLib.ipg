Object ( Variant "LsbOutIsLsbIn+1", Variant LsbOutIsLsbIn) EveryOther( List In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced",Documentation="list"
{
 // This object splits the data up into two groups where every other input item is sent to one of the two outputs.  Input items can either be bits of a Variant or elements of a List.  The LSB item of the input becomes the LSB item of the lower output. The LSB+1 item of the input becomes the LSB item of the upper output. The LSB+2 item of the input becomes the LSB+1 item of the lower output. The LSB+3 item of the input becomes the LSB+1 item of the upper output. Etc. Outputs are either LSBxxx datasets or LSB ordered lists.
 //
 // Note: This object doesn't support single element lists.  If single element lists need to be supported, use EveryOtherList instead.
 //
 // Inputs:
 //
 // Variant input: The variant or list that will be split in an every other manner.
 //
 // Outputs:
 //
 // Variant LsbOutIsLsbIn+1: The items of this output are the LSB + (1, 3, 5, etc.) items of the input.
 //
 // Variant LsbOutIsLsbIn: The items of this output are the LSB + (0, 2, 4, etc.) items of the input.
 //
 // Example:
 //
 // EveryOther with an input of a 5 element MSB ordered list of PackMSB (E, D, C, B, A) would have the equivelent outputs of LsbOutIsLsbIn+1 = PackLSB (D, B) and LsbOutIsLsbIn = PackLSB (E, C, A).
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List In1) Input;  //_GUI 21,20
 Object Output( Variant "LsbOutIsLsbIn+1") ;  //_GUI 47,19
 Object Output:A( Variant LsbOutIsLsbIn) ;  //_GUI 47,22
 Object ( Variant "LsbOutIsLsbIn+1", Variant LsbOutIsLsbIn) EveryOtherList( List In1) ;  //_GUI 28,18
 //_ Attributes Documentation="list"

 //_ Behavior Topology
 Output.0 = EveryOtherList.0;  
 Output:A.0 = EveryOtherList.1;  
 EveryOtherList.0 = Input.0;  
}

