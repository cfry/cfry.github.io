Object ( Bit Pulse) PreShot( Bit I, Bit ClkG) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // After I is clocked low, Pulse follows I until I is latched High.  Pulse then stays low until I is latched low.
 //
 // Inputs:
 //
 // Variant I: Input
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Outputs:
 //
 // Variant Pulse: Pulse
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit I) Input;  //_GUI 8,10
 Object ( Bit ClkG) Input:A;  //_GUI 8,19
 //_ Attributes Resource="Global"
 Object Output( Bit Pulse) ;  //_GUI 71,11
 Object ( Variant Q) Reg( Variant D, Bit ClkG) ;  //_GUI 23,15
 Object ( Variant Out1) AND( Variant In1, Variant In2) ;  //_GUI 53,9
 Object ( Variant Out1) INVERT( Variant In1) ;  //_GUI 35,15
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 17,10
 Object Text;  //_GUI 4,41,ClkG __/---\___/---\___/---\___/---\____/---\____/---\____/---\____/---\____/---\    I ____/-------------------\_______/--------\________/----\__/-\___/----\___/--Pulse ____/-----\_____________________/--\______________/--\__________/----\___/--        ^       ^               ^        ^        ^        ^        ^        ^        |       |               |        |        |        |        |        |        |       |               |        |        |        |        |        o I still latched low, Pulse can still follow I.        |       |               |        |        |        |        o I latched low, Pulse can now follow I.        |       |               |        |        |        o I latched high, pulse forced low.        |       |               |        |        o I latched low, Pulse can now follow I.        |       |               |        o I latched high, pulse forced low.        |       |               o I latched low, Pulse can now follow I.        |       o I latched High, Pulse forced low.        o I latched low, Pulse can now follow I.Courier New,8,0,0

 //_ Behavior Topology
 Output.0 = AND.0;  
 Reg.0 = Junction.2;  //_GUI 18,17
 Reg.1 = Input:A.0;  
 AND.0 = Junction.1;  
 AND.1 = INVERT.0;  //_GUI 49,14, 49,18
 INVERT.0 = Reg.0;  
 Junction.0 = Input.0;  
}

Object ( Variant Out1) SwapHalf( Variant In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\Bits"
{
 // This object swaps the most significant half of the bits with the least significant half of the bits.  If the number of bits is odd, the extra bit is considered in the lower half that is then moved to the upper half.
 //
 // Inputs:
 //
 // Variant input: The data whose halves will be swapped.
 //
 // Outputs:
 //
 // Variant output: The input data with halves swapped.  The output dataset is of type BINxxx or Bit.
 //
 // Examples:
 //
 // input	output
 // 1100	0011
 // 11100	10011
 // 00111	11100
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 18,36
 Object Output( Variant Out1) ;  //_GUI 62,33
 Object ( Variant Out1, Variant Out1) ExposeBIN( Variant In1) ;  //_GUI 24,34
 //_ Attributes Documentation="Bit"
 Object ( Variant Out1) CollectBIN( Variant In1, Variant In2) ;  //_GUI 48,31
 Object Text;  //_GUI 25,43,If odd bits, bigger half is on the bottom, then goes on the top.

 //_ Behavior Topology
 Output.0 = CollectBIN.0;  
 ExposeBIN.0 = Input.0;  
 CollectBIN.0 = ExposeBIN.1;  //_GUI 41,33, 41,39
 CollectBIN.1 = ExposeBIN.0;  
}

