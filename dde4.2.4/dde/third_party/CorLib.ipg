Object ( Variant Out1) XOR-List( List In1) 
//_ Attributes TreeGroup="CoreLib\\Gates\\$Internal\\$XOR",Documentation="list"
{
 // Takes a list of values and XORs them together.  The list input must be homogeneous with the exception of elements of type Bit that XORes all bits with 1.  The output dataset is that of a homogeneous element.  The homogeneous elements are XORed together then the entire output is XORed by any high Bit inputs.
 //
 // Inputs:
 //
 // Variant input: A homogeneous list with the exception of Bit elements.  The homogeneous list elements do not necessarily need to have the same dataset, but must all have the same number of bits.
 //
 // Outputs:
 //
 // Variant output: The homogeneous elements are XORed together then the entire output is XORed high by any high Bit inputs.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List In1) Input;  //_GUI 7,25
 Object Output( Variant Out1) ;  //_GUI 166,36
 Object ( Variant Out1) $XOR-List( Variant In1, Variant Around) ;  //_GUI 126,27
 //_ Attributes Documentation="var/var"
 Object ( List Out1) Bit_List( Variant In1) ;  //_GUI 91,26
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 86,28
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 140,27
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 153,34
 Object ( Variant Out1, Variant Around) Transpose( Variant In1
    , Variant Around) ;  //_GUI 107,27
 //_ Attributes Documentation="list/list"
 Object Text;  //_GUI 109,5,We use the "around" here to maintain our original list dimension. This allows us to support two-demensional lists without using terminators.
 Object ( Variant LsbList) LsbList( Variant AnyList) ;  //_GUI 13,23
 Object Text;  //_GUI 13,31,Transpose only works with linear lists.
 Object ( Variant Data, Variant PrevDS) $BitOrSameDS( Variant Data
    , Variant PrevDS) ;  //_GUI 39,24
 //_ Attributes Documentation="list/var"
 Object ( Bit In) Input:A;  //_GUI 33,28
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object Text;  //_GUI 39,33,Verify that all non bit elements are the same dataset.
 Object ( Bit OFL, Bit UFL, Variant Out3) SignExtnd
    ( Variant Type, Variant Data) ;  //_GUI 73,21
 //_ Attributes Documentation="OFL and UFL"
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 57,28
 Object Text;  //_GUI 66,39,Duplicate the single bits to the size of the rest of the list's dataset.  This allows the single bit inputs to behave as a gate for the rest of the data.
 Object Text;  //_GUI 89,39,Turn the list's elements into lists of bits, effectively making this a 2D array of bits.  If each input is a row, we want to XOR all of the columns.
 Object Text;  //_GUI 109,39,Transpose, making the columns rows
 Object Text;  //_GUI 127,38,XOR the rows together potentially using optomized hardware for wide XOR gates.
 Object Text;  //_GUI 141,44,Put the list of bits into an MSBxxx dataset
 Object Text;  //_GUI 154,45,Apply the original dataset context.
 Object ( Variant Out1) MSB:A( Variant In1) ;  //_GUI 60,20
 Object Text;  //_GUI 56,7,MSB the type here so all elements have a compatible dataset with Bit_List.

 //_ Behavior Topology
 Output.0 = Context.0;  
 $XOR-List.0 = Transpose.0;  
 $XOR-List.1 = Transpose.1;  
 Bit_List.0 = Junction.1;  
 Junction.0 = SignExtnd.2;  
 MSB.0 = $XOR-List.0;  
 Context.0 = Junction:A.2;  //_GUI 58,36
 Context.1 = MSB.0;  //_GUI 150,39
 Transpose.0 = Bit_List.0;  
 Transpose.1 = Junction.2;  //_GUI 87,32
 LsbList.0 = Input.0;  
 $BitOrSameDS.0 = LsbList.0;  
 $BitOrSameDS.1 = Input:A.0;  
 SignExtnd.0 = MSB:A.0;  
 SignExtnd.1 = $BitOrSameDS.0;  
 Junction:A.0 = $BitOrSameDS.1;  
 MSB:A.0 = Junction:A.0;  //_GUI 58,23
}

