Object ( Variant AND, Variant OR, Variant XOR
    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) Gate-List
    ( List List, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Gates\\$Internal",Documentation="list"
{
 // Takes a list of values and ANDs, ORs and XORs them together.  The list input must be homogeneous with the exception of elements of type Bit that get duplicated to the full homogeneous size.  The output dataset is that of a homogeneous element.  The homogeneous elements are AND, OR and XORed together.
 //
 // Inputs:
 //
 // Variant input: A homogeneous list with the exception of Bit elements.  The homogeneous list elements do not necessarily need to have the same dataset, but must all have the same number of bits.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected.
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected.
 //
 // Bit Go: Go of GDBW.
 //
 // Bit Wait: Wait of GDBW.  Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant AND: The homogeneous elements are ANDed together then the entire output is gated by any Bit inputs.
 //
 // Variant OR: The homogeneous elements are ORed together then the entire output is set to one by any high Bit inputs.
 //
 // Variant XOR: The homogeneous elements are XORed together then the entire output is inverted by any high Bit inputs.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr Clear input pass through
 //
 // Bit Done: Done of GDBW.  Outputs valid while high.
 //
 // Bit Busy: Busy of GDBW.  Tells Go to hold off.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List List) Input;  //_GUI 30,18
 Object ( Bit ClkG) Input:A;  //_GUI 30,21
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 30,24
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:C;  //_GUI 30,36
 Object ( Bit Wait) Input:D;  //_GUI 49,46
 //_ Attributes Constant="0"
 Object Output( Variant AND) ;  //_GUI 55,18
 Object Output:A( Variant OR) ;  //_GUI 55,21
 Object Output:B( Variant XOR) ;  //_GUI 55,24
 Object Output:C( Bit ClkG) ;  //_GUI 55,30
 Object Output:D( Bit AClr) ;  //_GUI 55,33
 Object Output:E( Bit Done) ;  //_GUI 55,36
 Object Output:F( Bit Busy) ;  //_GUI 36,50
 Object ( Variant AND, Variant OR, Variant XOR
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) Gate-List_Pipe( List List, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 36,17

 //_ Behavior Topology
 Output.0 = Gate-List_Pipe.0;  
 Output:A.0 = Gate-List_Pipe.1;  
 Output:B.0 = Gate-List_Pipe.2;  
 Output:C.0 = Gate-List_Pipe.4;  
 Output:D.0 = Gate-List_Pipe.5;  
 Output:E.0 = Gate-List_Pipe.6;  
 Output:F.0 = Gate-List_Pipe.7;  
 Gate-List_Pipe.0 = Input.0;  
 Gate-List_Pipe.1 = Input:A.0;  
 Gate-List_Pipe.2 = Input:B.0;  
 Gate-List_Pipe.3 = Input:C.0;  
 Gate-List_Pipe.4 = Input:D.0;  //_GUI 53,40
}

