Object ( Bit Out1) ZeroDisconnectedConst( Bit In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip\\$Internal",Documentation="Bit"
{
 // The input must be a constant value or a disconnected value (disconnected at some point upstream).  When the input is a constant the output is a constant of the same value.  When the input is a disconnected bit or bits due to sorceless removal, the output becomes a constant value of zero of the original dataset.
 //
 // This object is useful for detecting the presence of global variables or flags for modules that may or may not be include in a particular design.  It is also useful for overriding default preferences or could be used in conjunction with system parameters.
 //
 // Inputs:
 //
 // Variant input: Input constant value or a sourceless transport.
 //
 // Outputs:
 //
 // Variant output: Outputs the same constant input value or a value of zero if the input resolved to a sourceless bit transport.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit In1) Input;  //_GUI 20,25
 Object Output( Bit Out1) ;  //_GUI 46,20
 Object ( Bit In) Input:A;  //_GUI 28,19
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Bit In) Input:B;  //_GUI 28,22
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object ( Bit Out) $Select( Variant "#0", Variant "#1"
    , Bit S) ;  //_GUI 34,18
 Object Text;  //_GUI 16,34,This is a compile time object only.The input must be a constant bit or a disconnected bit.When the input is a constant bit the output is a constant bit of the same value.When the input is a disconnected bit due to sorceless removal, the output is a constant bit of zero.

 //_ Behavior Topology
 Output.0 = $Select.0;  
 $Select.0 = Input:A.0;  
 $Select.1 = Input:B.0;  
 $Select.2 = Input.0;  
}

Object ( Variant Val) NegateEn( Variant Val, Bit En) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced"
{
 // Conditionally negates a number.  For twos complement, Signed and Fixed datasets, if the input value is the maximum negative value, Negate returns the maximum positive value instead of producing a overflow signal.  If this is insufficient, use TwosComp instead.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant input: Value
 //
 // Bit/List En: If 0, the input value is passed through unchanged.  If 1, the input value is negated.
 //
 // Outputs:
 //
 // Variant output: The negative of the input value if En is 1, unchanged otherwise.
 //
 // Dataset Coverage:
 //
 // Unsigned/Twos-Complement (MSBxxx, LSBxxx and BINxxx assumes twos complement and produces warning.  Use TwosComp if you don't want a warning.), Signed, Fixed, Floating, Complex, List with Bit En and List with List En.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 8,27
 Object ( Bit En) Input:A;  //_GUI 8,30
 //_ Attributes Constant="1"
 Object Output( Variant Val) ;  //_GUI 57,25
 Object ( Variant OFL, Variant Val) TwosCompEn( Variant Val
    , Variant En) ;  //_GUI 19,26
 Object ( Bit In) Input:B;  //_GUI 21,39
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object Output:A( Bit Out) ;  //_GUI 27,39
 //_ Attributes Trap="Negating an unsigned number."
 Object ( Variant Out1) InvertEn( Variant In1, Bit En) ;  //_GUI 43,23

 //_ Behavior Topology
 Output.0 = InvertEn.0;  
 TwosCompEn.0 = Input.0;  
 TwosCompEn.1 = Input:A.0;  
 Output:A.0 = Input:B.0;  
 InvertEn.0 = TwosCompEn.1;  //_GUI 39,25, 39,31
 InvertEn.1 = TwosCompEn.0;  
}

