Object ( Variant Q) RegDepth( Variant D, Bit ClkG
    , Variant depth) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced"
{
 // RegDepth instantiates a cascading shift register, or set of pipelines.  The number of stages is specified via the bitlength of the depth input (n).  n registers are then recursively tiled, producing a pipeline with latency n.
 //
 // Inputs:
 // D - Data input
 // Bit ClkG - The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 // depth - the latency of the RegDepth is equal to the bitlength of depth
 //
 // Outputs:
 // Q - output data
 //
 // Date:
 // 16 Nov, 2004
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant D) Input;  //_GUI 15,23
 Object ( Bit ClkG) Input:A;  //_GUI 15,26
 //_ Attributes Resource="Global"
 Object ( Variant depth) Input:B;  //_GUI 15,32
 Object Output( Variant Q) ;  //_GUI 42,24
 Object ( Variant Q) RegEnDepth( Variant D, Bit ClkG
    , Bit EN, Variant depth) ;  //_GUI 26,22
 Object ( Bit In) Input:C;  //_GUI 20,29
 //_ Attributes PromoteToParentObject="False",Constant="1"

 //_ Behavior Topology
 Output.0 = RegEnDepth.0;  
 RegEnDepth.0 = Input.0;  
 RegEnDepth.1 = Input:A.0;  
 RegEnDepth.2 = Input:C.0;  
 RegEnDepth.3 = Input:B.0;  
}

Object ( Bit Error) StaticError( Variant Type) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip\\$Internal\\Advanced"
{
 // Description:
 // Reports the presence of a deprecated Static Type.  As Static Types are no longer used to provide context, the presence of any Static Type other than the default Unsigned signifies incorrect data set usage.
 //
 // Inputs:
 // Type: the data set that has been propogated to an operator.
 //
 // Outputs:
 // Error: asserted if the input type has anything other than the default Unsigned attribute.
 //
 // Date:
 // January 26, 2003
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Type) Input;  //_GUI 37,22
 Object Output( Bit Error) ;  //_GUI 80,25
 Object ( Variant Out1) OR( Variant In1, Variant In2
    , Variant In3, Variant In4) ;  //_GUI 66,23
 Object ( Bit Unsigned, Bit Signed, Bit "Fixed Point"
    , Bit "Floating Point", Bit Complex) StaticType( Variant Type) ;  //_GUI 43,20
 Object Text;  //_GUI 36,40,Static Types are a deprecated concept in Viva.  Since Context is now exclusively handled via Contextual Data Sets, the Static Type attribute is no longer used.  All grammatical data sets should have the default value of Unsigned.  This object is used in context-sensitive operators to catch and report an error when a user uses old-style static data sets to provide context.  The library operators no longer support static data types, and  as such will treat them all as grammatical Nums (unsigned integers).  When a static type error is found, a library operator will generally issue a warning message and then build the operator the only way it knows how, which is in the context of an unsigned integer.Arial,9,0,0

 //_ Behavior Topology
 Output.0 = OR.0;  
 OR.0 = StaticType.1;  
 OR.1 = StaticType.2;  
 OR.2 = StaticType.3;  
 OR.3 = StaticType.4;  
 StaticType.0 = Input.0;  
}

Object ( Bit OFL, Variant Out1) ShiftBy( Variant Data
    , Variant ShiftBy, Bit "L/R") 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Async"
{
 // A barrel shifter.  Data is shifted right or left by ShiftBy amount.
 //
 // Since barrel shifters use large amounts of physical resources, the ShiftBy input is preprocessed, converting it into the smallest data set possible of representing the bit length of Data.  This ensures that an optimal structure is created.
 // If the ShiftBy input is constant, this object simply becomes a series of SHRs, which are free.
 //
 // Inputs:
 //
 // Variant Data: The input data that will be shifted at runtime.
 //
 // Variant ShiftBy: The amount to shift data by.
 //
 // Bit L/R: If this input is a 0 Data is shifted to the left, right otherwise.
 //
 // Outputs:
 //
 // Bit OFL: Overflow (OFL) goes high when any bits shifted off the end have a high value or there is a shift amount range error.
 //
 // Variant output: The shifted Data output.
 //
 // Date:
 // 07 Nov 2002
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 17,20
 Object ( Variant ShiftBy) Input:A;  //_GUI 18,43
 Object ( Bit "L/R") Input:B;  //_GUI 17,55
 //_ Attributes Constant="0"
 Object Output( Bit OFL) ;  //_GUI 127,21
 Object Output:A( Variant Out1) ;  //_GUI 125,45
 Object ( Variant O) Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 109,43
 Object ( Variant O) Mux:A( Variant A, Variant B
    , Bit S) ;  //_GUI 109,19
 Object ( Bit OFL, Variant Out1) ShiftLeftBy( Variant Data
    , Variant ShiftBy) ;  //_GUI 52,19
 Object ( Bit OFL, Variant Out1) ShiftRightBy( Variant Data
    , Variant ShiftBy) ;  //_GUI 51,39
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 39,20
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 43,43
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In3) ;  //_GUI 101,50

 //_ Behavior Topology
 Output.0 = Mux:A.0;  
 Output:A.0 = Mux.0;  
 Mux.0 = ShiftLeftBy.1;  //_GUI 77,45, 77,24
 Mux.1 = ShiftRightBy.1;  //_GUI 70,48, 70,44
 Mux.2 = Junction:B.2;  
 Mux:A.0 = ShiftLeftBy.0;  
 Mux:A.1 = ShiftRightBy.0;  //_GUI 82,24, 82,31, 74,31, 74,41
 Mux:A.2 = Junction:B.1;  //_GUI 102,27
 ShiftLeftBy.0 = Junction.1;  
