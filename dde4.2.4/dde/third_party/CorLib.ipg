Object ( Variant S_Data, Variant P_Type, Variant StageMsk
    , Bit Done, Bit Busy) "Parallel->Serial_Clr"( Variant P_Data, Variant S_Type
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters"
{
 // Parallel to serial with clear, a space to time converter.
 //
 // INPUTS:
 // P_Data: Parallel data latched when Go is high and Busy is low.
 //
 // S_Type: The data type of the S_Data output.  If the size of S_Type doesn't divide evenly into the size of P_Data, a warning is produced and the remainder bits are zero extended and output in the last stage.
 //
 // ClkG: The ClkG global clock, if not connected.  Otherwise any other clock.  This object has been tested up to 200 MHz.
 //
 // AClr: An asynchronous clear. If unconnected, defaults to 0
 //
 // Go: When high and Busy is low, P_Data is registered.
 //
 // Wait: When high, Done will stay low.  The down-stream object raises the Wait signal if it is not ready for data.
 //
 // OUTPUTS:
 // S_Data: The serial output data is valid when Done is high.
 //
 // P_Type: The data set (zero data) passed in with P_Data.
 //
 // StageMsk: An MSB dataset with P_Data/S_Type bit size.  The LSB is the first stage, the MSB is the last stage and behaves like a shift register as serial data is shifted out.
 //
 // Done: Indicates when valid serial data is coming out of S_Data to be registered.  Done will never go high while Wait is high
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant P_Data) Input;  //_GUI 39,18
