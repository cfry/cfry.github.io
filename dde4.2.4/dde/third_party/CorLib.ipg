Object ( Variant Sign, Variant Abs) Abs_Twos( Variant Val) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced\\Twos"
{
 // Asynchronous absolute value of a twos complement number.
 //
 // Rather than reporting an error if a maximum negative twos complement number is input (because its positive representation takes one more bit) the result is forced to the maximum positive number.  If this is not the desired behavior but you wish to be informed of an overflow, use the FromTwos object instead.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Var/List Val: Number
 //
 // Outputs:
 //
 // Bit/List Sign: Indicates sign of Val.  Asserted if negative.
 //
 // Var/List Abs: Absolute value of Val
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (assumes twos complement), Signed, Fixed and List (produces list outputs).
 //
 // Examples:
 //
 // Val	Sign	Abs
 // 000 (0)	0	000 (0)
 // 001 (1)	0	001 (1)
 // 010 (2)	0	010 (2)
 // 011 (3)	0	011 (3)
 // 100 (-4)	1	011 (3)
 // 101 (-3)	1	011 (3)
 // 110 (-2)	1	010 (2)
 // 111 (-1)	1	001 (1)
 //
