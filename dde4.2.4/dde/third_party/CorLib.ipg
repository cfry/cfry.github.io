Object ( Variant OFL, Variant Q, Variant R) DivMod_Twos
    ( Variant N, Variant D) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced\\Twos",Icon="DIV"
{
 // Asynchronously divides N by D as twos complement numbers producing an integer quotient and remainder.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant N: Dividend or Numerator
 //
 // Variant D: Divisor or Denominator
 //
 // Outputs:
 //
 // Variant OFL: Overflow or Error.  List if N or D are Lists, otherwise Bit.
 //
 // Variant Q: Quotent as a twos complement number. Same dataset as symmetrized inputs N and D.
 //
 // Variant R : Remainder or Modulous result as a twos complement number.  Same dataset as symmetrized inputs N and D.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (interpreted as twos complement numbers), Signed, and one or two Lists.  A and B can not have mixed datasets except with respect to size (produces a warning) or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant N) Input;  //_GUI 10,27
 Object ( Variant D) Input:A;  //_GUI 10,30
 Object Output( Variant OFL) ;  //_GUI 199,21
 Object Output:A( Variant Q) ;  //_GUI 199,33
 Object Output:B( Variant R) ;  //_GUI 199,50
 Object ( Variant Out1, Variant Out2) Symmetrize( Variant In1
    , Variant In2) ;  //_GUI 17,26
 //_ Attributes Documentation="Bit/Variant"
 Object ( Variant Out1) XOR( Variant In1, Variant In2) ;  //_GUI 82,28
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 78,29
 Object Text;  //_GUI 8,6,We could use the sign bit handling in the SRT divider, but that would require handling on the tail end to get the sign on the remainder correct. In the unsigned version the sign bit is set to a constant, thus removing some of the objects. With that in mind we might as well just do the twos conversion on the front and back end for simplicity's sake -- it doesn't use any more hardware.
 Object ( Variant OFL, Variant Sign, Variant Unsigned) FromTwos
    ( Variant TwosComp) ;  //_GUI 34,25
 Object ( Bit OFL, Variant Q, Variant R) UDivMod
    ( Variant N, Variant D) ;  //_GUI 64,43
 Object ( Variant OFL, Variant Sign, Variant Unsigned) FromTwos:A
    ( Variant TwosComp) ;  //_GUI 34,40
 Object ( Variant OFL, Variant TwosComp) ToTwos( Variant Sign
    , Variant Unsigned) ;  //_GUI 147,29
 Object ( Variant Out1) OR( Variant In1, Variant In2
    , Variant In3) ;  //_GUI 174,19
 Object Text;  //_GUI 32,15,It's OK if this Overflows because MaxNeg is represented properly as an unsigned number in the FromTwos output
 Object Text;  //_GUI 68,59,UDivMod outputs MaxInt on OFL.  We need to remove the top bit and use it to generate our overflow.  Replace the bit with a zero bit so we get MaxInt_Twos on an error.
 Object ( Variant Out1, Variant Out1) ExposeMSB( Variant In1) ;  //_GUI 94,48
 //_ Attributes Documentation="bit"
 Object ( Variant Out1, Variant Out1) ExposeMSB:A( Variant In1) ;  //_GUI 86,35
 //_ Attributes Documentation="bit"
 Object ( Variant Out1) CollectMSB( Variant In2, Variant In3) ;  //_GUI 131,48
 Object ( Variant Out1) CollectMSB:A( Variant In2, Variant In3) ;  //_GUI 131,35
 Object ( Bit In) Input:B;  //_GUI 125,49
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Bit In) Input:C;  //_GUI 125,36
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Variant OFL, Variant TwosComp) ToTwos:A( Variant Sign
    , Variant Unsigned) ;  //_GUI 147,46

 //_ Behavior Topology
 Output.0 = OR.0;  
 Output:A.0 = ToTwos.1;  
 Output:B.0 = ToTwos:A.1;  
 Symmetrize.0 = Input.0;  
 Symmetrize.1 = Input:A.0;  
 XOR.0 = Junction.1;  
 XOR.1 = FromTwos:A.1;  //_GUI 63,33, 63,37, 57,37, 57,45
 Junction.0 = FromTwos.1;  
 FromTwos.0 = Symmetrize.0;  
 UDivMod.0 = FromTwos.2;  //_GUI 60,45, 60,33
 UDivMod.1 = FromTwos:A.2;  
 FromTwos:A.0 = Symmetrize.1;  //_GUI 31,43, 31,31
 ToTwos.0 = XOR.0;  
 ToTwos.1 = CollectMSB:A.0;  //_GUI 146,34, 146,38
 OR.0 = UDivMod.0;  //_GUI 75,21
 OR.1 = ExposeMSB:A.0;  //_GUI 107,24, 107,37
 OR.2 = ExposeMSB.0;  //_GUI 110,27, 110,50
 ExposeMSB.0 = UDivMod.2;  
 ExposeMSB:A.0 = UDivMod.1;  //_GUI 84,38, 84,48
 CollectMSB.0 = Input:B.0;  
 CollectMSB.1 = ExposeMSB.1;  
 CollectMSB:A.0 = Input:C.0;  
 CollectMSB:A.1 = ExposeMSB:A.1;  
 ToTwos:A.0 = Junction.2;  //_GUI 145,48, 145,45, 79,45
 ToTwos:A.1 = CollectMSB.0;  
}

