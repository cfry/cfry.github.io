Object ( Variant SE_OFL, Variant SExtnd, Variant UE_OFL
    , Variant UExtnd, Variant PR_OFL, Variant PadRight, Bit Done
    , Bit Busy) Extend( Variant Type, Variant Data, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Advanced"
{
 // Used to extend or contract a dataset by an unsigned extend, a signed extend, or a pad right, depending which outputs you use.  Overflows can only occur when contracting data.  Pipeline stages are only created when contracting data to compute the overflows.  The non-overflow outputs are equivalently delayed.  If expanding data, no pipeline stages are added and circuitry becomes just wires.  If contracting data, OFL will be computed using asynchronous logic unless the number of bits exceeds a frequency dependant threshold, in which case pipeline stages are added.  If overflows are not used when shrinking data, use the asynchronous objects SignExtnd, UExtnd, and PadRight instead.
 //
 // Inputs:
 //
 // Variant Type: The resulting dataset
 //
 // Variant Data: The input data and dataset
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit Go: Go
 //
 // Bit Wait: Wait. Has a value of 0 if disconnected.  Holds off Dones.
 //
 // Outputs:
 //
 // Bit/List SE_OFL: Indicates an overflow occurred while contracting with a sign extend.
 //
 // Variant SExtnd: Sign extended data to Type.
 //
 // Bit UE_OFL: Indicates an overflow occurred while contracting with an unsigned extend.
 //
 // Variant UExtnd: Unsigned extended data to Type.
 //
 // Bit PR_OFL: Indicates an overflow occurred while contracting with a pad right.
 //
 // Variant PadRight: Pad right data to Type.
 //
 // Bit ClkG: clock input pass through
 //
 // Bit Done: Done.  Data valid while Done is high.
 //
 // Bit Busy: Busy.  Hold off Gos.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Type) Input;  //_GUI 22,18
 Object ( Variant Data) Input:A;  //_GUI 22,21
 Object ( Bit ClkG) Input:B;  //_GUI 22,24
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 22,27
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:D;  //_GUI 22,39
 Object ( Bit Wait) Input:E;  //_GUI 40,51
 //_ Attributes Constant="0"
 Object Output( Variant SE_OFL) ;  //_GUI 45,18
 Object Output:A( Variant SExtnd) ;  //_GUI 45,21
 Object Output:B( Variant UE_OFL) ;  //_GUI 45,24
 Object Output:C( Variant UExtnd) ;  //_GUI 45,27
 Object Output:D( Variant PR_OFL) ;  //_GUI 45,30
 Object Output:E( Variant PadRight) ;  //_GUI 45,33
 Object Output:F( Bit Done) ;  //_GUI 46,39
 Object Output:G( Bit Busy) ;  //_GUI 28,47
 Object ( Variant SE_OFL, Variant SExtnd, Variant UE_OFL
    , Variant UExtnd, Variant PR_OFL, Variant PadRight, Variant PipeLen
    , Bit Done, Bit Busy) Extend_Pipe( Variant Type, Variant Data
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) ;  //_GUI 29,17

 //_ Behavior Topology
 Output.0 = Extend_Pipe.0;  
 Output:A.0 = Extend_Pipe.1;  
 Output:B.0 = Extend_Pipe.2;  
 Output:C.0 = Extend_Pipe.3;  
 Output:D.0 = Extend_Pipe.4;  
 Output:E.0 = Extend_Pipe.5;  
 Output:F.0 = Extend_Pipe.7;  
 Output:G.0 = Extend_Pipe.8;  //_GUI 28,43
 Extend_Pipe.0 = Input.0;  
 Extend_Pipe.1 = Input:A.0;  
 Extend_Pipe.2 = Input:B.0;  
 Extend_Pipe.3 = Input:C.0;  
 Extend_Pipe.4 = Input:D.0;  
 Extend_Pipe.5 = Input:E.0;  //_GUI 44,43
}

