Object ( Variant Iteration, Bit Active, Bit FinalDone
    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) For
    ( Variant Iterations, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // Produces one Done for every Go.  Uses the standard GDBW model.  Larger iterations at higher frequencies may not pass timing specifications. Counts up from 0 to (Iterations-1).
 //
 // Inputs:
 //
 // Variant  Iterations: This value indicates the number of iterations of Goes/Dones that are consumed/produced when a FinalDone is output.  This value is only read in on the first Go then is ignored for the rest of the Go iterations after which it will be read in again on the next Go. A Go with an Iterations value of 0 has undefined behavior.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous Clear has a value of 0 if disconnected.
 //
 // Bit Go: Go of the GDBW protocol.  Must drop if Busy goes high.
 //
 // Bit Wait: Wait or the GDBW protocol. Has a value of 0 if disconnected.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant  Iteration: Outputs the current iteration it is on.  Goes from 0 to Iterations-1.  Undefined while Done is low.
 //
 // Bit Active: Remains high after the iterations start (after the first Go) and remains high until FinalDone has completed.
 //
 // Bit Final Done: Is high on the last Done iteration.
 //
 // Bit ClkG: Connected to the ClkG input.
 //
 // Bit AClr: Connected to the AClr input.
 //
 // Bit Done: Done of GDBW protocol.  One Done for each Go.
 //
 // Bit Busy: Busy of the GDBW protocol.  Tells the Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx
 //
 // Revision 1
 // Revision 2 - 7/19/06 Use of common more general implementation.  Corrected documentation.
 //_ Object Prototypes
 Object ( Variant Iterations) Input;  //_GUI 33,23
 Object ( Bit ClkG) Input:A;  //_GUI 33,26
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 33,29
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:C;  //_GUI 33,41
 Object ( Bit Wait) Input:D;  //_GUI 59,56
 //_ Attributes Constant="0"
 Object Output( Variant Iteration) ;  //_GUI 71,23
 Object Output:A( Bit Active) ;  //_GUI 71,29
 Object Output:B( Bit FinalDone) ;  //_GUI 71,32
 Object Output:C( Bit ClkG) ;  //_GUI 71,35
 Object Output:D( Bit AClr) ;  //_GUI 71,38
 Object Output:E( Bit Done) ;  //_GUI 71,41
 Object Output:F( Bit Busy) ;  //_GUI 43,51
 Object ( Bit Data) Input:E;  //_GUI 37,20
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Variant Data, Variant Iteration, Bit FirstGoRdy
    , Bit Active, Bit FinalDone, Bit ClkG, Bit AClr
    , Bit Done, Bit Busy) For( Variant Data, Variant Iterations
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) ;  //_GUI 43,19

 //_ Behavior Topology
 Output.0 = For.1;  
 Output:A.0 = For.3;  
 Output:B.0 = For.4;  
 Output:C.0 = For.5;  
 Output:D.0 = For.6;  
 Output:E.0 = For.7;  
 Output:F.0 = For.8;  
 For.0 = Input:E.0;  
 For.1 = Input.0;  
 For.2 = Input:A.0;  
 For.3 = Input:B.0;  
 For.4 = Input:C.0;  
 For.5 = Input:D.0;  
}

