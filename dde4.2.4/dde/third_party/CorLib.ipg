Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) AddSub( Variant A
    , Variant B, Bit Add, Bit ClkG, Bit AClr
    , Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps"
{
 // A synchronous add or subtract object.
 //
 // Inputs:
 //
 // Variant A: A value or a list of values with which B is added to or subtracted from.
 //
 // Variant B: A value or a list of values to be added to or subtracted from A.
 //
 // Bit Add: 1 to Add, 0 to Subtract.  Add is latched in with B's Go.  If B is a list and B's Go is a list, Add must be a single bit constant.  Has a value of 1 if disconnected.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go of GDBW.  Can be a Bit if A and B don't need to be synchronized.  Can be a pair of bits in a list if A needs to be synchronized with B.  Can be a pair of lists in a list if the elements of a list for A need to be individually synchronized against the elements of a list for B.
 //
 // Bit Wait: Wait of GDBW.  If disconnected, has value of 0.
 //
 // Outputs:
 //
 // Bit/List OFL: Indicates there was an overflow on the adder.  A list if A and/or B are lists, or a Bit otherwise
 //
 // Variant S: The result of the add or subtract.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done of GDBW
 //
 // Bit/List Busy: Busy of GDBW.  Same dataset as Go.  One busy for each respective Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned), Signed, Fixed, Floating, Complex (real and imaginary OFLs ORed) and lists of these.  If one of A or B is a list and the other is not, the other is duplicated into a list matching the one then the respective list elements are added.  A and B pairs must have the same dataset (with the exception of MSBxxx, LSBxxx and BINxxx) or undefinded behavior will occur.  If A and B pairs don't have the same bit length, the pairs are symmetrized and a warning is generated.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 13,19
 Object ( Variant B) Input:A;  //_GUI 13,22
 Object ( Bit Add) Input:B;  //_GUI 13,25
 //_ Attributes Constant="1"
 Object ( Bit ClkG) Input:C;  //_GUI 13,34
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:D;  //_GUI 13,37
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:E;  //_GUI 13,40
 Object ( Bit Wait) Input:F;  //_GUI 144,46
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 145,25
 Object Output:A( Variant S) ;  //_GUI 145,28
 Object Output:B( Bit ClkG) ;  //_GUI 145,34
 Object Output:C( Bit AClr) ;  //_GUI 145,37
 Object Output:D( Bit Done) ;  //_GUI 145,40
 Object Output:E( Variant Busy) ;  //_GUI 14,46
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 48,18
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 81,21
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 63,24
 //_ Attributes Documentation="List/List"
 Object ( Variant B, Variant Add, Variant CI) $AddSubPrepBOut
    ( Variant In1, Variant Around) ;  //_GUI 98,24
 //_ Attributes Documentation="Passthrough"
 Object Text;  //_GUI 54,9,Don't need to register type information
