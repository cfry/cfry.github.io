Object ( Variant State) FirstState( Variant Enter, Variant Leave
    , Bit ClkG, Bit ASet) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // Same as the State object except that after reset/ASet it is in state (has a value of 1).  This object can be used as an initial state in a state machine.  Inputs to Enter and Leave the State.  The current State is output.  One state per bit.
 //
 // Inputs:
 //
 // Variant Enter: Enter state if clocked high
 //
 // Variant Leave: Leave state if clocked high and Enter is low.  Enter and Leave must have the same dataset.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit ASet: Asynchronous set.  Has a value of 0 if disconnected
 //
 // Outputs:
 //
 // Variant State: Current state.  Bits are individually controlled by respective Enter and Leave inputs.  Will have the same dataset as Enter and Leave.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx, BINxxx and Bit.
 //
 // Revision 1
 // Revision 2 - 07/20/06: changed CLR input name to ASet, changed InState output name to State, updated documentation, no behavior change.
 //_ Object Prototypes
 Object ( Variant Enter) Input;  //_GUI 62,37
 Object ( Variant Leave) Input:A;  //_GUI 62,42
 Object ( Bit ClkG) Input:B;  //_GUI 62,45
 //_ Attributes Resource="Global"
 Object ( Bit ASet) Input:C;  //_GUI 62,48
 //_ Attributes Constant="0"
 Object Output( Variant State) ;  //_GUI 125,40
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 69,37
 Object ( Variant Out1) INVERT( Variant In1) ;  //_GUI 73,35
 Object ( Variant Out1) AND( Variant In1, Variant In2) ;  //_GUI 85,36
 Object ( Variant Out1) INVERT:A( Variant In1) ;  //_GUI 113,38
 Object ( Variant State) State( Variant Enter, Variant Leave
    , Bit ClkG, Bit CLR) ;  //_GUI 98,38

 //_ Behavior Topology
 Output.0 = INVERT:A.0;  
 Junction.0 = Input.0;  
 INVERT.0 = Junction.1;  
 AND.0 = INVERT.0;  
 AND.1 = Input:A.0;  //_GUI 68,41, 68,43
 INVERT:A.0 = State.0;  
 State.0 = AND.0;  //_GUI 97,40, 97,39
 State.1 = Junction.2;  //_GUI 70,43
 State.2 = Input:B.0;  
 State.3 = Input:C.0;  
}

Object ( Variant P_Data, Variant S_Type, Variant StageMsk
