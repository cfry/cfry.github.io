    , Variant Data) ;  //_GUI 17,15

 //_ Behavior Topology
 Output.0 = TwosExtnd.0;  
 Output:A.0 = TwosExtnd.1;  
 TwosExtnd.0 = Input.0;  
 TwosExtnd.1 = Input:A.0;  
}

