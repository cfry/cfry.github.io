Object ( Variant Entered, Variant Active, Variant Leaving) FirstState
    ( Variant Enter, Variant Leave, Bit ClkG, Bit ASet) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // Same as the State(4,3) object except that after reset/ASet, it is in state (has a value of 1).  This object can be used as an initial state in a state machine.  Inputs to Enter and Leave the State.  The current State is output.  One state per bit.
 //
 // Inputs:
 //
 // Variant Enter: Enter state if clocked high
 //
 // Variant Leave: Leave state if clocked high and Enter is low.  Enter and Leave must have the same dataset.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit ASet: Asynchronous set.  Has a value of 0 if disconnected
 //
 // Outputs:
 //
 // Var Entered: This is a synchronous output indicating the state transitioned from inactive to active. Will have the same dataset as Enter and Leave.
 //
 // Var Active: Current state.  Bits are individually controlled by respective Enter and Leave inputs.  Will have the same dataset as Enter and Leave.
 //
 // Var Leaving: This is an asynchronous output indicating the state will be transitioning from active to inactive. Will have the same dataset as Enter and Leave.
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx, BINxxx and Bit.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Enter) Input;  //_GUI 23,36
 Object ( Variant Leave) Input:A;  //_GUI 23,39
 Object ( Bit ClkG) Input:B;  //_GUI 23,42
 //_ Attributes Resource="Global"
 Object ( Bit ASet) Input:C;  //_GUI 23,45
 //_ Attributes Constant="0"
 Object Output( Variant Entered) ;  //_GUI 104,30
 Object Output:A( Variant Active) ;  //_GUI 104,37
 Object Output:B( Variant Leaving) ;  //_GUI 104,51
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 60,37
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 30,36
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:B
    ( Variant In0) ;  //_GUI 33,39
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 36,42
 Object ( Variant Out1) AND( Variant In1, Variant In2
    , Variant In3) ;  //_GUI 79,49
 Object Text;  //_GUI 45,61,Leave the state if we are in state, requested to leave and not requested to enter.
 Object Text;  //_GUI 12,28,Enter has priority over leave
 Object Text;  //_GUI 44,19,The state is entered when not in state and requested to enter.
 Object ( Variant Out1) INVERT( Variant In1) ;  //_GUI 62,54
 //_ Attributes Documentation="Variant"
 Object ( Variant Out1) INVERT:A( Variant In1) ;  //_GUI 63,29
 //_ Attributes Documentation="Variant"
 Object ( Variant Out1) AND:A( Variant In1, Variant In2) ;  //_GUI 76,27
 Object ( Variant Pulse) OneShot( Variant I, Bit ClkG) ;  //_GUI 88,28
 Object ( Variant InState) FirstState( Variant Enter, Variant Leave
    , Bit ClkG, Bit ASet) ;  //_GUI 44,35

 //_ Behavior Topology
 Output.0 = OneShot.0;  
 Output:A.0 = Junction.1;  
 Output:B.0 = AND.0;  
 Junction.0 = FirstState.0;  
 Junction:A.0 = Input.0;  
 Junction:B.0 = Input:A.0;  
 Junction:C.0 = Input:B.0;  
 AND.0 = Junction.2;  //_GUI 61,51
 AND.1 = Junction:B.2;  //_GUI 34,54
 AND.2 = INVERT.0;  
 INVERT.0 = Junction:A.2;  //_GUI 31,57
 INVERT:A.0 = Junction.0;  //_GUI 61,32
 AND:A.0 = Junction:A.0;  //_GUI 31,29
 AND:A.1 = INVERT:A.0;  
 OneShot.0 = AND:A.0;  
 OneShot.1 = Junction:C.2;  //_GUI 85,33, 85,44, 58,44, 58,51, 37,51
 FirstState.0 = Junction:A.1;  
