Object ( Variant Out1) MakeVariant( Variant In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip"
{
 // Used to change the drawing time interpretation of a transport from a specific data set to a Variant dataset, i.e. unknown at drawing time.
 //
 // This is most often used when you have an overload of an object where a transport to an output horn is a specific dataset but you want the object's output node to show up as Variant. Placing the MakeVariant object in between the specific dataset transport and the output horn will cause the output horn's dataset to be Variant.  The associated output node of the object to show up as Variant at drawing time. Usually an object must be re-dropped for changes to datasets of input and output nodes to show up.
 //
 // Revision 1 - 12/19/06 - Bug 840
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 12,11
 Object Output( Variant Out1) ;  //_GUI 20,11

 //_ Behavior Topology
 Output.0 = Input.0;  
}

