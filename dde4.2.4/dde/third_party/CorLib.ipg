 Object ( Variant Go) Input:C;  //_GUI 43,41
 Object ( Bit Wait) Input:D;  //_GUI 56,53
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 62,26
 Object Output:A( Variant Neg) ;  //_GUI 62,29
 Object Output:B( Bit ClkG) ;  //_GUI 62,32
 Object Output:C( Bit AClr) ;  //_GUI 62,35
 Object Output:D( Bit Done) ;  //_GUI 62,41
 Object Output:E( Variant Busy) ;  //_GUI 44,49
 Object ( Bit Sub) Input:E;  //_GUI 43,32
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Variant Out1) Zero( Variant In1) ;  //_GUI 37,24
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 34,29
 Object ( Bit In) Input:F;  //_GUI 35,11
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object Output:F( Bit Trap) ;  //_GUI 41,11
