Object ( Variant Data, Variant Size) N_Bit_MSB_List( Variant Data
    , Variant N) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\Lists"
{
 // This object cuts the incoming Data dataset into pieces whose dataset and bit length is the same as the dataset and bit length of the N data input.  (Leading 0s are appended if necessary.)  These elements are then packed into an MSB-shaped List.  If Data input has a bit length of 21 (or 20 or 19) and the N input has a bit length of 3, Data output will be a List congaing 7 3-bit elements.  The order of the Bits in this List is identical to the order of the Bits in the Data input.
 //
 // Inputs:
 //
 // Variant Data: A set of bits of any dataset.
 //
 // Variant N:	The dataset (implies the number of bits) for each element of the output list.
 //
 // Outputs:
 //
 // Variant Data: The MSB ordered list with the input Data bits divided into the list elements where each list element has the N dataset and is therefore the same number of bits as N.
 //
 // Variant Size: Contains one Bit for every element in the Data List.  Has a dataset of MSBxxx.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 12,13
 Object ( Variant N) Input:A;  //_GUI 12,16
 Object Output( Variant Data) ;  //_GUI 79,16
 Object Output:A( Variant Size) ;  //_GUI 79,23
 Object ( Variant DataLeft, Variant DataOut) $N_Bit_List( Variant Data
    , Variant N, Variant Pattern) ;  //_GUI 60,12
 //_ Attributes Documentation="var"
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 21,13
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 18,16
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:B
    ( Variant In0) ;  //_GUI 56,20
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 43,18
 Object ( Variant RndUp, Variant RndDn) BitA_Div_BitB( Variant A
    , Variant B) ;  //_GUI 26,19

 //_ Behavior Topology
 Output.0 = $N_Bit_List.1;  
 Output:A.0 = Junction:B.2;  //_GUI 57,24
 $N_Bit_List.0 = Junction.1;  
 $N_Bit_List.1 = Junction:A.1;  
 $N_Bit_List.2 = Junction:B.1;  //_GUI 60,21
 Junction.0 = Input.0;  
 Junction:A.0 = Input:A.0;  
 Junction:B.0 = MSB.0;  
 MSB.0 = BitA_Div_BitB.0;  
 BitA_Div_BitB.0 = Junction.2;  //_GUI 22,21
 BitA_Div_BitB.1 = Junction:A.2;  //_GUI 19,24
}

