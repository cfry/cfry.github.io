Object ( Bit CO, Bit OFL, Variant Count
    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) UpDownCount
    ( Variant CBy, Bit StartOver, Bit Up, Bit CI
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced",Documentation="GDBW"
{
 // This object is an up/down counter.  It can also be thought of as an accumulator.  This object conforms to the GDBW protocol and is fully pipelined and can support large counters at high frequencies.  The object latency is dependent upon the size of the counter and the frequency it is compiled to run for.
 //
 // Inputs:
 //
 // Var/List CBy:	Count by.  The value of CBy is what is added (or subtracted) on a Go.  CBy can have a different value each time Go is enabled.  If CBy is a List of Variants, the output is similar to a list of counters that have a nested behavior such that a roll over of one will increment the next most significant counter in the list.
 //
 // Bit StartOver:	On a Go, this input tells the counter to start counting over.  It does not clear the register but adds/subtracts CBy to/from zero and places that in the register.  If this input is disconnected, defaults to 0.
 //
 // Bit Up:	On a Go, this input tells the counter to count up (high) or down (low).  If this input is disconnected, defaults to 1.
 //
 // Bit CI:	On a Go, this input is the carry in bit for the least significant bit of the adder.  It is used for daisy chaining counters.  If you are not daisy chaining the counters, connect it to an inverted value of the Up input.  If this input is disconnected, defaults to 0.
 //
 // Bit ClkG:	Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr:	Asynchronous clear.  Clears all of the counters.  If disconnected defaults to 0.
 //
 // Bit Go:	Enables the reading of the object's data inputs.
 //
 // Bit Wait:	Holds off any Dones.
 //
 // Outputs:
 //
 // Bit CO:	Carry Out bit.  If the internal accumulator rolls over (or doesn't roll under), this bit goes high.  Connect to the CI input if daisy chaining.  Also used to detect overflows of unsigned numbers.  Valid on Done.
 //
 // Bit OFL:	Overflow bit.  Used to detect overflows of twos complement numbers.  Valid on Done
 //
 // Var/List Count:	Count output(s).  The result of the count.  Valid on Done.  Has the same dataset as CBy.
 //
 // Bit Done:	Indicates valid data output.
 //
 // Bit Wait:	Tells Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx, BINxxx (for unsigned use CO, for twos complement use OFL), Signed (use OFL), Fixed (use OFL) and List
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant CBy) Input;  //_GUI 23,16
 Object ( Bit StartOver) Input:A;  //_GUI 23,19
 //_ Attributes Constant="0"
 Object ( Bit Up) Input:B;  //_GUI 23,22
 //_ Attributes Constant="1"
 Object ( Bit CI) Input:C;  //_GUI 23,25
 //_ Attributes Constant="0"
 Object ( Bit ClkG) Input:D;  //_GUI 23,28
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:E;  //_GUI 23,31
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:F;  //_GUI 23,34
 Object ( Bit Wait) Input:G;  //_GUI 50,42
 //_ Attributes Constant="0"
 Object Output( Bit CO) ;  //_GUI 51,16
 Object Output:A( Bit OFL) ;  //_GUI 51,19
 Object Output:B( Variant Count) ;  //_GUI 51,22
 Object Output:C( Bit ClkG) ;  //_GUI 51,28
 Object Output:D( Bit AClr) ;  //_GUI 51,31
 Object Output:E( Bit Done) ;  //_GUI 51,34
 Object Output:F( Bit Busy) ;  //_GUI 24,42
 Object ( Bit CO, Bit OFL, Variant R
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) CountUpDown_Pipe( Variant CBy, Bit StartOver, Bit Up
    , Bit CI, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) ;  //_GUI 29,15

 //_ Behavior Topology
 Output.0 = CountUpDown_Pipe.0;  
 Output:A.0 = CountUpDown_Pipe.1;  
 Output:B.0 = CountUpDown_Pipe.2;  
 Output:C.0 = CountUpDown_Pipe.4;  
 Output:D.0 = CountUpDown_Pipe.5;  
 Output:E.0 = CountUpDown_Pipe.6;  
 Output:F.0 = CountUpDown_Pipe.7;  //_GUI 24,38
 CountUpDown_Pipe.0 = Input.0;  
 CountUpDown_Pipe.1 = Input:A.0;  
 CountUpDown_Pipe.2 = Input:B.0;  
 CountUpDown_Pipe.3 = Input:C.0;  
 CountUpDown_Pipe.4 = Input:D.0;  
 CountUpDown_Pipe.5 = Input:E.0;  
 CountUpDown_Pipe.6 = Input:F.0;  
 CountUpDown_Pipe.7 = Input:G.0;  //_GUI 54,38
}

