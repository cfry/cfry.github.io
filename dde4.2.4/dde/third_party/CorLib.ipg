Object ( Bit OFL, Variant Data, Bit ClkG
    , Bit AClr, Bit Done, Bit Busy) FixedToTwos( Variant Type
    , Fixed Data, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Advanced"
{
 // Converts from a Fixed dataset to a twos complement dataset.  If Type is Signed, the Data output will also be Signed.
 //
 // Inputs:
 //
 // Variant Type: The output dataset
 //
 // Fixed Data: The input data and fixed dataset
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected.
 //
 // Bit Go: Go
 //
 // Bit Wait: Wait. Has a value of 0 if disconnected.  Holds off Dones.
 //
 // Outputs:
 //
 // Bit OFL: Indicates an overflow occurred while contracting with a sign extend.
 //
 // Variant Data: Sign extended data to Type.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Asynchronous clear input pass through
 //
 // Bit Done: Done.  Data valid while Done is high.
 //
 // Bit Busy: Busy.  Hold off Gos.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Type) Input;  //_GUI 38,27
 Object ( Fixed Data) Input:A;  //_GUI 38,30
 Object ( Bit ClkG) Input:B;  //_GUI 38,33
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 38,36
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:D;  //_GUI 38,42
 Object ( Bit Wait) Input:E;  //_GUI 60,50
 //_ Attributes Constant="0"
 Object Output( Bit OFL) ;  //_GUI 67,27
 Object Output:A( Variant Data) ;  //_GUI 67,30
 Object Output:B( Bit ClkG) ;  //_GUI 67,36
 Object Output:C( Bit AClr) ;  //_GUI 67,39
 Object Output:D( Bit Done) ;  //_GUI 67,42
 Object Output:E( Bit Busy) ;  //_GUI 45,52
