Object ( Variant Out1) ZeroDisconnectedConst( Variant In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip"
{
 // The input must be a constant value or a disconnected value (disconnected at some point upstream).  When the input is a constant the output is a constant of the same value.  When the input is a disconnected bit or bits due to sorceless removal, the output becomes a constant value of zero of the original dataset.
 //
 // This object is useful for detecting the presence of global variables or flags for modules that may or may not be include in a particular design.  It is also useful for overriding default preferences or could be used in conjunction with system parameters.
 //
 // Inputs:
 //
 // Variant input: Input constant value or a sourceless transport.  Even if this input is disconnected, it must resolve to a non-variant dataset to compile.  I.e., it can not be connected to a Global variant input horn where the global doesn't exist.
 //
 // Outputs:
 //
 // Variant output: Outputs the same constant input value or a value of zero if the input resolved to a sourceless transport.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 17,29
 Object Output( Variant Out1) ;  //_GUI 94,27
 Object ( Variant Out1, Variant Out2) VariantIn( Variant In) ;  //_GUI 31,27
 Object ( Variant Out) VariantOut( Variant In1, Variant In2) ;  //_GUI 69,27
 Object ( Variant Out1) Cast( Variant Type, Variant Data) ;  //_GUI 82,25
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 25,29
 Object ( Variant Out1) ZeroDisconnectedConst( Variant In1) ;  //_GUI 44,26
 //_ Attributes Documentation="Bit"
 Object ( Variant Out1) ZeroDisconnectedConst:A( Variant In1) ;  //_GUI 44,29
 //_ Attributes Documentation="Bit"

 //_ Behavior Topology
 Output.0 = Cast.0;  
 VariantIn.0 = Junction.1;  
 VariantOut.0 = ZeroDisconnectedConst:A.0;  
 VariantOut.1 = ZeroDisconnectedConst.0;  
 Cast.0 = Junction.0;  //_GUI 82,19, 26,19
 Cast.1 = VariantOut.0;  
 Junction.0 = Input.0;  
 ZeroDisconnectedConst.0 = VariantIn.1;  
 ZeroDisconnectedConst:A.0 = VariantIn.0;  
}

Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) Add( Variant A
    , Variant B, Bit ClkG, Bit AClr, Variant Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps"
{
 // Synchronous addition.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant A: Number
 //
 // Variant B: Number
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go of GDBW.  Can be a Bit if A and B don't need to be synchronized.  Can be a pair of bits in a list if A needs to be synchronized with B.  Can be a pair of lists in a list if the elements of a list for A need to be individually synchronized against the elements of a list for B.
 //
 // Bit Wait: Wait of GDBW.  If disconnected, defaults to 0.
 //
 // Outputs
 //
 // Bit/List OFL: Overflow.  Indicates there was an overflow on the adder.  A list if A and/or B are lists, or a Bit otherwise
 //
 // Var/List S: Sum of A and B.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done
 //
 // Bit/List Busy: Busy of GDBW.  Same dataset as Go.  One busy for each respective Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned), Signed, Floating, Fixed, List and Complex(real and imaginary OFLs ORed). A and B pairs must have the same dataset (with the exception of MSBxxx, LSBxxx and BINxxx) or undefinded behavior will occur.  If A and B pairs don't have the same bit length, the pairs are symmetrized and a warning is generated.  If one of A or B is a list and the other is not, the other is duplicated into a list matching one's and the add on respective list elements is performed.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 30,14
 Object ( Variant B) Input:A;  //_GUI 30,17
 Object ( Bit ClkG) Input:B;  //_GUI 30,23
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 30,26
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 30,29
 Object ( Bit Wait) Input:E;  //_GUI 49,42
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 55,14
 Object Output:A( Variant S) ;  //_GUI 55,17
 Object Output:B( Bit ClkG) ;  //_GUI 55,20
 Object Output:C( Bit AClr) ;  //_GUI 55,23
 Object Output:D( Bit Done) ;  //_GUI 55,29
