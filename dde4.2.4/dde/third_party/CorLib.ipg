    , Variant R) Compare( Variant A, Variant B) ;  //_GUI 255,105
 //_ Attributes Documentation="Variant"
 Object Text;  //_GUI 183,113,we can put a fair amount of logic in a row here because the dataset is small
 Object Text;  //_GUI 3,96,In actual C:ULONGLONG CJPG_ProcDlg::stuffer(DWORD data, BYTE validBits, bool isFlush){	static BYTE currPos;	static ULONGLONG currData[2];	ULONGLONG ret = (~0UI64);	if(isFlush){ //assumed that this happens when other data is invalid		currData[0] |= (~0UI64) << currPos;//pad upper end high		ret = currData[0];		currData[0] = 0;		currData[1] = 0;//should be the case already		currPos = 0;		return ret;	}  	//currData |= data << currPos;	currData[0] |= (ULONGLONG)data << currPos;//all zeros if all bits in the upper	if(currPos > 64)//all bits in the upper		currData[1] |= (ULONGLONG)data << (currPos - 64);	else if(currPos + validBits > 64)//some of the bits are in the lower		currData[1] |= (ULONGLONG)data >> (64 - currPos);	currPos += validBits;	if(currPos >=64){		ret = currData[0];		currData[0] = currData[1];		currData[1] = 0;		currPos -= 64;	}	return ret;}
 Object ( Variant Q) RegInitClr( Variant D, Variant Init
