{
 // Multiplexer
 //
 // Out of bound selections output zero.
 //
 // INPUTS:
 // Variant A: The first input to select between.
 // Variant B: The second input to select between.  A, B, etc. must have the same dataset.
 // ...
 // Variant Sel: A number to select which input to output.  0 for A, 1 for B, etc.
 //
 // OUTPUTS:
 // Variant O:	The multiplexed output.  Has the same dataset as input A.
 //
 // Updated July 2004
 //
 // Revision 1
 //_ Object Prototypes
