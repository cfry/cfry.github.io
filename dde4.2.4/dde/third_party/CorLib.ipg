Object ( Variant OFL, Variant Sign, Variant Unsigned
    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) FromTwos
    ( Variant TwosComp, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Advanced"
{
 // Converts a twos complement value into a sign and magnitude.  The Unsigned output (its magnitude) is the same dataset as the TwosComp input.  A List input will produce List outputs.
 //
 // Inputs:
 //
 // Var/List TwosComp: The input value to be interpreted as a twos complement number.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected.
 //
 // Bit Go: Go
 //
 // Bit Wait: Wait. Has a value of 0 if disconnected.  Holds off Dones.
 //
 // Outputs:
 //
 // Bit/List OFL Goes high if the input was the maximum negative value.  This is the same bit as the high bit of the Unsigned (magnitude) output.  If you use the entire Unsigned output and don't throw away the high bit, this OFL output is unnecessary.
 //
 // Bit/List Sign High if the twos complement input was negative, low if positive.  This value is the same as the high bit of the twos complement input.
 //
 // Var/List Unsigned: The magnitude of the twos complement input.  If you want to consider converting from the maximum negative input value an overflow condition, then you can drop the high bit of this output and use the OFL output for detection.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Asynchronous clear input pass through
 //
 // Bit Done: Done.  Data valid while Done is high.
 //
 // Bit Busy: Busy.  Hold off Gos.
 //
 // Dataset Coverage:
 //
 // The TwosComp input can be one of the following dataset: MSBxxx, LSBxxx, BINxxx, Signed, Fixed or List.  For the Signed and Fixed datasets, the output datasets are maintained but the Unsigned output is the absolute value of the TwosComp input.
 //
 // Examples:
 //
 // TwosComp	OFL	Sign	Unsigned
 // 000 (0)		0	0	000 (0)
 // 001 (1)		0	0	001 (1)
 // 010 (2)		0	0	010 (2)
 // 011 (3)		0	0	011 (3)
 // 100 (-4)		1	1	100 (4)
 // 101 (-3)		0	1	011 (3)
 // 110 (-2)		0	1	010 (2)
 // 111 (-1)		0	1	001 (1)
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant TwosComp) Input;  //_GUI 48,26
 Object ( Bit ClkG) Input:A;  //_GUI 48,29
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 48,32
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:C;  //_GUI 48,44
 Object ( Bit Wait) Input:D;  //_GUI 74,56
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 81,26
 Object Output:A( Variant Sign) ;  //_GUI 81,29
 Object Output:B( Variant Unsigned) ;  //_GUI 81,32
 Object Output:C( Bit ClkG) ;  //_GUI 81,38
 Object Output:D( Bit AClr) ;  //_GUI 81,41
 Object Output:E( Bit Done) ;  //_GUI 81,44
 Object Output:F( Bit Busy) ;  //_GUI 54,52
 Object ( Variant OFL, Variant Sign, Variant Unsigned
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) FromTwos_Pipe( Variant TwosComplement, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 54,25

 //_ Behavior Topology
 Output.0 = FromTwos_Pipe.0;  
 Output:A.0 = FromTwos_Pipe.1;  
 Output:B.0 = FromTwos_Pipe.2;  
 Output:C.0 = FromTwos_Pipe.4;  
 Output:D.0 = FromTwos_Pipe.5;  
 Output:E.0 = FromTwos_Pipe.6;  
 Output:F.0 = FromTwos_Pipe.7;  
 FromTwos_Pipe.0 = Input.0;  
 FromTwos_Pipe.1 = Input:A.0;  
 FromTwos_Pipe.2 = Input:B.0;  
 FromTwos_Pipe.3 = Input:C.0;  
 FromTwos_Pipe.4 = Input:D.0;  //_GUI 79,57
}

