Object ( Variant Data, Variant Iteration, Bit FirstGoRdy
    , Bit Active, Bit FinalDone, Bit ClkG, Bit AClr
    , Bit Done, Bit Busy) For( Variant Data, Variant Iterations
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced",Documentation="Var"
{
 // Produces one Done for every Go.  Uses the standard GDBW model.  Larger iterations at higher frequencies may not pass timing specifications. Counts up from 0 to (Iterations-1).
 //
 // Inputs:
 //
 // Variant Data:  Data input associated with the Go.  Any dataset should work here.
 //
 // Variant/List  Iterations: This value indicates the number of iterations of Goes/Dones that are consumed/produced when a FinalDone is output.  This value is only read in on the first Go then is ignored for the rest of the Go iterations after which it will be read in again on the next Go. A Go with an Iterations value of 0 has undefined behavior. Iterations can be a list which yields nested for loops, each loop with its own Iteration, FirstGoRdy, FinalDone and Done.  The least significant element in Iterations is the inner loop.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous Clear has a value of 0 if disconnected.
 //
 // Bit Go: Go of the GDBW protocol.  Must drop if Busy goes high.
 //
 // Bit Wait: Wait or the GDBW protocol. Has a value of 0 if disconnected.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant Data: data output associated with the Done.  This data holds its value until the next Done.
 //
 // Variant/List  Iteration: Outputs the current iteration it is on.  Goes from 0 to Iterations-1.  Undefined while not Active.
 //
 // Bit/List FirstGoRdy: High when ready to accept a new Iterations and a new first Go, unless Busy.
 //
 // Bit Active: Remains high after the iterations start (after the first Go) and remains high until FinalDone has completed.
 //
 // Bit/List Final Done: Is high on the last Done iteration.
 //
 // Bit ClkG: Connected to the ClkG input.
 //
 // Bit AClr: Connected to the AClr input.
 //
 // Bit/List Done: Done of GDBW protocol.  One Done for each Go.
 //
 // Bit Busy: Busy of the GDBW protocol.  Tells the Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx, BINxxx and List
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 10,19
 Object ( Variant Iterations) Input:A;  //_GUI 10,22
 Object ( Bit ClkG) Input:B;  //_GUI 10,28
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 10,31
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:D;  //_GUI 10,60
 Object ( Bit Wait) Input:E;  //_GUI 102,66
 //_ Attributes Constant="0"
 Object Output( Variant Data) ;  //_GUI 103,19
 Object Output:A( Variant Iteration) ;  //_GUI 103,22
 Object Output:B( Bit FirstGoRdy) ;  //_GUI 103,25
 Object Output:C( Bit Active) ;  //_GUI 103,28
 Object Output:D( Bit FinalDone) ;  //_GUI 103,34
 Object Output:E( Bit ClkG) ;  //_GUI 103,54
 Object Output:F( Bit AClr) ;  //_GUI 103,57
 Object Output:G( Bit Done) ;  //_GUI 103,60
 Object Output:H( Bit Busy) ;  //_GUI 12,67
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 20,60
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 46,28
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 43,31
 Object ( Variant Iteration, Bit FirstGoBusy, Bit Active
    , Bit Done, Bit Busy) GoForN_Up( Variant Iterations, Bit IsFirstGo
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) ;  //_GUI 55,21
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 79,23
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 31,33
 Object ( Bit Out) INVERT:A( Bit In1) ;  //_GUI 19,32
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 90,25
 Object ( Variant Q, Bit ClkG, Bit AClr
    , Bit Done, Bit Busy) RegOnGo( Variant D, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) ;  //_GUI 61,50
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:D
    ( Bit In2) ;  //_GUI 81,63
 Object Text;  //_GUI 26,41,If the Reg is not Busy and Go then we Go
 Object Text;  //_GUI 55,41,GoForN will always be Busy when RegOnGo is Busy
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:E
    ( Bit In2) ;  //_GUI 16,63

 //_ Behavior Topology
 Output.0 = RegOnGo.0;  //_GUI 95,20, 95,52
 Output:A.0 = GoForN_Up.0;  
 Output:B.0 = Junction:C.1;  
 Output:C.0 = GoForN_Up.2;  
 Output:D.0 = GoForN_Up.3;  
 Output:E.0 = RegOnGo.1;  
 Output:F.0 = RegOnGo.2;  
 Output:G.0 = RegOnGo.3;  
 Output:H.0 = Junction:E.0;  //_GUI 11,68, 11,64
 Junction.0 = Input:D.0;  
 Junction:A.0 = Input:B.0;  
 Junction:B.0 = Input:C.0;  
 GoForN_Up.0 = Input:A.0;  
 GoForN_Up.1 = Junction:C.0;  //_GUI 53,26, 53,15, 91,15
 GoForN_Up.2 = Junction:A.1;  
 GoForN_Up.3 = Junction:B.1;  
 GoForN_Up.4 = AND.0;  //_GUI 53,35, 53,36
 GoForN_Up.5 = Junction:D.1;  //_GUI 82,38
 INVERT.0 = GoForN_Up.1;  
 AND.0 = INVERT:A.0;  
 AND.1 = Junction.0;  //_GUI 21,38
 INVERT:A.0 = Junction:E.1;  //_GUI 17,35
 Junction:C.0 = INVERT.0;  
 RegOnGo.0 = Input.0;  //_GUI 50,52, 50,20
 RegOnGo.1 = Junction:A.2;  //_GUI 47,55
 RegOnGo.2 = Junction:B.2;  //_GUI 44,58
 RegOnGo.3 = Junction.1;  
 RegOnGo.4 = Junction:D.0;  
 Junction:D.0 = Input:E.0;  //_GUI 108,64, 108,67
 Junction:E.0 = RegOnGo.4;  
}

