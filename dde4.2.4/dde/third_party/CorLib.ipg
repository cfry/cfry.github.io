Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) Sqrt( Variant N
    , Bit ClkG, Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps",Icon="SQRT"
{
 // Calculate the square root of a number.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant N: Number or a list of numbers
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go of GDBW
 //
 // Bit Wait: Wait of GBDW. Has a value of 0 if disconnected
 //
 // Outputs:
 //
 // Variant OFL: Indicates the input was a negative number or some other error.  S is undefined if OFL is high.  Either a Bit or a List of Bits.
 //
 // Variant S: Square root of N or a List of square root results.
 //
 // Bit ClkG: clock input pass through
 //
 // Bit AClr: clear input pass through
 //
 // Bit Done: Done of GDBW
 //
 // Bit/List Busy: Busy of GDBW
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned, S is half the size of N rounded up), Signed (S is approximately half the size of N), Floating, Fixed (S's whole portion is approximately half the size of N's, S's fractional portion is the same size as N's) and List (Go and Busy can either each be a bit or each be a list of bits corresponding to each element of N).  Complex is not supported.  A and B can not have mixed datasets except with respect to size or in the case of MSB, LSB and BIN.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant N) Input;  //_GUI 17,17
 Object ( Bit ClkG) Input:A;  //_GUI 17,20
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 17,23
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:C;  //_GUI 17,26
 Object ( Bit Wait) Input:D;  //_GUI 82,32
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 83,8
 Object Output:A( Variant S) ;  //_GUI 83,11
 Object Output:B( Bit ClkG) ;  //_GUI 83,20
 Object Output:C( Bit AClr) ;  //_GUI 83,23
 Object Output:D( Bit Done) ;  //_GUI 83,26
 Object Output:E( Variant Busy) ;  //_GUI 18,32
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 34,16
 //_ Attributes Documentation="List/List"
 Object ( Variant OFL, Variant S, Variant R
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) Sqrt_Pipe( Variant N, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 60,7

 //_ Behavior Topology
 Output.0 = Sqrt_Pipe.0;  
 Output:A.0 = Sqrt_Pipe.1;  
 Output:B.0 = Sqrt_Pipe.4;  
 Output:C.0 = Sqrt_Pipe.5;  
 Output:D.0 = Sqrt_Pipe.6;  
 Output:E.0 = SyncQueuePass.4;  //_GUI 18,30
 SyncQueuePass.0 = Input.0;  
 SyncQueuePass.1 = Input:A.0;  
 SyncQueuePass.2 = Input:B.0;  
 SyncQueuePass.3 = Input:C.0;  
 SyncQueuePass.4 = Sqrt_Pipe.7;  
 Sqrt_Pipe.0 = SyncQueuePass.0;  //_GUI 52,9, 52,18
