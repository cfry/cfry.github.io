Object ( Variant "A<B", Variant "A=B", Variant "A>B"
    , Bit ClkG, Bit AClr, Bit Done, Variant Busy) Compare
    ( Variant A, Variant B, Bit ClkG, Bit AClr
    , Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Comparators"
{
 // Synchronous compare operator.  Supports the GDBW protocol with synchronizing input queues.
 // (Two var, single Go, Two var two go, two list single go, two list two go, two list two list go.
 //
 // Inputs:
 //
 // Variant A: Number
 //
 // Variant B: Number
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronous clear.  If disconnected, defaults to a value of 0.
 //
 // Variant Go: The Go of GDBW
 //
 // Bit Wait: The Wait of GDBW.  Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Bit A>B: High when Val was not zero.  This result is valid while Done is high.
 //
 // Bit A=B: High when Val was zero.  This result is valid while Done is high.
 //
 // Bit A<B: High when all bits of Val were high.  This result is valid while Done is high.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: The Done in GDBW.  Outputs valid while high.
 //
 // Variant Busy: The Busy in GDBW.  Tells Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned.  For 2's complement compares use the Signed dataset), Signed, Floating (+0 == -0), Fixed, and List.  Complex is not supported.  List inputs will produce list outputs.  List can be homogeneous or heterogeneous as long as the matching element pairs have the same dataset.
 //
 // Synchronization Permutations:
 //
 // A & B		Go			Outputs (A>B, A=B, A<B)	Synchronization Explanation
 // One Variant each	Bit			One bit each		All data latched in on single Go
 // One Variant each	Pair of bits as a list		One bit each		Data latched with respective Go
 // One List each	Bit			One list each		All data latched in on single Go
 // One List each	Pair of bits as a list		One list each		Each list is latched in with its respective Go.
 // One List each	A pair of lists of bits		One list each		Each element of each list is latched in with its own corresponding Go.
 // One List each	A bit and a list paired in a list.	One list each		One list input is latched with a single bit; the other input's list elements are latched individually by the list of respective Go bits.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 7,27
 Object ( Variant B) Input:A;  //_GUI 7,30
 Object ( Bit ClkG) Input:B;  //_GUI 7,33
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 7,36
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 7,39
 Object ( Bit Wait) Input:E;  //_GUI 75,53
 //_ Attributes Constant="0"
 Object Output( Variant "A<B") ;  //_GUI 76,27
 Object Output:A( Variant "A=B") ;  //_GUI 76,30
 Object Output:B( Variant "A>B") ;  //_GUI 76,33
 Object Output:C( Bit ClkG) ;  //_GUI 76,39
 Object Output:D( Bit AClr) ;  //_GUI 76,42
 Object Output:E( Bit Done) ;  //_GUI 76,45
 Object Output:F( Variant Busy) ;  //_GUI 9,47
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 28,29
 //_ Attributes Documentation="List/List"
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 46,26
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 13,26
 Object ( Variant "A<B", Variant "A=B", Variant "A>B"
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) Compare_Pipe( Variant A, Variant B, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) ;  //_GUI 59,26

 //_ Behavior Topology
 Output.0 = Compare_Pipe.0;  
 Output:A.0 = Compare_Pipe.1;  
 Output:B.0 = Compare_Pipe.2;  
 Output:C.0 = Compare_Pipe.4;  
 Output:D.0 = Compare_Pipe.5;  
 Output:E.0 = Compare_Pipe.6;  
 Output:F.0 = SyncQueuePass.4;  //_GUI 7,48, 7,43
 SyncQueuePass.0 = ListOut.0;  //_GUI 26,31, 26,29
 SyncQueuePass.1 = Input:B.0;  
 SyncQueuePass.2 = Input:C.0;  
 SyncQueuePass.3 = Input:D.0;  
 SyncQueuePass.4 = Compare_Pipe.7;  //_GUI 51,43, 51,49
 ListIn.0 = SyncQueuePass.0;  //_GUI 45,29, 45,31
 ListOut.0 = Input:A.0;  
 ListOut.1 = Input.0;  
 Compare_Pipe.0 = ListIn.1;  
 Compare_Pipe.1 = ListIn.0;  
 Compare_Pipe.2 = SyncQueuePass.1;  
 Compare_Pipe.3 = SyncQueuePass.2;  
 Compare_Pipe.4 = SyncQueuePass.3;  //_GUI 54,46, 54,40
 Compare_Pipe.5 = Input:E.0;  //_GUI 81,49, 81,54
}

