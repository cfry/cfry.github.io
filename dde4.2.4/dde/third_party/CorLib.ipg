    ( Bit In0) ;  //_GUI 78,60
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 81,63
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 133,2
 Object Text;  //_GUI 67,93,If we're adding and the OFL goes high, we want to hold the value at infinity. If we're subtracting, and the OFL ends low, then we went under and we want to hold the value at zero. So if one or the other signal is high, we're fine. The problem occurs if both are low or both are high.
 Object ( Variant O) $Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 161,41
 //_ Attributes Documentation="Bit"
 Object ( Variant Out1) AND( Variant In1, Variant In2) ;  //_GUI 139,36
 Object ( Variant Out1) OR( Variant In1, Variant In2) ;  //_GUI 139,43
