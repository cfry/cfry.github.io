Object ( Variant Out1) Superset( Variant Data, Variant Mask) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\Bits"
{
 // Maps Data into a set of enabled Mask bits, least significant bits first.  The disabled mask bits and unused enabled mask bits will output a constant zero.
 //
 // Inputs:
 //
 // Variant Data: Data bits are mapped to the output using only the bits that are enabled in the input Mask.
 //
 // Variant Mask: A constant value Mask with the enabled bits indicating which bits are used to map the Data bits into.  A Trap error is produced if there are less enabled Mask bits than Data bits.
 //
 // Outputs:
 //
 // Variant output: Outputs the Data that has been mapped to the enabled bits of the Mask.  The disabled Mask bits are zero in the output.  Any unused enabled Mask bits are set to zero.  The output dataset is the same as the Mask dataset.
 //
 // Examples:
 // Data	Mask	Output
 // 0011	1010101	0000101
 // 111	1010101	0010101
 // 01110	1010101	1010100 - Error: more data bits than enabled mask bits.
 //
 // Revison 1 - 11/07/05 New object.
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 13,17
 Object ( Variant Mask) Input:A;  //_GUI 13,20
 Object Output( Variant Out1) ;  //_GUI 48,16
 Object ( Variant Out1) $Superset( Variant Data, Variant Mask) ;  //_GUI 23,16
 //_ Attributes Documentation="var/var"
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 36,14
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 19,20

 //_ Behavior Topology
 Output.0 = Context.0;  
 $Superset.0 = Input.0;  
 $Superset.1 = Junction.1;  
 Context.0 = Junction.0;  //_GUI 36,12, 20,12
 Context.1 = $Superset.0;  
 Junction.0 = Input:A.0;  
}

