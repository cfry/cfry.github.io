Object ( Variant OFL, Variant Q, Variant R
    , Bit ClkG, Bit AClr, Bit Done, Variant Busy) DivMod
    ( Variant N, Variant D, Bit ClkG, Bit AClr
    , Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Advanced",Icon="DIV"
{
 // Synchronously divides N by D and produces a whole number quotient and a remainder.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant N: Dividend or Numerator
 //
 // Variant D: Divisor or Denominator
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Variant Go: Go of GDBW.  Can be a Bit or can be a pair of items in a list.  The items can either be a bit or else a list of bit structures that match the list structures of the corresponding A or B inputs.  Each Go bit latches in corresponding data.
 //
 // Bit Wait: Wait. Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant OFL: Overflow or Error.  List if N or D are Lists, otherwise Bit.
 //
 // Variant Q: Quotent
 //
 // Variant R : Remainder or Modulous result
 //
 // Bit ClkG: clock input pass through
 //
 // Bit AClr: clear input pass through
 //
 // Bit Done: Done or GDBW
 //
 // Variant Busy: Busy of GDBW.  Matches dataset of Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (interpreted as unsigned numbers, Q and R are the same dataset as the symmetrized N and D inputs), Signed (Q and R are the same dataset as the symmetrized N and D inputs), Fixed (Q is a Signed dataset with a size equal to the number of bits of the symmetrized N and D inputs, R is the same dataset as the symmetrized N and D inputs), and one or two Lists.  Floating and Complex are not supported.  A and B can not have mixed datasets except with respect to size (produces a warning) or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant N) Input;  //_GUI 9,19
 Object ( Variant D) Input:A;  //_GUI 9,22
 Object ( Bit ClkG) Input:B;  //_GUI 9,27
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 9,30
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 9,33
 Object ( Bit Wait) Input:E;  //_GUI 86,39
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 87,15
 Object Output:A( Variant Q) ;  //_GUI 87,18
 Object Output:B( Variant R) ;  //_GUI 87,21
 Object Output:C( Bit ClkG) ;  //_GUI 87,27
 Object Output:D( Bit AClr) ;  //_GUI 87,30
 Object Output:E( Bit Done) ;  //_GUI 87,33
 Object Output:F( Variant Busy) ;  //_GUI 10,39
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 16,18
 Object ( Variant OFL, Variant Q, Variant R
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) DivMod_Pipe( Variant A, Variant B, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) ;  //_GUI 64,14
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 50,14
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 31,23
 //_ Attributes Documentation="List/List"

 //_ Behavior Topology
 Output.0 = DivMod_Pipe.0;  
 Output:A.0 = DivMod_Pipe.1;  
 Output:B.0 = DivMod_Pipe.2;  
 Output:C.0 = DivMod_Pipe.4;  
 Output:D.0 = DivMod_Pipe.5;  
 Output:E.0 = DivMod_Pipe.6;  
 Output:F.0 = SyncQueuePass.4;  //_GUI 10,37
 ListOut.0 = Input:A.0;  
 ListOut.1 = Input.0;  
 DivMod_Pipe.0 = ListIn.1;  
 DivMod_Pipe.1 = ListIn.0;  
 DivMod_Pipe.2 = SyncQueuePass.1;  //_GUI 58,22, 58,28
 DivMod_Pipe.3 = SyncQueuePass.2;  //_GUI 61,25, 61,31
 DivMod_Pipe.4 = SyncQueuePass.3;  
 DivMod_Pipe.5 = Input:E.0;  //_GUI 90,37
 ListIn.0 = SyncQueuePass.0;  //_GUI 48,17, 48,25
 SyncQueuePass.0 = ListOut.0;  //_GUI 29,25, 29,21
 SyncQueuePass.1 = Input:B.0;  
 SyncQueuePass.2 = Input:C.0;  
 SyncQueuePass.3 = Input:D.0;  
 SyncQueuePass.4 = DivMod_Pipe.7;  
}

