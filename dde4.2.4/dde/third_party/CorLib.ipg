 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 31,26
 Object ( Variant Out1, Variant Out2) ListIn:A( List In) ;  //_GUI 31,35

 //_ Behavior Topology
 Output.0 = ListOut.0;  
 NegateEn.0 = ListIn.1;  
 NegateEn.1 = ListIn:A.1;  //_GUI 50,34, 42,34
 NegateEn:A.0 = ListIn.0;  //_GUI 46,37, 46,31
 NegateEn:A.1 = ListIn:A.0;  
 ListOut.0 = NegateEn:A.0;  //_GUI 63,32, 63,38
 ListOut.1 = NegateEn.0;  
 ListIn.0 = Input.0;  
 ListIn:A.0 = Input:A.0;  
}

