 Object ( Variant Out1) PushLsb( Variant In1, Variant LSB) ;  //_GUI 91,26
 //_ Attributes Documentation="ztl/var"
 Object ( Variant "LsbOutIsLsbIn+1", Variant LsbOutIsLsbIn) $EveryOtherB( Variant In1) ;  //_GUI 72,23
