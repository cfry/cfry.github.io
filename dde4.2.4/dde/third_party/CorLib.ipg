Object ( Variant Out1) Select( Variant "#0", Variant "#1"
    , Bit S) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced"
{
 // Does a compile time select between two input paths.  Can be thought of as a compile time multiplexer. Used to be the $Select object.  The path that is not selected should get removed with sinkless removal.  Sometimes sinkless removal doesn't remove everything that was desired, so it is recommended that the Deselect object be used in conjunction with Select.
 //
 // Inputs:
 //
 // Variant #0: The input that is selected when S compiles to 0.
 //
 // Variant #1: The input that is selected when S compiles to 1.
 //
 // Bit S: This select bit must be a constant or compile will halt. A value of 0 causes the output to be connected to the #0 input and the #1 input is internally left hanging causing sinkless removal to take effect.  A value of 1 causes the output to be connected to the #1 input and the #0 input is internally left hanging causing sinkless removal to take effect.
 //
 // Outputs:
 //
 // Variant output: A pass through of the input that was selected.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant "#0") Input;  //_GUI 23,18
 Object ( Variant "#1") Input:A;  //_GUI 23,21
 Object ( Bit S) Input:B;  //_GUI 23,24
 //_ Attributes Constant="0"
 Object Output( Variant Out1) ;  //_GUI 41,19
 Object ( Variant Out) $Select( Variant "#0", Variant "#1"
    , Bit S) ;  //_GUI 29,17

 //_ Behavior Topology
 Output.0 = $Select.0;  
 $Select.0 = Input.0;  
 $Select.1 = Input:A.0;  
 $Select.2 = Input:B.0;  
}

Object ( Variant "#0", Variant "#1") Deselect( Variant In1
    , Bit S) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced"
{
 // Does a compile time deselect between two output paths.  Can be thought of as a compile time demultiplexer. Used to be the $SelectOut object.  The path that is not selected should get removed with sourceless removal.  Sometimes sourceless removal doesn't remove everything that was desired, so it is recommended that the Select object be used in conjunction with Deselect.
 //
 // Inputs:
 //
 // Variant input: The input that will become #0 or #1.
 //
 // Bit S: This select bit must be a constant or compile will halt.  A value of 0 causes the input to be connected to the #0 output and the #1 output is internally left hanging causing sourceless removal to take effect.  A value of 1 causes the input to be connected to the #1 output and the #0 output is internally left hanging causing sourceless removal to take effect.
 //
 // Outputs:
 //
 // Variant #0: A pass through of the input if S is 0, internally disconnected otherwise.
 //
 // Variant #1: A pass through of the input if S is 1, internally disconnected otherwise.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 28,19
 Object ( Bit S) Input:A;  //_GUI 28,22
 //_ Attributes Constant="0"
 Object Output( Variant "#0") ;  //_GUI 48,19
 Object Output:A( Variant "#1") ;  //_GUI 48,22
 Object ( Variant "#0", Variant "#1") $SelectOut( Variant In1
    , Bit S) ;  //_GUI 34,18

 //_ Behavior Topology
 Output.0 = $SelectOut.0;  
 Output:A.0 = $SelectOut.1;  
 $SelectOut.0 = Input.0;  
 $SelectOut.1 = Input:A.0;  
}

