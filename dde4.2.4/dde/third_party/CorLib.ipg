    , Bit ClkG, Bit AClr, Bit Done, Bit Busy) FixedToTwos_Pipe
    ( Variant Type, Fixed Data, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 45,26

 //_ Behavior Topology
 Output.0 = FixedToTwos_Pipe.0;  
 Output:A.0 = FixedToTwos_Pipe.1;  
 Output:B.0 = FixedToTwos_Pipe.3;  
 Output:C.0 = FixedToTwos_Pipe.4;  
 Output:D.0 = FixedToTwos_Pipe.5;  
 Output:E.0 = FixedToTwos_Pipe.6;  
 FixedToTwos_Pipe.0 = Input.0;  
