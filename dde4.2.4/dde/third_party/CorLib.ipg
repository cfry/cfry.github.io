Object ( Bit OFL, Variant Out1) ShiftRightBy( Variant Data
    , Variant ShiftBy) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Async",Documentation="barrel"
{
 // A barrel shifter.  Data is shifted right (towards the least significant end) by ShiftBy amount.
 //
 // ShiftRightBy instantiates a barrelshifter that can dynamically shift a data set right n bits, which are specified by the ShiftBy input.
 //
 // Since barrel shifters use large amounts of physical resources, the ShiftBy input is preprocessed, converting it into the smallest data set possible of representing the bit length of Data.  This ensures that an optimal structure is created.
 //
 // If the ShiftBy input is constant, this object simply becomes a series of SHRs, which are free.
 //
 // Inputs:
 //
 // Variant Data:The input data that will be shifted at runtime (as apposed to SHR which shifts at compile time).
 //
 // Variant ShiftBy:The amount to shift data by.
 //
 // Outputs:
 //
 // Bit OFL:Overflow (OFL) goes high when any bits shifted off the end have a high value or there is an error in the ShiftBy range.
 //
 // Variant output:The result of Data shifted right by ShiftBy.
 //
 // Date:
 // 07/30/04
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 22,24
 Object ( Variant ShiftBy) Input:A;  //_GUI 16,27
 Object Output( Bit OFL) ;  //_GUI 63,24
 Object Output:A( Variant Out1) ;  //_GUI 55,39
 Object ( Bit OFL, Bit ERNG_Data, Bit ERNG_FallOff
    , Bit Round, Variant FallOff, Variant Data) ShiftRightBy( Variant Data
    , Variant ShiftBy, Bit IsTwos) ;  //_GUI 31,23
 //_ Attributes Documentation="barrel with ranges"

 //_ Behavior Topology
 Output.0 = ShiftRightBy.0;  
 Output:A.0 = ShiftRightBy.5;  
 ShiftRightBy.0 = Input.0;  
 ShiftRightBy.1 = Input:A.0;  
}

