Object ( Variant Min, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) Min( Variant Val, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Comparators\\Advanced"
{
 // Returns the Minimum element of a list of elements
 //
 // Inputs:
 //
 // Variant Val: input list of values
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronous clear.  If disconnected, defaults to a value of 0.
 //
 // Variant Go: The Go of GDBW
 //
 // Bit Wait: The Wait of GDBW.  Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant Min: The minimum element value in the list
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: The Done in GDBW.  Outputs valid while high.
 //
 // Variant Busy: The Busy in GDBW.  Tells Go to hold off.
 //
 // Dataset Coverage:
 //
 // The list input must be homogeneous and can be composed of any one of the following datasets: MSBxxx, LSBxxx and BINxxx (unsigned.  For 2's complement compares use the Signed dataset), Signed, Floating and Fixed.
 //
 // Synchronization Permutations:
 //
 // Val	Go	Min output	Synchronization Explanation
 // Variant 	Bit	One variant	All data latched in on single Go
 // List 	Bit	List of variants	All data latched in on single Go
 // List 	List of bits	List of variants	Each element of the list is latched in with its own corresponding Go.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 13,28
 Object ( Bit ClkG) Input:A;  //_GUI 13,31
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 13,34
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:C;  //_GUI 13,37
 Object ( Bit Wait) Input:D;  //_GUI 60,48
 //_ Attributes Constant="0"
 Object Output( Variant Min) ;  //_GUI 61,28
 Object Output:A( Bit ClkG) ;  //_GUI 61,34
 Object Output:B( Bit AClr) ;  //_GUI 61,37
 Object Output:C( Bit Done) ;  //_GUI 61,40
 Object Output:D( Variant Busy) ;  //_GUI 14,51
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 20,27
 //_ Attributes Documentation="List/List"
 Object ( Variant Min, Variant PipeLen, Bit ClkG
    , Bit AClr, Bit Done, Bit Busy) Min_Pipe( Variant Val
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) ;  //_GUI 43,27

 //_ Behavior Topology
 Output.0 = Min_Pipe.0;  
 Output:A.0 = Min_Pipe.2;  
 Output:B.0 = Min_Pipe.3;  
 Output:C.0 = Min_Pipe.4;  
 Output:D.0 = SyncQueuePass.4;  //_GUI 14,41
 SyncQueuePass.0 = Input.0;  
 SyncQueuePass.1 = Input:A.0;  
 SyncQueuePass.2 = Input:B.0;  
 SyncQueuePass.3 = Input:C.0;  
 SyncQueuePass.4 = Min_Pipe.5;  //_GUI 38,41, 38,44
 Min_Pipe.0 = SyncQueuePass.0;  
 Min_Pipe.1 = SyncQueuePass.1;  
 Min_Pipe.2 = SyncQueuePass.2;  
 Min_Pipe.3 = SyncQueuePass.3;  //_GUI 41,41, 41,38
 Min_Pipe.4 = Input:D.0;  //_GUI 66,44, 66,49
}

Object ( Variant Min, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) Min( Variant Val, Variant Val
    , Bit ClkG, Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Comparators\\Advanced"
{
 // Returns the Minimum of the two input elements
 //
 // Inputs:
 //
 // Variant Val: input value
 //
 // Variant Val: input value
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronous clear.  If disconnected, defaults to a value of 0.
 //
 // Variant Go: The Go of GDBW
 //
 // Bit Wait: The Wait of GDBW.  Defaults to 0 if disconnected.
 //
 // Outputs:
 //
 // Variant Min: The minimum of the two input elements
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: The Done in GDBW.  Outputs valid while high.
 //
 // Variant Busy: The Busy in GDBW.  Tells Go to hold off.
 //
 // Dataset Coverage:
 //
 // The inputs must have the same dataset and can be of the following: MSBxxx, LSBxxx and BINxxx (unsigned.  For 2's complement compares use the Signed dataset), Signed, Floating and Fixed.  Also two input lists are supported producing an output list.  The lists can be heterogeneous as long as respective elements have the same dataset.
 //
 // Synchronization Permutations:
 //
 // Val inputs		Go			Min output	Synchronization Explanation
 // One Variant each	Bit			Variant		All data latched in on single Go
 // One Variant each	Pair of bits as a list		Variant		Data latched with respective Go
 // One List each	Bit			List 		All data latched in on single Go
 // One List each	Pair of bits as a list		List		Each list is latched in with its respective Go.
 // One List each	A pair of lists of bits		List		Each element of each list is latched in with its own corresponding Go.
 // One List each	A bit and a list paired in a list.	List		One list input is latched with a single bit; the other input's list elements are latched individually by the list of respective Go bits.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 13,25
 Object ( Variant Val) Input:A;  //_GUI 13,28
 Object ( Bit ClkG) Input:B;  //_GUI 13,31
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 13,34
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 13,37
 Object ( Bit Wait) Input:E;  //_GUI 82,45
 //_ Attributes Constant="0"
 Object Output( Variant Min) ;  //_GUI 83,25
 Object Output:A( Bit ClkG) ;  //_GUI 83,31
 Object Output:B( Bit AClr) ;  //_GUI 83,34
 Object Output:C( Bit Done) ;  //_GUI 83,37
 Object Output:D( Variant Busy) ;  //_GUI 14,51
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 33,27
 //_ Attributes Documentation="List/List"
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 52,24
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 19,24
 Object ( Variant Min, Variant PipeLen, Bit ClkG
    , Bit AClr, Bit Done, Bit Busy) Min_Pipe( Variant Val
    , Variant Val, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) ;  //_GUI 65,24

