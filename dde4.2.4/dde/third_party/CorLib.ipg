 Output.0 = TBusExpose.1;  
 TBusExpose.0 = Input.0;  
}

Object ( TBus TBus) TBuf( Variant En, Variant DrvIn) 
//_ Attributes TreeGroup="CoreLib\\Multiplexers\\Async\\Advanced\\TBuf"
{
 // A Viva implementation of a tri-state buffer.  The TBuf object is used to get data onto a tri-state bus.  Tri-state busses are connected together using the TBusJunction object.  Data is extracted from a tri-state bus using the TBusData object.
 //
 // Inputs:
 //
 // Variant En: Enables driving the tri-state bus when high.  If this input is a bit then all bits of DrvIn are enabled simultaneously with this single En bit The width of the tri-state bus is the width of DrvIn.  If En is a list of bits, DrvIn must be an equivalently sized and ordered homogeneous list of variant elements where corresponding DrvIn elements are driven by the corresponding bits in the En list.  The width of the tri-state bus is the width of a single list element of DrvIn.  Only one En bit for an entire TBus may be driven at a time.  This condition is checked with a run-time trap while simulating.
 //
 // Variant Data: The driver input data that is driven on the TBus when the En input is high.
 //
 // Outputs:
 //
 // TBus TBus: This is a tri-state bus output.  It can only be connected to a TBusJunction object's inputs or a TBusData object's input.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant En) Input;  //_GUI 9,14
 Object ( Variant DrvIn) Input:A;  //_GUI 9,23
 Object Output( TBus TBus) ;  //_GUI 62,18
 Object ( Bit In) Input:B;  //_GUI 22,35
 //_ Attributes PromoteToParentObject="False",Constant="1"
 Object Output:A( Bit Trap) ;  //_GUI 30,35
 //_ Attributes Trap="Invalid combination of input datasets.  TBuf can either have a bit and a variant as inputs (a 1 dimentional tri-state buffered bus) or a variant and a list as inputs (a two dimentional tri-state buffered bus).  If you use the variant and a list as inputs",they must be of the same order and size (example: MSB004 and a 4 element MSB ordered list of variants all of the same size).
 Object Text;  //_GUI 42,35,Invalid combination of input datasets.  TBuf can either have a bit and a variant as inputs (a 1 dimentional tri-state buffered bus) or a variant and a list as inputs (a two dimentional tri-state buffered bus).  If you use the variant and a list as inputs, they must be of the same order and size (example: MSB004 and a 4 element MSB ordered list of variants all of the same size).

 //_ Behavior Topology
 Output:A.0 = Input:B.0;  
}

