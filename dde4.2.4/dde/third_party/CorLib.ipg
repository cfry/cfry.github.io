Object ( Variant P_Data, Variant S_Type, Variant StageMsk
    , Bit LastDone, Bit Done, Bit Busy) "Serial->Parallel_Fill"( Variant S_Data
    , Variant P_Type, Bit IsLastGo, Variant FillConst, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced"
{
 // Same as Serial->Parallel_Clr except that it has the capability of automatically filling in any extra serial stages in the parallel output after IsLastGo is latched in, producing a Done and LastDone.
 //
 // Inputs:
 //
 // Bit IsLastGo: Bring high with Go on the last piece of data.  Any remaining serial stages in the parallel data are filled with FillConst.  Done and LastDone are then triggered.  If there were no remaining serial stages, a fill does not occur, but LastDone will still occur.
 //
 // Var FillConst:  The fill value placed into any remaining serial stages of the parallel output data after an IsLastGo is latched in with the final Go.
 //
 // All other inputs explained in the Serial->Parallel_Clr object.
 //
 // Outputs:
 //
 // Bit LastDone: High on the parallel cycle that had an IsLastGo on a serial input cycle.
 //
 // All other outputs explained in the Serial->Parallel_Clr object.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant S_Data) Input;  //_GUI 11,28
 Object ( Variant P_Type) Input:A;  //_GUI 11,31
 Object ( Bit IsLastGo) Input:B;  //_GUI 11,34
 //_ Attributes Constant="0"
 Object ( Variant FillConst) Input:C;  //_GUI 11,40
 Object ( Bit ClkG) Input:D;  //_GUI 11,46
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:E;  //_GUI 11,49
 //_ Attributes Constant="0"
