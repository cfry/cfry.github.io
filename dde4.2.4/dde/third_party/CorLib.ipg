//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\$Internal",Icon="MUL",Documentation="Signed"
{
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Signed A) Input;  //_GUI 17,14
 Object ( Signed B) Input:A;  //_GUI 17,17
 Object Output( Signed R) ;  //_GUI 98,15
 Object ( Variant Out1) BIN( Variant In1) ;  //_GUI 24,15
 Object ( Signed Out) SignedOut( Variant In1) ;  //_GUI 84,13
 Object ( Variant Out1) BIN:A( Variant In1) ;  //_GUI 24,12
 Object ( Variant Min, Variant Max) OrderDatasets( Variant In1
    , Variant In2) ;  //_GUI 37,13
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 71,13
 Object ( Variant R) $Mul_Twos( Variant A, Variant B) ;  //_GUI 55,13

 //_ Behavior Topology
 Output.0 = SignedOut.0;  
 BIN.0 = Input:A.0;  
 SignedOut.0 = MSB.0;  
 BIN:A.0 = Input.0;  
 OrderDatasets.0 = BIN:A.0;  
