Object ( Variant ShiftedData, Variant ShiftMask, Variant ShiftNum
    , Bit Done, Bit Busy) LeftJustify_MinHW( Variant Data, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced\\MinHW"
{
 // This object performs this action (only more efficiently):
 //
 // ShiftLeft(Data,Bitlen(Data)-MaskToNum(mostSig(Data)))
 //
 // This is the minimal harware implementation, i.e., it is not pipelined.
 //
 // Inputs:
 //
 // Variant Data: The input data that will be left justified.
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronously clears the register.  If disconnected, defaults to 0.
 //
 // Bit Go: The Go of GDBW.  Enables the latching of the input data, as long as not Busy.
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant ShiftedData: The output Data that was left justified.  Same dataset as Data.
 //
 // Variant ShiftMask: A value of 1 shifted left ShiftNum times. Same dataset as Data.
 //
 // Variant ShiftNum: The number of times Data was shifted to left-justify the data.
 //
 // Bit Done: The Done of GDBW.  Indicates valid outputs ShiftedData, ShiftMask, and ShiftNum.
 //
 // Bit Busy: The Busy of GDBW.  Holds off the Go.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 14,23
 Object ( Bit ClkG) Input:A;  //_GUI 17,64
