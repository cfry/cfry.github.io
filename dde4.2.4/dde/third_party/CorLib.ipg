    ( Bit In0) ;  //_GUI 29,36
 Object ( Variant Out1) AND( Variant In1, Variant In2
    , Variant In3) ;  //_GUI 72,43
 Object Text;  //_GUI 38,55,Leave the state if we are in state, requested to leave and not requested to enter.
 Object Text;  //_GUI 5,22,Enter has priority over leave
