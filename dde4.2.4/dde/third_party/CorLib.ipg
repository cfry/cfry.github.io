Object ( Variant Sign, Variant Abs) Abs( Variant Val) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async"
{
 // Asynchronous absolute value of a number.
 //
 // For Signed and Fixed datasets, rather than reporting an error if a maximum negative number is input (because its positive representation takes one more bit) the result is forced to the maximum positive number.  If this is not the desired behavior but you wish to be informed of an overflow, use the FromTwos object instead.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Var/List Val: Number
 //
 // Outputs:
 //
 // Bit/List Sign: Indicates sign of Val.  Asserted if negative.
 //
 // Var/List Abs: Absolute value of Val
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (assume unsigned, pass through), Signed, Floating, Fixed and List (produces list outputs).  This object does not support the Complex dataset.  To take the absolute value of MSBxxx, LSBxxx and BINxxx datasets interpreted as twos complement numbers, use the AbsTwos object.
 //
 // Examples: (expand dialog box to see alligned table)
 //
 // Signed Val	Sign	Abs		Unsigned Val	Sign	Abs
 // 000 (0)		0	000 (0)		000 (0)		0	000 (0)
 // 001 (1)		0	001 (1)		001 (1)		0	001 (1)
 // 010 (2)		0	010 (2)		010 (2)		0	010 (2)
 // 011 (3)		0	011 (3)		011 (3)		0	011 (3)
 // 100 (-4)		1	011 (3)		100 (4)		0	100 (4)
 // 101 (-3)		1	011 (3)		101 (5)		0	101 (5)
 // 110 (-2)		1	010 (2)		110 (6)		0	110 (6)
 // 111 (-1)		1	001 (1)		111 (7)		0	111 (7)
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 16,36
 Object Output( Variant Sign) ;  //_GUI 30,29
 Object Output:A( Variant Abs) ;  //_GUI 30,36
 Object Text;  //_GUI 13,44,The default case is unsigned.  An unsigned value is already positive, so do nothing.
 Object ( Bit In) Input:A;  //_GUI 24,29
 //_ Attributes PromoteToParentObject="False",Constant="0"

 //_ Behavior Topology
 Output.0 = Input:A.0;  
 Output:A.0 = Input.0;  
}

