Object ( Variant Out1) XOR-List( Variant In1) 
//_ Attributes TreeGroup="CoreLib\\Gates\\Async\\Advanced"
{
 // Takes a list of values and XORs them together.  The list input must be homogeneous with the exception of elements of type Bit that XORes all bits with 1.  The output dataset is that of a homogeneous element.  The homogeneous elements are XORed together then the entire output is XORed by any high Bit inputs.
 //
 // Inputs:
 //
 // Variant input: A homogeneous list with the exception of Bit elements.  The homogeneous list elements do not necessarily need to have the same dataset, but must all have the same number of bits.
 //
 // Outputs:
 //
 // Variant output: The homogeneous elements are XORed together then the entire output is XORed high by any high Bit inputs.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 12,31
 Object Output( Variant Out1) ;  //_GUI 32,31
 Object Text;  //_GUI 10,37,A single element list XORed with all other elements (none) is the original element.

 //_ Behavior Topology
 Output.0 = Input.0;  
}

