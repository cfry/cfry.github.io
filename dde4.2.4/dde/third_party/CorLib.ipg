 OR:A.0 = Junction.1;  
 OR:A.1 = AND:D.0;  //_GUI 168,87, 168,122
 AND:E.0 = Junction:C.0;  //_GUI 126,38
 AND:E.1 = OR:B.0;  //_GUI 139,41, 139,54, 165,54, 165,66
 OR:B.0 = INVERT:C.0;  
 OR:B.1 = Junction:E.1;  
 INVERT:C.0 = Junction:L.2;  
 Junction:L.0 = Junction:B.0;  
 State.0 = Junction:A.2;  //_GUI 54,46
 State.1 = Junction:L.1;  //_GUI 33,49
 State.2 = Junction:G.1;  
 State.3 = Junction:H.0;  //_GUI 36,55
 State:A.0 = AND:C.0;  
