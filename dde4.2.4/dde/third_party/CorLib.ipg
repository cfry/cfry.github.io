Object ( Bit DQ) StickyPass( Bit D, Bit ClkG
    , Bit SCLR) 
//_ Attributes TreeGroup="CoreLib\\Registers\\Advanced"
{
 // Passes a One through asynchronously and then also stickys it high until it is synchronously cleared.
 //
 // Inputs:
 //
 // Bit D:	The data bit to be passed and stickied.
 //
 // Bit ClkG:	The input clock.  If disconnected, defaults to the ClkG, the global user clock signal.
 //
 // Bit SCLR:	A synchronous clear.  If disconnected, defaults to 0.
 //
 // Outputs:
 //
 // Bit DQ:	The pass through data or the stickied data.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit D) Input;  //_GUI 12,13
 Object ( Bit ClkG) Input:A;  //_GUI 12,16
 //_ Attributes Resource="Global"
 Object ( Bit SCLR) Input:B;  //_GUI 12,19
 //_ Attributes Constant="0"
 Object Output( Bit DQ) ;  //_GUI 54,12
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 41,10
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 20,13
 Object ( Variant Q) StickyRegSync( Variant D, Bit ClkG
    , Variant SCLR) ;  //_GUI 24,12

 //_ Behavior Topology
 Output.0 = OR.0;  
 OR.0 = Junction.0;  //_GUI 41,10, 21,10
 OR.1 = StickyRegSync.0;  
 Junction.0 = Input.0;  
 StickyRegSync.0 = Junction.1;  
 StickyRegSync.1 = Input:A.0;  
 StickyRegSync.2 = Input:B.0;  
}

