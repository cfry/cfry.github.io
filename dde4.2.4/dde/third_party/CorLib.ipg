Object ( Variant NotZero, Variant IsZero, Variant AllHigh
    , Bit ClkG, Bit AClr, Bit Done, Variant Busy) CompareUnary
    ( Variant Val, Bit ClkG, Bit AClr, Variant Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Comparators"
{
 // Synchronous unary comparison operator.  Supports the GDBW protocol.
 //
 // Inputs:
 //
 // Variant Val: Operand for logical comparisons
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronous clear. If disconnected, defaults to a value of 0.
 //
 // Variant Go: The Go of GDBW (list only if need to synchronize list inputs)
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.
 //
 // Outputs:
 //
 // Bit NotZero: High when Val was not zero.  This result is valid while Done is high.
 //
 // Bit IsZero: High when Val was zero.  This result is valid while Done is high.
 //
 // Bit AllHigh: High when all bits of Val were high.  This result is valid while Done is high.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: The Done in GDBW.  NotZero, IsZero and AllHigh valid while high.
 //
 // Variant Busy: The Busy in GDBW.  Tells Done to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (signed or unsigned.), Signed, Floating (+0 or -0), Fixed, List and Complex.
 //
 // Synchronization Permutations:
 //
 // Val	Go		Outputs (NotZero, IsZero, AllHigh)	Synchronization Explanation
 // Variant 	Bit		One bit each			All data latched in on single Go
 // List 	Bit		One list each			All data latched in on single Go
 // List 	A list of bits	One list each			Each element of the list is latched in with its own corresponding Go.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 13,28
 Object ( Bit ClkG) Input:A;  //_GUI 13,31
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 13,34
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:C;  //_GUI 13,37
 Object ( Bit Wait) Input:D;  //_GUI 67,54
 //_ Attributes Constant="0"
 Object Output( Variant NotZero) ;  //_GUI 68,28
 Object Output:A( Variant IsZero) ;  //_GUI 68,31
 Object Output:B( Variant AllHigh) ;  //_GUI 68,34
 Object Output:C( Bit ClkG) ;  //_GUI 68,40
 Object Output:D( Bit AClr) ;  //_GUI 68,43
 Object Output:E( Bit Done) ;  //_GUI 68,46
 Object Output:F( Variant Busy) ;  //_GUI 14,51
 Object ( Variant Data, Bit ClkG, Bit AClr
    , Bit Done, Variant Busy) SyncQueuePass( Variant Data, Bit ClkG
    , Bit AClr, Variant Go, Bit Wait) ;  //_GUI 20,27
 //_ Attributes Documentation="List/List"
 Object ( Variant NotZero, Variant IsZero, Variant AllHigh
    , Variant PipeLen, Bit ClkG, Bit AClr, Bit Done
    , Bit Busy) CompareUnary_Pipe( Variant Val, Bit ClkG, Bit AClr
    , Bit Go, Bit Wait) ;  //_GUI 43,27

 //_ Behavior Topology
 Output.0 = CompareUnary_Pipe.0;  
 Output:A.0 = CompareUnary_Pipe.1;  
 Output:B.0 = CompareUnary_Pipe.2;  
 Output:C.0 = CompareUnary_Pipe.4;  
 Output:D.0 = CompareUnary_Pipe.5;  
 Output:E.0 = CompareUnary_Pipe.6;  
 Output:F.0 = SyncQueuePass.4;  //_GUI 14,41
 SyncQueuePass.0 = Input.0;  
 SyncQueuePass.1 = Input:A.0;  
 SyncQueuePass.2 = Input:B.0;  
 SyncQueuePass.3 = Input:C.0;  
 SyncQueuePass.4 = CompareUnary_Pipe.7;  //_GUI 38,41, 38,50
 CompareUnary_Pipe.0 = SyncQueuePass.0;  
 CompareUnary_Pipe.1 = SyncQueuePass.1;  
 CompareUnary_Pipe.2 = SyncQueuePass.2;  
 CompareUnary_Pipe.3 = SyncQueuePass.3;  //_GUI 41,47, 41,38
 CompareUnary_Pipe.4 = Input:D.0;  //_GUI 73,50, 73,55
}

