Object ( List OFL, List TwosComp) ToTwos( List Sign
    , Variant Unsigned) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Async\\Advanced",Documentation="list"
{
 // Converts a sign and magnitude into a twos complement value.  The TwosComplement output is the same dataset as the Unsigned input.  A List input will produce List outputs.  This object is asynchronous and may have difficulty meeting timing specifications with large datasets and/or faster frequencies.
 //
 // Inputs:
 //
 // Var/List Unsigned: An MSBxxx, Lsbxxx, or BINxxx dataset to be converted to a twos complement number along with the specified Sign input.  This input can also be considered the magnitude of the value.
 //
 // Bit/List Sign High if the input is to be converted to a negative twos complement output value.  Low if the input is to be converted to a positive twos complement output value.  This value is the same as the high bit of the twos complement input.
 //
 // Outputs:
 //
 // Bit/List OFL Goes high if the input had its high bit set.  This value is the same as the high bit of the Unsigned (magnitude) input.  If the high bit of the Unsigned input is always zero, this OFL output is unnecessary.
 //
 // Var/List TwosComp: The combination of the Unsigned input (the magnitude) with the Sign input resulting in a twos complement representation of the value.
 //
 // Examples:
 //
 // Sign	Unsigned	TwosComp	OFL
 // 0	000 (0)	000 (0)		0
 // 0	001 (1)	001 (1)		0
 // 0	010 (2)	010 (2)		0
 // 0	011 (3)	011 (3)		0
 // 0	1XX	???		1
 // 1	000 (0)	000 (0)		0
 // 1	001 (1)	111 (-1)		0
 // 1	010 (2)	110 (-2)		0
 // 1	011 (3)	101 (-3)		0
 // 1	1XX	???		1
 //
 // Revision 1
 //_ Object Prototypes
 Object ( List Sign) Input;  //_GUI 16,29
 Object ( Variant Unsigned) Input:A;  //_GUI 16,39
 Object Output( List OFL) ;  //_GUI 75,29
 Object Output:A( List TwosComp) ;  //_GUI 75,39
 Object ( Variant Out1, Variant Out2) ListIn( List In) ;  //_GUI 22,37
 Object ( List Out) ListOut( Variant In1, Variant In2) ;  //_GUI 62,37
 Object ( Variant Out1, Variant Out2) ListIn:A( List In) ;  //_GUI 22,27
 Object ( List Out) ListOut:A( Variant In1, Variant In2) ;  //_GUI 62,27
 Object ( Variant OFL, Variant TwosComp) ToTwos( Variant Sign
    , Variant Unsigned) ;  //_GUI 39,17
 Object ( Variant OFL, Variant TwosComp) ToTwos:A( Variant Sign
    , Variant Unsigned) ;  //_GUI 36,49

 //_ Behavior Topology
 Output.0 = ListOut:A.0;  
 Output:A.0 = ListOut.0;  
 ListIn.0 = Input:A.0;  
 ListOut.0 = ToTwos:A.1;  //_GUI 62,54
 ListOut.1 = ToTwos.1;  //_GUI 59,39
 ListIn:A.0 = Input.0;  
 ListOut:A.0 = ToTwos:A.0;  //_GUI 56,32
 ListOut:A.1 = ToTwos.0;  //_GUI 62,19
 ToTwos.0 = ListIn:A.1;  //_GUI 33,19
 ToTwos.1 = ListIn.1;  //_GUI 39,39
 ToTwos:A.0 = ListIn:A.0;  //_GUI 36,32
 ToTwos:A.1 = ListIn.0;  //_GUI 33,54
}

