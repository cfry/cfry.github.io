Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) Sub( Variant A
    , Variant B, Bit ClkG, Bit AClr, Variant Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps"
{
 // Synchronous subtraction.  GDBW behavior with synchronizing input queues.
 //
 // Inputs:
 //
 // Variant A: Number
 //
 // Variant B: Number
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go of GDBW.  Can be a Bit if A and B don't need to be synchronized.  Can be a pair of bits in a list if A needs to be synchronized with B.  Can be a pair of lists in a list if the elements of a list for A need to be individually synchronized against the elements of a list for B.
 //
 // Bit Wait: Wait of GDBW.  If disconnected, defaults to 0.
 //
 // Outputs
 //
 // Bit/List OFL: Overflow.  Indicates there was an overflow.  A list if A and/or B are lists, or a Bit otherwise
 //
 // Var/List S: Result of A minus B.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done
 //
 // Bit/List Busy: Busy of GDBW.  Same dataset as Go.  One busy for each respective Go.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (unsigned), Signed, Floating, Fixed, List and Complex (real and imaginary OFLs ORed). A and B pairs must have the same dataset (with the exception of MSBxxx, LSBxxx and BINxxx) or undefinded behavior will occur.  If A and B pairs don't have the same bit length, the pairs are symmetrized and a warning is generated.  If one of A or B is a list and the other is not, the other is duplicated into a list matching one's and the subtraction on respective list elements is performed.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant A) Input;  //_GUI 30,14
 Object ( Variant B) Input:A;  //_GUI 30,17
 Object ( Bit ClkG) Input:B;  //_GUI 30,23
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:C;  //_GUI 30,26
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:D;  //_GUI 30,29
 Object ( Bit Wait) Input:E;  //_GUI 49,42
 //_ Attributes Constant="0"
 Object Output( Variant OFL) ;  //_GUI 55,14
 Object Output:A( Variant S) ;  //_GUI 55,17
 Object Output:B( Bit ClkG) ;  //_GUI 55,20
 Object Output:C( Bit AClr) ;  //_GUI 55,23
 Object Output:D( Bit Done) ;  //_GUI 55,29
 Object Output:E( Variant Busy) ;  //_GUI 31,35
 Object ( Bit Sub) Input:F;  //_GUI 36,20
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Variant OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) AddSub( Variant A
    , Variant B, Variant Add, Bit ClkG, Bit AClr
    , Variant Go, Bit Wait) ;  //_GUI 42,13
 //_ Attributes Documentation="Var Add"

 //_ Behavior Topology
 Output.0 = AddSub.0;  
 Output:A.0 = AddSub.1;  
 Output:B.0 = AddSub.2;  
 Output:C.0 = AddSub.3;  
 Output:D.0 = AddSub.4;  
 Output:E.0 = AddSub.5;  //_GUI 31,33
 AddSub.0 = Input.0;  
 AddSub.1 = Input:A.0;  
 AddSub.2 = Input:F.0;  
 AddSub.3 = Input:B.0;  
 AddSub.4 = Input:C.0;  
 AddSub.5 = Input:D.0;  
 AddSub.6 = Input:E.0;  
}

Object ( Bit OFL, Variant S, Bit ClkG
    , Bit AClr, Bit Done, Variant Busy) Sum( Variant List
    , Bit ClkG, Bit AClr, Variant Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Advanced"
{
 // Synchronous summation tree.
 //
 // Inputs:
 //
 // Variant List: A list of values to be added together.  All list elements must be of the same dataset (with the exception of MSBxxx, LSBxxx or BINxxx) or unexpected behavior may result.  All list elements must be of the same size or the inputs will be symmetrized and a warning will be generated.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous clear.  Has a value of 0 if disconnected
 //
 // Bit/List Go: Go (List of Gos if elements of List need to be synchronized)
 //
 // Bit Wait: Wait of GDBW.  If disconnected, has value of 0.
 //
 // Outputs:
 //
 // Bit OFL: Indicates there was an overflow on any one of the adders in the adder tree.
 //
 // Variant S: The result of the summation.
 //
 // Bit ClkG: Clock input pass through
 //
 // Bit AClr: Clear input pass through
 //
 // Bit Done: Done of GDBW
 //
 // Bit/List Busy: Busy of GDBW.  Same dataset as Go.  One busy for each respective Go.
 //
 // Dataset Coverage:
 //
 // A List of MSBxxx, LSBxxx and BINxxx (unsigned), Signed, Fixed, Floating, Complex.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant List) Input;  //_GUI 9,20
 Object ( Bit ClkG) Input:A;  //_GUI 9,23
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 9,26
 //_ Attributes Constant="0"
 Object ( Variant Go) Input:C;  //_GUI 9,29
 Object ( Bit Wait) Input:D;  //_GUI 66,35
