Object ( Variant Data, Variant Iteration, Variant FirstGoRdy
    , Bit Active, Variant FinalDone, Variant Done, Bit Busy) For
    ( Variant Data, Variant Iterations, Bit Start, Bit ClkG
    , Bit AClr, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // Produces one Done for every Go.  Uses the standard GDBW model.  Larger iterations at higher frequencies may not pass timing specifications. Counts up from 0 to (Iterations-1).  Will be busy and will not accept Goes until Start is pulsed high.  This object is useful to halt the flow of data until you know how much you want to pass through.
 //
 // Inputs:
 //
 // Variant Data:  Data input associated with the Go.  Any dataset should work here.
 //
 // Bit Start: Allows for the first Go to be read in unless Busy otherwise Busy will stay high.  You must pulse Start before every first Go.
 //
 // Variant/List  Iterations: This value indicates the number of iterations of Goes/Dones that are consumed / produced when a FinalDone is output.  This value is only read in on the first Go then is ignored for the rest of the Go iterations after which it will be read in again on the next Go after a Start pulse. A Go with an Iterations value of 0 has undefined behavior.  Iterations can be a list which yields nested for loops, each loop with its own Iteration, FirstGoRdy, FinalDone and Done.  The least significant element in Iterations is the inner loop.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit AClr: Asynchronous Clear has a value of 0 if disconnected.
 //
 // Bit Go: Go of the GDBW protocol.  Must drop if Busy goes high.
 //
 // Bit Wait: Wait of the GDBW protocol. Has a value of 0 if disconnected.  Holds off the Done.
 //
 // Outputs:
 //
 // Variant Data: data output associated with the Done.  This data holds its value until the next Done.
 //
 // Variant/List  Iteration: Outputs the current iteration it is on.  Goes from 0 to Iterations-1.  Undefined while not Active.
 //
 // Bit/List FirstGoRdy: High when ready to accept a new Iterations and a new first Go, unless Busy.
 //
 // Bit Active: Remains high after the iterations start (after the first Go) and remains high until FinalDone has completed.
 //
 // Bit/List Final Done: Is high on the last Done iteration.
 //
 // Bit/List Done: Done of GDBW protocol.  One Done for each Go.
 //
 // Bit Busy: Busy of the GDBW protocol.  Tells the Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx, BINxxx and List
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 11,16
 Object ( Variant Iterations) Input:A;  //_GUI 11,19
 Object ( Bit Start) Input:B;  //_GUI 11,22
 Object ( Bit ClkG) Input:C;  //_GUI 11,25
 Object ( Bit AClr) Input:D;  //_GUI 11,28
 Object ( Bit Go) Input:E;  //_GUI 11,43
 Object ( Bit Wait) Input:F;  //_GUI 88,47
 Object Output( Variant Data) ;  //_GUI 89,19
 Object Output:A( Variant Iteration) ;  //_GUI 89,22
 Object Output:B( Variant FirstGoRdy) ;  //_GUI 89,25
 Object Output:C( Bit Active) ;  //_GUI 89,28
 Object Output:D( Variant FinalDone) ;  //_GUI 89,31
 Object Output:E( Variant Done) ;  //_GUI 89,40
 Object Output:F( Bit Busy) ;  //_GUI 13,50
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 20,25
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 82,25
 Object ( Variant Data, Variant Iteration, Variant FirstGoRdy
    , Bit Active, Variant FinalDone, Bit ClkG, Bit AClr
    , Variant Done, Bit Busy) For( Variant Data, Variant Iterations
    , Bit ClkG, Bit AClr, Bit Go, Bit Wait) ;  //_GUI 58,18
 Object ( Bit Done, Bit Busy) PauseForSynchronous( Variant FirstGoRdy
    , Bit Start, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) ;  //_GUI 29,30
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 17,28

 //_ Behavior Topology
 Output.0 = For.0;  
 Output:A.0 = For.1;  
 Output:B.0 = Junction:A.1;  
 Output:C.0 = For.3;  
 Output:D.0 = For.4;  
 Output:E.0 = For.7;  
 Output:F.0 = PauseForSynchronous.1;  //_GUI 10,51, 10,47
 Junction.0 = Input:C.0;  
 Junction:A.0 = For.2;  
 For.0 = Input.0;  //_GUI 57,20, 57,17
 For.1 = Input:A.0;  //_GUI 55,23, 55,20
 For.2 = Junction.1;  
 For.3 = Junction:B.1;  
 For.4 = PauseForSynchronous.0;  //_GUI 53,41, 53,44
 For.5 = Input:F.0;  //_GUI 94,44, 94,48
 PauseForSynchronous.0 = Junction:A.0;  //_GUI 27,32, 27,14, 83,14
 PauseForSynchronous.1 = Input:B.0;  //_GUI 24,35, 24,23
 PauseForSynchronous.2 = Junction.2;  //_GUI 21,38
 PauseForSynchronous.3 = Junction:B.2;  //_GUI 18,41
 PauseForSynchronous.4 = Input:E.0;  
 PauseForSynchronous.5 = For.8;  //_GUI 56,47, 56,44
 Junction:B.0 = Input:D.0;  
}

Object ( Variant Max, Variant Assoc) Max( Variant Val
    , Variant Assoc, Variant Val, Variant Assoc) 
//_ Attributes TreeGroup="CoreLib\\Comparators\\Async\\Advanced",Documentation="Associated Data"
{
 // Returns the Maximum of the two input elements and the corresponding associated data.
 //
 // Inputs:
 //
 // Variant Val: input value
 //
 // Variant Assoc: associated data
 //
 // Variant Val: input value
 //
 // Variant Assoc: associated data
 //
 // Outputs:
 //
 // Variant Max: The maximum of the two input elements
 //
 // Variant Assoc: The associated data corresponding to the maximum of the two Val inputs.
 //
 // Dataset Coverage:
 //
 // The inputs must have the same dataset and can be of the following: MSBxxx, LSBxxx and BINxxx (unsigned.  For 2's complement compares use the Signed dataset), Signed, Floating and Fixed.  Also two input lists are supported producing an output list.  The lists can be heterogeneous as long as respective elements have the same dataset.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Val) Input;  //_GUI 28,26
 Object ( Variant Assoc) Input:A;  //_GUI 28,29
 Object ( Variant Val) Input:B;  //_GUI 28,35
 Object ( Variant Assoc) Input:C;  //_GUI 28,45
 Object Output( Variant Max) ;  //_GUI 80,27
 Object Output:A( Variant Assoc) ;  //_GUI 81,43
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 40,26
 Object ( Variant O) Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 69,41
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 43,35
 Object ( Variant O) Mux:A( Variant A, Variant B
    , Bit S) ;  //_GUI 68,25
 Object ( Bit "A<B", Bit "A=B", Bit "A>B") Compare
    ( Variant A, Variant B) ;  //_GUI 47,31
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 64,32

 //_ Behavior Topology
 Output.0 = Mux:A.0;  
 Output:A.0 = Mux.0;  
 Junction.0 = Input.0;  
 Mux.0 = Input:A.0;  //_GUI 38,43, 38,30
 Mux.1 = Input:C.0;  
 Mux.2 = Junction:B.2;  //_GUI 65,49
 Junction:A.0 = Input:B.0;  
 Mux:A.0 = Junction.1;  
 Mux:A.1 = Junction:A.0;  //_GUI 44,30
 Mux:A.2 = Junction:B.1;  
 Compare.0 = Junction.2;  //_GUI 41,33
 Compare.1 = Junction:A.1;  
 Junction:B.0 = Compare.0;  
}

Object ( Variant DataA, Bit DoneA, Variant DataB
    , Bit DoneB, Bit Busy) DMuxGDBW( Variant Data, Bit WaitA
    , Bit WaitB, Bit S, Bit Go) 
//_ Attributes TreeGroup="CoreLib\\Multiplexers\\Async"
{
 // Demultiplexes or selects between one of two outgoing GDBW data paths.  This is a fully asynchronous design.
 //
 // Inputs:
 //
 // Var Data: The data that will be sent two one of two outputs.
 //
 // Bit S: The select line.  When low, the A path is selected.  When high, the B path is selected.
 //
 // Bit Go: Go of the GDBW protocol.
 //
 // Bit WaitA: Wait of the GDBW protocol for path A.
 //
 // Bit WaitB: Wait of the GDBW protocol for path B.
 //
 // Outputs:
 //
 // Var DataA: Data for path A.  Per the GDBW protocol, DataA is undefined while DoneA is low.
 //
 // Bit DoneA: Done of the GDBW protocol for path A.  Passes through Go when S is low.  Low when S is high.
 //
 // Var DataB: Data for path B.  Per the GDBW protocol, DataB is undefined while DoneB is low.
 //
 // Bit DoneB: Done of the GDBW protocol for path B.  Passes through Go when S is high.  Low when S is low.
 //
 // Bit Busy: Busy of the GDBW protocol.  Passes through WaitA when S is low.  Passes through WaitB when S is high.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 18,15
 Object ( Bit WaitA) Input:A;  //_GUI 46,30
 Object ( Bit WaitB) Input:B;  //_GUI 46,50
 Object ( Bit S) Input:C;  //_GUI 17,54
 Object ( Bit Go) Input:D;  //_GUI 17,57
 Object Output( Variant DataA) ;  //_GUI 72,15
 Object Output:A( Bit DoneA) ;  //_GUI 72,20
 Object Output:B( Variant DataB) ;  //_GUI 72,35
 Object Output:C( Bit DoneB) ;  //_GUI 72,40
 Object Output:D( Bit Busy) ;  //_GUI 19,63
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 25,15
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 52,18
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 37,17
 Object ( Bit Out) AND:A( Bit In1, Bit In2) ;  //_GUI 52,38
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In3) ;  //_GUI 28,39
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In3) ;  //_GUI 32,42
 Object ( Bit Out) AND:B( Bit In1, Bit In2) ;  //_GUI 52,26
 Object ( Bit Out) INVERT:A( Bit In1) ;  //_GUI 37,25
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In3) ;  //_GUI 28,27
 Object ( Bit Out) AND:C( Bit In1, Bit In2) ;  //_GUI 52,46
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:D
    ( Bit In3) ;  //_GUI 28,47
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 65,44

 //_ Behavior Topology
 Output.0 = Junction.1;  
 Output:A.0 = AND.0;  
 Output:B.0 = Junction.2;  //_GUI 26,36
 Output:C.0 = AND:A.0;  
 Output:D.0 = OR.0;  //_GUI 17,64, 17,61, 79,61, 79,47
 Junction.0 = Input.0;  
 AND.0 = INVERT.0;  
 AND.1 = Junction:B.1;  //_GUI 33,23
 INVERT.0 = Junction:C.1;  //_GUI 29,20
 AND:A.0 = Junction:A.2;  
 AND:A.1 = Junction:B.2;  
 Junction:A.0 = Junction:D.1;  
 Junction:B.0 = Input:D.0;  //_GUI 33,58
 AND:B.0 = INVERT:A.0;  
 AND:B.1 = Input:A.0;  
 INVERT:A.0 = Junction:C.2;  
 Junction:C.0 = Junction:A.1;  
 AND:C.0 = Junction:D.2;  
 AND:C.1 = Input:B.0;  
 Junction:D.0 = Input:C.0;  //_GUI 29,55
 OR.0 = AND:B.0;  //_GUI 64,46, 64,29
 OR.1 = AND:C.0;  
}

Object ( Variant Data, Bit BusyA, Bit BusyB
    , Bit Done) MuxGDBW( Variant DataA, Bit GoA, Variant DataB
    , Bit GoB, Bit S, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Multiplexers\\Async"
{
 // Multiplexes or selects between one of two incoming GDBW data paths.  This is a fully asynchronous design.
 //
 // Inputs:
 //
 // Var DataA: The data that will be sent to the output if S is low.
 //
 // Bit GoA: Go of the GDBW protocol for path A.  Passes through to Done if S is low.
 //
 // Var DataB: The data that will be sent to the output if S is high.
 //
 // Bit GoB: Go of the GDBW protocol for path B.  Passes through to Done if S is high.
 //
 // Bit S: The select line.  When low, the A path is selected.  When high, the B path is selected.
 //
 // Bit Wait: Wait of the GDBW protocol.
 //
 // Outputs:
 //
 // Var Data: Data from DataA if S is low, from DataB if S is high.
 //
 // Bit BusyA: Busy of the GDBW protocol.  Passes through Wait when S is low.  High when S is high.
 //
 // Bit BusyB: Busy of the GDBW protocol.  Passes through Wait when S is high.  High when S is low.
 //
 // Bit Done: Done of the GDBW protocol.  From GoA if S is low.  From GoB if S is high.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant DataA) Input;  //_GUI 19,23
 Object ( Bit GoA) Input:A;  //_GUI 19,26
 Object ( Variant DataB) Input:B;  //_GUI 19,32
 Object ( Bit GoB) Input:C;  //_GUI 19,38
 Object ( Bit S) Input:D;  //_GUI 19,55
 Object ( Bit Wait) Input:E;  //_GUI 19,58
 Object Output( Variant Data) ;  //_GUI 78,24
 Object Output:A( Bit BusyA) ;  //_GUI 78,49
 Object Output:B( Bit BusyB) ;  //_GUI 78,56
 Object Output:C( Bit Done) ;  //_GUI 78,63
 Object ( Variant O) Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 36,22
 Object ( Variant O) Mux:A( Variant A, Variant B
    , Bit S) ;  //_GUI 36,34
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In3) ;  //_GUI 31,41
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 52,54
 Object ( Bit Out) OR:A( Bit In1, Bit In2) ;  //_GUI 52,47
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 47,58
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In3) ;  //_GUI 31,48
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 35,53
 Object Text;  //_GUI 48,41,A is busy when B is selected or Wait
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 31,55
 Object Text;  //_GUI 47,61,B is busy when A is selected or Wait
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 49,34

 //_ Behavior Topology
 Output.0 = Mux.0;  
 Output:A.0 = OR:A.0;  
 Output:B.0 = OR.0;  
 Output:C.0 = VouchBit.0;  //_GUI 68,64, 68,37
 Mux.0 = Input.0;  
 Mux.1 = Input:B.0;  //_GUI 29,27, 29,33
 Mux.2 = Junction.1;  //_GUI 32,30
 Mux:A.0 = Input:A.0;  //_GUI 26,36, 26,27
 Mux:A.1 = Input:C.0;  
 Mux:A.2 = Junction.2;  
 Junction.0 = Junction:B.1;  
 OR.0 = INVERT.0;  
 OR.1 = Junction:A.1;  
 OR:A.0 = Junction:B.2;  
 OR:A.1 = Junction:A.0;  //_GUI 48,52
 Junction:A.0 = Input:E.0;  
 Junction:B.0 = Junction:C.0;  
 INVERT.0 = Junction:C.1;  
 Junction:C.0 = Input:D.0;  
 VouchBit.0 = Mux:A.0;  
}

Object ( Variant DataOut, Variant Count, Bit Busy) WriteQueue
    ( Variant DataIn, Bit ClkG, Bit Reset, Variant ReadAddr
    , Bit Go) 
//_ Attributes TreeGroup="CoreLib\\Memory\\Advanced"
{
 // Writes as a queue, reads as memory.  Useful for debugging.
 //
 // Inputs:
 //
 // Var DataIn: Data to be pushed onto the WriteQueue.
 //
 // Bit ClkG: The clock input.  If left disconnected, defaults to the global symbol ClkG.
 //
 // Bit Reset: Asynchronous clear.  Clears the queue pointers and count, but doesn't clear the queue memory.  If left disconnected, defaults to 0.
 //
 // Var ReadAddr: The dataset represents the number of elements in the write queue used for the queue's internal memory address space. Its value is used for the read address.  The object performs continuous reads of this address.
 //
 // Bit Go: A Go while not Busy will push DataIn onto the memory at the address of Count and increment Count.
 //
 // Outputs:
 //
 // Var DataOut: The continuously updated data value at the address of ReadAddr with a one-cycle delay.
 //
 // Var Count: Current number of elements in queue.
 //
 // Bit Busy: Goes high when memory is filled.
 //
 // Revision 2 - 11/07/05 Fixed bug 654
 // Bug title: WriteQueue override of ReadAddr should be removed
 // Bug body: There is an override of the ReadAddr that forces the address bits to 9 or
 // more.  I think it was intended to force it to 9 or less.  Either way, I don't
 // think we should force it to anything, but let it stand as the user sets it.
 // Revision 3 - 07/20/06 The object used to store only up to 2^(BitLen(ReadAddr)-1) elements and the last memory address was always zero.  Now we can store in the last element too.  The Count output has one more bit than ReadAddr so it can represent a count of 2^(BitLen(ReadAddr)).
 //_ Object Prototypes
 Object ( Variant DataIn) Input;  //_GUI 11,14
 Object ( Bit ClkG) Input:A;  //_GUI 11,20
 //_ Attributes Resource="Global"
 Object ( Bit Reset) Input:B;  //_GUI 11,35
 //_ Attributes Constant="0"
 Object ( Variant ReadAddr) Input:C;  //_GUI 11,39
 Object ( Bit Go) Input:D;  //_GUI 11,74
 Object Output( Variant DataOut) ;  //_GUI 182,27
 Object Output:A( Variant Count) ;  //_GUI 182,48
 Object Output:B( Bit Busy) ;  //_GUI 182,64
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 54,20
 Object ( Variant Q) RegClr( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 62,25
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:A
    ( Variant In0) ;  //_GUI 79,27
 Object ( Variant WriteOut, Variant ReadOut) RAMDP( Variant Data
    , Variant WriteAdd, Variant ReadAdd, Bit ClkG, Bit WE) ;  //_GUI 93,23
 Object ( Variant Out1) Cast( Variant Type, Variant Data) ;  //_GUI 41,24
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 165,57
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 149,58
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 153,56
 Object ( Variant Out1) MSB( Variant In1) ;  //_GUI 18,37
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:C
    ( Variant In1) ;  //_GUI 79,50
 Object Text;  //_GUI 135,63,Allow address incrementing until overflow is reached.
 Object Text;  //_GUI 85,53,Increment the write address
 Object Text;  //_GUI 61,47,Register the write address.
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 137,56
 Object ( Variant OFL, Variant S) Add( Variant A
    , Variant B) ;  //_GUI 96,56
 Object ( Variant Out1) One( Variant In1) ;  //_GUI 84,58
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:D
    ( Variant In1) ;  //_GUI 79,57
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:E
    ( Variant In0) ;  //_GUI 29,39
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:F
    ( Bit In2) ;  //_GUI 89,44
 Object ( Variant Out1) CollectMSB( Variant In2, Variant In3) ;  //_GUI 153,46
 Object ( Variant Q) RegClr:A( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 123,56
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:G
    ( Bit In2) ;  //_GUI 116,44
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:H
    ( Bit In1) ;  //_GUI 84,33
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:I
    ( Bit In0) ;  //_GUI 56,35

 //_ Behavior Topology
 Output.0 = RAMDP.1;  
 Output:A.0 = CollectMSB.0;  
 Output:B.0 = Junction:B.2;  //_GUI 150,65
 Junction.0 = Input:A.0;  
 RegClr.0 = Cast.0;  
 RegClr.1 = Junction.2;  //_GUI 55,30
 RegClr.2 = Junction:F.0;  //_GUI 60,33, 60,45
 RegClr.3 = Junction:I.1;  
 Junction:A.0 = RegClr.0;  
 RAMDP.0 = Input.0;  //_GUI 88,25, 88,15
 RAMDP.1 = Junction:A.1;  
 RAMDP.2 = Junction:E.1;  //_GUI 73,31, 73,40
 RAMDP.3 = Junction:H.1;  
 RAMDP.4 = Junction:F.1;  //_GUI 90,37
 Cast.0 = Junction:E.0;  //_GUI 30,26
 Cast.1 = Add.1;  //_GUI 37,29, 37,67, 114,67, 114,61
 AND.0 = INVERT.0;  
 AND.1 = Input:D.0;  //_GUI 161,62, 161,75
 Junction:B.0 = VouchBit.0;  
 INVERT.0 = Junction:B.1;  
 MSB.0 = Input:C.0;  
