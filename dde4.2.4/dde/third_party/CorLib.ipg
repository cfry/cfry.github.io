Object ( Variant OFL, Variant Out2) SignExtnd( Variant Type
    , Variant Data) 
//_ Attributes TreeGroup="CoreLib\\Converters\\Async\\Advanced"
{
 // This does a twos complement (sign) extend of the data when converting to a larger dataset size.  If shrinking the dataset, the OFL will go high if any of the discarded bits had different values.
 //
 // Inputs:
 //
 // Var/List Type: The output dataset
 // Var/List Data: The data to sign extend
 //
 // Outputs:
 //
 // Bit/List OFL: 1 if any removed bits were high.
 //
 // Var/List output: The resulting output of dataset Type
 //
 // Revision 1
 //_ Object Prototypes
