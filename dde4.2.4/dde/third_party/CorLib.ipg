Object ( NULL Out1, Bit Done, Bit Busy) LeastSig
    ( NULL In1, Bit ClkG, Bit AClr, Bit Go
    , Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Multiplexers\\Advanced",Documentation="NULL"
{
 // Clears all bits except the least significant asserted bit.  This is a pipelined object and can accept a new value every clock, unless told to wait.
 //
 // Inputs:
 //
 // Variant input: A set of bits.
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit AClr: Asynchronous clear.  If disconnected, defaults to 0.
 //
 // Bit Go: The Go of GDBW.  The input is registered on the rising clock edge if Go high and Busy low.
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.
 //
 // Outputs:
 //
 // Variant output: Keeps the least significant asserted bit of the input asserted and clears all other bits.
 //
 // Bit Done: The Done in GDBW.  Output valid while high.
 //
 // Bit Busy: The Wait in GDBW.  Tells Go to hold off.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( NULL In1) Input;  //_GUI 19,11
 Object ( Bit ClkG) Input:A;  //_GUI 19,14
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:B;  //_GUI 19,17
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:C;  //_GUI 19,23
 Object ( Bit Wait) Input:D;  //_GUI 36,36
 //_ Attributes Constant="0"
 Object Output( NULL Out1) ;  //_GUI 27,11
 Object Output:A( Bit Done) ;  //_GUI 42,23
 Object Output:B( Bit Busy) ;  //_GUI 25,32

 //_ Behavior Topology
 Output.0 = Input.0;  
 Output:A.0 = Input:C.0;  
 Output:B.0 = Input:D.0;  //_GUI 25,28, 40,28
}

