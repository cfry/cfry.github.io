Object ( Variant Q) RegEnDepth( Variant D, Bit ClkG
    , Bit EN, Variant depth) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\Advanced"
{
 // RegEnDepth instantiates a cascading shift registers with a global EN.  The number of stages is specified via the bitlength of the depth input (n).  n registers are then recursively tiled, producing a pipeline with latency n.
 //
 // Inputs:
 // D - Data input
 // EN - Enable signal
 // depth - the latency of the RegDepth is equal to the bitlength of depth
 //
 // Outputs:
 // Q - output data
 //
 // Date:
 // 16 Nov, 2004
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant D) Input;  //_GUI 36,23
 Object ( Bit ClkG) Input:A;  //_GUI 36,26
 //_ Attributes Resource="Global"
 Object ( Bit EN) Input:B;  //_GUI 36,29
 //_ Attributes Constant="1"
 Object ( Variant depth) Input:C;  //_GUI 19,39
 Object Output( Variant Q) ;  //_GUI 91,21
 Object ( Variant Out1) Context( Variant Type, Variant Data) ;  //_GUI 79,19
 //_ Attributes Documentation="Variant"
 Object ( Variant QAddr, Variant QDepth) RegDepthAddr( Variant D
    , Bit ClkG, Bit EN, Variant Addr) ;  //_GUI 59,22
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 43,23
 Object ( Variant Out1) BitLength( Variant Type) ;  //_GUI 42,39
 Object ( Variant Out1, Variant Out1) ExposeMSB( Variant In1) ;  //_GUI 25,37
 //_ Attributes Documentation="bit"
 Object Text;  //_GUI 29,48,Depth is in number of bits.  Subtract one bit because we need to generate a zero based address.  The bitlength is then converted to a constant value with minimum representation.  This is just what RegDepthAddr needs.

 //_ Behavior Topology
 Output.0 = Context.0;  
 Context.0 = Junction.0;  //_GUI 44,21
 Context.1 = RegDepthAddr.0;  
 RegDepthAddr.0 = Junction.1;  
 RegDepthAddr.1 = Input:A.0;  
 RegDepthAddr.2 = Input:B.0;  
 RegDepthAddr.3 = BitLength.0;  //_GUI 56,33, 56,42
 Junction.0 = Input.0;  
 BitLength.0 = ExposeMSB.1;  
 ExposeMSB.0 = Input:C.0;  
}

