//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async"
{
 // Asynchronously decrements the input value.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant input: Number
 //
 // Outputs:
 //
 // output: Number - 1.  No indication of carry out or overflow is given.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (Works for unsigned or 2's complement), Signed, Floating, Fixed and List.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 18,20
 Object Output( Variant Out1) ;  //_GUI 82,26
 Object ( Variant S) Sub( Variant A, Variant B) ;  //_GUI 65,24
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 28,20
 Object ( Variant Out1) One( Variant In1) ;  //_GUI 37,26

 //_ Behavior Topology
 Output.0 = Sub.0;  
 Sub.0 = Junction.1;  //_GUI 57,26, 57,21
 Sub.1 = One.0;  
 Junction.0 = Input.0;  
 One.0 = Junction.2;  //_GUI 29,29
}

Object ( Bit Out1) BitLength( NULL Type) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip\\$Internal",Documentation="NULL"
{
 // Returns the bitlength of the incoming data set as a numberic constant.  The output data set will have the smallest bitlength possible to represent the constant value.  This means the ouput will always have a leading 1.
 //
 // Inputs:
 //
 // Variant Type: The dataset for which a bit length will be computed.
 //
 // Outputs:
 //
 // Variant output: The bit length of Type as a numeric constant.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( NULL Type) Input;  //_GUI 18,20
 Object Output( Bit Out1) ;  //_GUI 57,20
 Object ( Bit Type) Input:A;  //_GUI 48,20
 //_ Attributes PromoteToParentObject="False",Constant="0"

 //_ Behavior Topology
 Output.0 = Input:A.0;  
}

Object ( Bit LOut, Bit ROut, Variant Pout
    , Bit Done, Bit Busy) ShiftReg( Bit Lin, Bit RIn
    , Variant "Pin/Type", Bit "L/R", Bit Load, Bit CLR
    , Bit ClkG, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters\\$Internal",Documentation="bit"
{
 // Loadable Shift Register with parallel and serial input/output interfaces and GDBW communication.  A shift is performed on every Go.  Wait->Busy is a straight pass-through.
 // Inputs:
 // LIn - Serial input of most significant bit/data set
 // RIn - Serial input of least significant bit/data set
 // Pin/Type - Paralllel input interface as well as type specification.  Latched while Load and not Busy
 // L/R - shift left vs. right. 0 = left, 1 = right. Default=0
 // Load - loads the parallel data if not Busy.  Produces a Done.  Load has precidence over Go.
 // CLR - asynchronous clear.  Default=0.
 // ClkG - input clock.  Defaults to the global user clock
 // Go - If not Busy, shifts the data.  Load has precidence over Go.
 // Wait - Drops Done and raises Busy. Default=0
 //
 // Outputs:
 // LOut - Serial output  of most significant bit/data set
 // ROut - Serial output of least significant bit/data set
 // POut - Parallel output interface
 // Done - Incicates valid data on the above outputs.  Triggered by a Load or a Done (shift).
 // Busy - Indicates Go and Load should drop and will be ignored.
 //
 // Date Last Modiified:
 // 11/19/04
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Bit Lin) Input;  //_GUI 11,31
 //_ Attributes Constant="0"
 Object ( Bit RIn) Input:A;  //_GUI 11,34
 //_ Attributes Constant="0"
 Object ( Variant "Pin/Type") Input:B;  //_GUI 11,37
 Object ( Bit "L/R") Input:C;  //_GUI 11,40
 //_ Attributes Constant="0"
 Object ( Bit Load) Input:D;  //_GUI 11,43
 //_ Attributes Constant="0"
 Object ( Bit CLR) Input:E;  //_GUI 12,49
 //_ Attributes Constant="0"
 Object ( Bit ClkG) Input:F;  //_GUI 12,52
 //_ Attributes Resource="Global"
 Object ( Bit Go) Input:G;  //_GUI 13,62
 Object ( Bit Wait) Input:H;  //_GUI 66,71
 //_ Attributes Constant="0"
 Object Output( Bit LOut) ;  //_GUI 117,31
 Object Output:A( Bit ROut) ;  //_GUI 117,34
 Object Output:B( Variant Pout) ;  //_GUI 117,37
 Object Output:C( Bit Done) ;  //_GUI 72,63
 Object Output:D( Bit Busy) ;  //_GUI 46,72
 Object ( Bit GoOne, Bit Done, Bit Busy) GDBW_Clr_1cyc_BWpass
    ( Bit ClkG, Bit CLR, Bit Go, Bit Wait) ;  //_GUI 46,56
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 18,49
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 22,52
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 29,61
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 54,41
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In2) ;  //_GUI 40,66
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 42,43
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 25,43
 Object ( Bit Out1) VouchBit( Variant In1) ;  //_GUI 99,29
 Object ( Bit Out1) VouchBit:A( Variant In1) ;  //_GUI 99,32
 Object ( Variant Lout, Variant Rout, Variant Pout) $ShiftReg
    ( Variant Lin, Variant Rin, Variant Pin, Bit "L/R"
    , Bit Load, Bit ClkG, Bit EN, Bit CLR) ;  //_GUI 81,30
 //_ Attributes Documentation="Var"

 //_ Behavior Topology
 Output.0 = VouchBit.0;  
 Output:A.0 = VouchBit:A.0;  
 Output:B.0 = $ShiftReg.2;  
 Output:C.0 = GDBW_Clr_1cyc_BWpass.1;  
 Output:D.0 = Junction:B.2;  //_GUI 41,73
 GDBW_Clr_1cyc_BWpass.0 = Junction:A.2;  //_GUI 23,58
 GDBW_Clr_1cyc_BWpass.1 = Junction.2;  //_GUI 19,61
 GDBW_Clr_1cyc_BWpass.2 = OR.0;  
 GDBW_Clr_1cyc_BWpass.3 = Input:H.0;  
 Junction.0 = Input:E.0;  
 Junction:A.0 = Input:F.0;  
 OR.0 = Input:G.0;  
 OR.1 = Junction:C.2;  //_GUI 26,66
 AND.0 = Junction:C.0;  
 AND.1 = INVERT.0;  
 Junction:B.0 = GDBW_Clr_1cyc_BWpass.2;  
 INVERT.0 = Junction:B.1;  //_GUI 41,46
 Junction:C.0 = Input:D.0;  
 VouchBit.0 = $ShiftReg.0;  
 VouchBit:A.0 = $ShiftReg.1;  
 $ShiftReg.0 = Input.0;  
 $ShiftReg.1 = Input:A.0;  
 $ShiftReg.2 = Input:B.0;  
 $ShiftReg.3 = Input:C.0;  
 $ShiftReg.4 = AND.0;  
 $ShiftReg.5 = Junction:A.0;  //_GUI 23,47
 $ShiftReg.6 = GDBW_Clr_1cyc_BWpass.0;  //_GUI 73,50, 73,59
 $ShiftReg.7 = Junction.1;  //_GUI 70,53, 70,50
}

Object ( Variant LOut, Variant ROut, Variant Pout
    , Bit Done, Bit Busy) ShiftReg( Variant LIn, Variant RIn
    , Variant "PIn/Type", Bit "L/R", Bit Load, Bit CLR
    , Bit ClkG, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Shifters",Documentation="GDBW"
{
 // Loadable Shift Register with parallel and serial input/output interfaces and GDBW communication.  A shift is performed on every Go.  Wait->Busy is a straight pass-through.
 //
 // INPUTS:
 // Variant LIn:The data shifted in the left (most significant) end for a right shift.  The right shift amount is defined at compile time by the size of LIn.
 //
 // Variant RIn: The data shifted in the right (least significant) end for a left shift.  The left shift amount is defined at compile time by the size of RIn.
 //
 // Variant PIn/Type: Parallel input interface as well as type specification.  Latched while Load and not Busy.  Even if you are not going to use the Load, this dataset must still be defined so the size of the entire shift register will be known.
 //
 // Bit L/R: Shift left (0) vs. right (1).  If disconnected, defaults to left (0).
 //
 // Bit Load: Loads the parallel data if not Busy.  Produces a Done.  Load has precedence over Go. Default=0.
 //
 // Bit CLR: Asynchronously clears the register.  If disconnected, defaults to 0.
 //
 // Bit ClkG: The clock for the operation.  If disconnected, defaults to ClkG, the global user clock signal.
 //
 // Bit Go: The Go of GDBW.  If not Busy, shifts the data.  Load has precedence over Go.
 //
 // Bit Wait: The Wait of GDBW.  If disconnected, defaults to a value of 0.  Holds off the Done.
 //
 // OUTPUTS:
 // Variant LOut: The data shifted out the left (most significant) end from a left shift.  Same dataset as RIn.
 //
 // Variant ROut: The data shifted out the right (least significant) end from a right shift.  Same dataset as LIn.
 //
 // Variant POut: Parallel output interface.
 //
 // Bit Done:	The Done of GDBW.  Indicates valid data on the above data output.  Triggered by a Load or a Done (shift).
 //
 // Bit Busy: The Busy of GDBW.  Indicates Go and Load should drop and will be ignored.
 //
 // Date Last Modiified:
 // 11/19/04
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant LIn) Input;  //_GUI 11,31
 Object ( Variant RIn) Input:A;  //_GUI 11,34
 Object ( Variant "PIn/Type") Input:B;  //_GUI 11,37
 Object ( Bit "L/R") Input:C;  //_GUI 11,40
 //_ Attributes Constant="0"
 Object ( Bit Load) Input:D;  //_GUI 11,43
 //_ Attributes Constant="0"
 Object ( Bit CLR) Input:E;  //_GUI 12,49
 //_ Attributes Constant="0"
 Object ( Bit ClkG) Input:F;  //_GUI 12,52
 //_ Attributes Resource="Global"
 Object ( Bit Go) Input:G;  //_GUI 13,62
 Object ( Bit Wait) Input:H;  //_GUI 66,71
 //_ Attributes Constant="0"
 Object Output( Variant LOut) ;  //_GUI 97,31
 Object Output:A( Variant ROut) ;  //_GUI 97,34
 Object Output:B( Variant Pout) ;  //_GUI 97,37
 Object Output:C( Bit Done) ;  //_GUI 72,63
 Object Output:D( Bit Busy) ;  //_GUI 46,72
 Object ( Bit GoOne, Bit Done, Bit Busy) GDBW_Clr_1cyc_BWpass
    ( Bit ClkG, Bit CLR, Bit Go, Bit Wait) ;  //_GUI 46,56
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In0) ;  //_GUI 18,49
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 22,52
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 29,61
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 54,41
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In2) ;  //_GUI 40,66
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 42,43
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 25,43
 Object ( Variant Lout, Variant Rout, Variant Pout) $ShiftReg
    ( Variant Lin, Variant Rin, Variant Pin, Bit "L/R"
    , Bit Load, Bit ClkG, Bit EN, Bit CLR) ;  //_GUI 81,30
 //_ Attributes Documentation="Var"

 //_ Behavior Topology
 Output.0 = $ShiftReg.0;  
 Output:A.0 = $ShiftReg.1;  
 Output:B.0 = $ShiftReg.2;  
 Output:C.0 = GDBW_Clr_1cyc_BWpass.1;  
 Output:D.0 = Junction:B.2;  //_GUI 41,73
 GDBW_Clr_1cyc_BWpass.0 = Junction:A.2;  //_GUI 23,58
 GDBW_Clr_1cyc_BWpass.1 = Junction.2;  //_GUI 19,61
 GDBW_Clr_1cyc_BWpass.2 = OR.0;  
 GDBW_Clr_1cyc_BWpass.3 = Input:H.0;  
 Junction.0 = Input:E.0;  
 Junction:A.0 = Input:F.0;  
 OR.0 = Input:G.0;  
 OR.1 = Junction:C.2;  //_GUI 26,66
 AND.0 = Junction:C.0;  
 AND.1 = INVERT.0;  
 Junction:B.0 = GDBW_Clr_1cyc_BWpass.2;  
 INVERT.0 = Junction:B.1;  //_GUI 41,46
 Junction:C.0 = Input:D.0;  
 $ShiftReg.0 = Input.0;  
 $ShiftReg.1 = Input:A.0;  
 $ShiftReg.2 = Input:B.0;  
 $ShiftReg.3 = Input:C.0;  
 $ShiftReg.4 = AND.0;  
 $ShiftReg.5 = Junction:A.0;  //_GUI 23,47
 $ShiftReg.6 = GDBW_Clr_1cyc_BWpass.0;  //_GUI 73,50, 73,59
 $ShiftReg.7 = Junction.1;  //_GUI 59,53, 59,50
}

