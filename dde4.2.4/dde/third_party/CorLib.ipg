    ( Variant In3) ;  //_GUI 134,47
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:D
    ( Variant In3) ;  //_GUI 134,40
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:E
    ( Variant In3) ;  //_GUI 126,44
 Object Text;  //_GUI 155,59,So in this case, the Round signal means the data was rounded, instead of that it should have been rounded.
 Object ( Bit O) $Mux:A( Bit A, Bit B
    , Bit S) ;  //_GUI 164,9
 //_ Attributes Documentation="Bit"
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:F
    ( Variant In3) ;  //_GUI 126,37
