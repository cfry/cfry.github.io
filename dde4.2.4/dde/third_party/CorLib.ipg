Object ( Variant OFL, Variant Q, Variant R) DivMod
    ( Variant N, Variant D) 
//_ Attributes TreeGroup="CoreLib\\ArithmeticOps\\Async\\Advanced",Icon="DIV"
{
 // Asynchronously divides N by D and produces a whole number quotient and a remainder.
 //
 // Because this is an asynchronous object, larger datasets at higher frequencies or using it in combination with other asynchronous circuitry may cause it to have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Variant N: Dividend or Numerator
 //
 // Variant D: Divisor or Denominator
 //
 // Outputs:
 //
 // Variant OFL: Overflow or Error.  List if N or D are Lists, otherwise Bit.
 //
 // Variant Q: Quotent
 //
 // Variant R : Remainder or Modulous result
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx (interpreted as unsigned numbers, Q and R are the same dataset as the symmetrized N and D inputs), Signed (Q and R are the same dataset as the symmetrized N and D inputs), Fixed (Q is a Signed dataset with a size equal to the number of bits of the symmetrized N and D inputs, R is the same dataset as the symmetrized N and D inputs), and one or two Lists.  Floating and Complex are not supported.  A and B can not have mixed datasets except with respect to size (produces a warning) or in the case of MSB, LSB and BIN. The larger the datasets, the slower the maximum frequency of the circuit will be.
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant N) Input;  //_GUI 34,47
 Object ( Variant D) Input:A;  //_GUI 34,50
 Object Output( Variant OFL) ;  //_GUI 53,47
 Object Output:A( Variant Q) ;  //_GUI 53,50
 Object Output:B( Variant R) ;  //_GUI 53,53
 Object ( Bit OFL, Variant Q, Variant R) UDivMod
    ( Variant N, Variant D) ;  //_GUI 40,46

 //_ Behavior Topology
 Output.0 = UDivMod.0;  
 Output:A.0 = UDivMod.1;  
 Output:B.0 = UDivMod.2;  
 UDivMod.0 = Input.0;  
 UDivMod.1 = Input:A.0;  
}

