 Junction:B.0 = Input:C.0;  
 INVERT:A.0 = Junction:E.2;  //_GUI 136,83
 OR.0 = AND:B.0;  
 OR.1 = AND:E.0;  //_GUI 157,35, 157,39
 Junction:C.0 = $Cast:A.0;  
 Junction:D.0 = $Cast.0;  
 Junction:E.0 = Junction:I.1;  
 Junction:F.0 = OR.0;  
 Junction:G.0 = Input.0;  //_GUI 24,11
 AND:B.0 = Junction:D.0;  //_GUI 131,31
 AND:B.1 = Junction:E.0;  //_GUI 136,34
 Junction:H.0 = Input:D.0;  
 $Cast.0 = State:A.0;  
