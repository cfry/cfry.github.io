Object ( Variant Data, Variant Offset, Bit Done) BitStuffer
    ( Variant Data, Variant ValBits, Bit Flush, Bit ClkG
    , Bit AClr, Bit Go) 
//_ Attributes TreeGroup="CoreLib\\Registers\\$Internal"
{
 // This object is for bit stuffing (like it's done in the JPEG algorithms and elsewhere.)
 //
 // For an example, a six bit input on ValBits would produce a 64bit output. The Data input in that case would likely be 32bits. You send in a LSB-aligned value on Data and the number of valid bits of valid data on Data into the ValBits input. The internal registers collect the data until the number of valid bits has accumulated to the point that the output is full. It then triggers the done and tosses shifts in all the overrun.
 //
 // It's expected that Flush will not come in while Go is high. Flush triggers the Done immediately and clears the internal registers.
 //
 // Revision 1
 // Revision 2: changed compare to use !A<B
 //_ Object Prototypes
 Object ( Variant Data) Input;  //_GUI 67,29
 Object ( Variant ValBits) Input:A;  //_GUI 60,61
 Object ( Bit Flush) Input:B;  //_GUI 72,69
 Object ( Bit ClkG) Input:C;  //_GUI 72,75
 //_ Attributes Resource="Global"
 Object ( Bit AClr) Input:D;  //_GUI 72,78
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:E;  //_GUI 72,91
 Object Output( Variant Data) ;  //_GUI 308,47
 //_ Attributes WidgetHex="True",WidgetWidth="228",WidgetHeight="41"
 Object Output:A( Variant Offset) ;  //_GUI 296,81
 Object Output:B( Bit Done) ;  //_GUI 321,90
 Object ( Variant Out1) Cast( Variant Type, Variant Data) ;  //_GUI 170,79
 //_ Attributes Documentation="ztlist"
 Object ( Variant Out1) OR( Variant In1, Variant In2) ;  //_GUI 228,47
 //_ Attributes Documentation="Var/Null"
 Object ( Variant O) Mux( Variant A, Variant B
    , Bit S) ;  //_GUI 275,45
 //_ Attributes Documentation="Bit"
 Object ( Variant Out1) Zero( Variant In1) ;  //_GUI 222,28
 //_ Attributes Documentation="ztlist"
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction
    ( Variant In0) ;  //_GUI 215,30
 Object ( Bit OFL, Variant Out1) UExtnd( Variant Type
    , Variant Data) ;  //_GUI 95,25
 Object Text;  //_GUI 108,23,This is one fat shifter: 128x7
 Object ( Bit Type) Input:F;  //_GUI 66,58
 //_ Attributes PromoteToParentObject="False",Constant="0"
 Object ( Bit Out) OR:A( Bit In1, Bit In2) ;  //_GUI 271,68
 Object ( Variant Out1) CollectLSB( Variant In2, Variant In3) ;  //_GUI 237,29
 Object ( Bit OFL, Variant Out1) ShiftLeftBy( Variant Data
    , Variant ShiftBy) ;  //_GUI 118,28
 Object Text;  //_GUI 1,6,in C:function stuffer(dword data, byte validBits, bool isFlush){static byte currPos;static uint128 currData;if(isFlush){ //assumed that this happens when other data is invalid  currData |= (~0UI64) << currPos;  sendOut( (int64)currData);  currData = 0;  currPos = 0;}  currData |= data << currPos;currPos += validBits;if(currPos >=64){  sendOut( (int64)currData);  currData >>= 64;  currPos -= 64;}}
 Object Text;  //_GUI 153,40,currData(128bits)
