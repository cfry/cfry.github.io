Object ( Variant Iteration, Bit LastDone, Bit Active
    , Bit Done, Bit Busy) DoneForN_ThroughTwos( Variant Start, Variant Finish
    , Bit ClkG, Bit CLR, Bit Go, Bit Wait) 
//_ Attributes TreeGroup="CoreLib\\Controllers\\Advanced"
{
 // Produces N Dones for every one Go.  Outputs the Done iteration count incrementing from Start through Finish. Uses the standard GDBW model.  Larger iterations at higher frequencies may have difficulty passing timing specifications.
 //
 // Inputs:
 //
 // Var Iterations: This value indicates the number of iterations or Dones to produce for every Go.
 //
 // Bit ClkG: Global clock if disconnected or a specific clock if connected
 //
 // Bit Go: Start producing N Dones.
 //
 // Bit Wait: Wait. Has a value of 0 if disconnected.  Holds off the Dones
 //
 // Outputs:
 //
 // Var Iteration The Done iteration value.  Same dataset as the Iterations input.  Values only valid while Done is high.  The first Done iteration value is 0. the LastDone iteration value is N-1.
 //
 // Bit LastDone Indicates when the last Done is occurring.
 //
 // Bit Active: Same behavior as the Done signal except it does not drop during Wait.
 //
 // Bit Done: N of these are produced for every Go.
 //
 // Bit Busy: Tells Go to hold off.
 //
 // Dataset Coverage:
 //
 // MSBxxx, LSBxxx and BINxxx
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant Start) Input;  //_GUI 13,16
 Object ( Variant Finish) Input:A;  //_GUI 13,42
 Object ( Bit ClkG) Input:B;  //_GUI 13,114
 //_ Attributes Resource="Global"
 Object ( Bit CLR) Input:C;  //_GUI 13,117
 //_ Attributes Constant="0"
 Object ( Bit Go) Input:D;  //_GUI 13,126
 Object ( Bit Wait) Input:E;  //_GUI 214,131
 //_ Attributes Constant="0"
 Object Output( Variant Iteration) ;  //_GUI 216,15
 Object Output:A( Bit LastDone) ;  //_GUI 216,64
 Object Output:B( Bit Active) ;  //_GUI 221,92
 Object Output:C( Bit Done) ;  //_GUI 216,110
 Object Output:D( Bit Busy) ;  //_GUI 150,153
 Object Text;  //_GUI 58,121,When Busy we do not block Goes because if we are already in the Doning state and Go comes in we will stay in state.  This is OK for two reasons: 1) When we are on the last cycle (LastDone) Busy is dropped and we want to allow a new Go.  2) If not LastDone we will stay in state anyway, so it doesn't matter if we tell it to enter.
 Object ( Bit Out) AND( Bit In1, Bit In2) ;  //_GUI 137,151
 Object Text;  //_GUI 66,103,Doning
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction
    ( Bit In1) ;  //_GUI 54,111
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:A
    ( Bit In0) ;  //_GUI 212,64
 Object ( Bit Out) INVERT( Bit In1) ;  //_GUI 117,150
 Object Text;  //_GUI 125,143,Only Busy when in Doning state and not LastDone
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:B
    ( Bit In0) ;  //_GUI 106,109
 Object ( Variant State) State( Variant Enter, Variant Leave
    , Bit ClkG, Bit CLR) ;  //_GUI 64,107
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:C
    ( Bit In0) ;  //_GUI 197,110
 Object ( Bit Out) AND:A( Bit In1, Bit In2) ;  //_GUI 161,108
 Object ( Variant Q) RegClr( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 186,61
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:D
    ( Bit In0) ;  //_GUI 173,110
 Object ( Bit Out) INVERT:A( Bit In1) ;  //_GUI 147,110
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:E
    ( Bit In2) ;  //_GUI 51,100
 Object ( Variant Q) RegClr:A( Variant D, Bit ClkG
    , Bit EN, Bit CLR) ;  //_GUI 133,13
 Object ( Bit Out) OR( Bit In1, Bit In2) ;  //_GUI 34,59
 Object ( Bit Out1, Bit Out2, Bit Out3) Junction:F
    ( Bit In2) ;  //_GUI 54,97
 Object ( Bit Out) INVERT:B( Bit In1) ;  //_GUI 15,58
 Object ( Bit Out) OR:A( Bit In1, Bit In2) ;  //_GUI 105,75
 Object ( Variant Out1) Cast( Variant Type, Variant Data) ;  //_GUI 51,8
 Object ( Variant Out1, Variant Out2, Variant Out3) Junction:G
    ( Variant In0) ;  //_GUI 40,16
 Object ( Bit Out) AND:B( Bit In1, Bit In2) ;  //_GUI 74,74
