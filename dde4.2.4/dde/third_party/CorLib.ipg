Object ( NULL MinOfAB, Variant DataWithMin, Variant MaxOfAB
    , Variant DataWithMax) OrderWithDatasets( NULL A, Variant DataWithA, Variant B
    , Variant DataWithB) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip\\$Internal",Documentation="NULL/var"
{
 // Orders the two datasets with respect to dataset length.  It does this by comparing the bit lengths of the two inputs and rearranges the datasets if necessary to output the smaller dataset on top (Min).
 //
 // Inputs:
 //
 // Variant A: One of the two datasets to order by length.
 //
 // Variant DataWithA: Another dataset associated with and moved with A.
 //
 // Variant B: One of the two datasets to order by length.
 //
 // Variant DataWithB: Another dataset associated with and moved with B.
 //
 // Outputs:
 //
 // Variant MinOfAB: The smaller of the input datasets A and B.
 //
 // Variant DataWithMin: If A is Min then this output is DataWithA.  If B is Min then this output is DataWithB
 //
 // Variant MaxOfAB: The larger of the input datasets A and B.
 //
 // Variant DataWithMax: If A is Max then this output is DataWithA.  If B is Max then this output is DataWithB
 //
 // Revision 1
 //_ Object Prototypes
 Object ( NULL A) Input;  //_GUI 11,13
 Object ( Variant DataWithA) Input:A;  //_GUI 11,16
 Object ( Variant B) Input:B;  //_GUI 11,20
 Object ( Variant DataWithB) Input:C;  //_GUI 11,23
 Object Output( NULL MinOfAB) ;  //_GUI 20,13
 Object Output:A( Variant DataWithMin) ;  //_GUI 20,16
 Object Output:B( Variant MaxOfAB) ;  //_GUI 20,20
 Object Output:C( Variant DataWithMax) ;  //_GUI 20,23

 //_ Behavior Topology
 Output.0 = Input.0;  
 Output:A.0 = Input:A.0;  
 Output:B.0 = Input:B.0;  
 Output:C.0 = Input:C.0;  
}

