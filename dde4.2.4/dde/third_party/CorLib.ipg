Object ( Bit Out1) IsContextual( Variant In1) 
//_ Attributes TreeGroup="CoreLib\\GrammaticalOps\\Advanced\\DatasetInfo/Manip"
{
 // Returns true if the input dataset is a contextual dataset.  Returns false in all other cases.  A contextual dataset is a single child dataset excluding Bit and NULL.  Single child datasets are implemented with an ordered pair where the top (most significant) element is a NULL.
 //
 // Inputs:
 //
 // Variant input: The input that is tested to be contextual dataset.
 //
 // Outputs:
 //
 // Bit output: 1 if input dataset is Contextual, 0 otherwise.
 //
 // Date:
 // January 26, 2003
 //
 // Revision 1
 //_ Object Prototypes
 Object ( Variant In1) Input;  //_GUI 57,23
 Object Output( Bit Out1) ;  //_GUI 95,23
 Object ( Variant Out1, Variant Out2) VariantIn( Variant In) ;  //_GUI 63,21
 Object ( Bit Out1) $IsContextual( Variant In1, Variant In2) ;  //_GUI 78,21
 //_ Attributes Documentation="Variant"
 Object Text;  //_GUI 3,18,In order to ascertain whether a data set is contextual or not, we must look at its two children.  If the most significant child is NULL then the data set is contextual.
 Object Text;  //_GUI 48,43,Contextual data sets are single-child data sets.  Single-child data sets are actually implemented as data sets with 2 children, where the most significant is NULL.  This is done so that Variant Exposers can work on Contextual data sets.  Any object to which NULL is propogated is immediately removed, unless that object has a NULL footprint overload.Arial,9,255,1
 Object Text;  //_GUI 104,17,Examples of Contextual Data Sets:SignedFixedFloatingComplexArial,9,32768,1

 //_ Behavior Topology
 Output.0 = $IsContextual.0;  
 VariantIn.0 = Input.0;  
 $IsContextual.0 = VariantIn.1;  
 $IsContextual.1 = VariantIn.0;  
}

